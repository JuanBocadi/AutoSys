+
+            // ÔöÇÔöÇ Fetch de veh├¡culos ÔöÇÔöÇ
+            function buscarVehiculos(termino) {
+                const url = '@Url.Action("BuscarVehiculos", "Ingreso")' + 
+                    (termino ? '?termino=' + encodeURIComponent(termino) : '');
+
+                fetch(url)
