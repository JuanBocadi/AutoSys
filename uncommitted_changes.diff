+                inputHidden.value = '';
+                spanTexto.textContent = '';
+                divSeleccionado.style.display = 'none';
+                inputBuscar.style.display = '';
+                inputBuscar.value = '';
+                inputBuscar.focus();
+            }
+
+            // ÔöÇÔöÇ Cerrar dropdown ÔöÇÔöÇ
+            function cerrarResultados() {
+                divResultados.style.display = 'none';
+                indiceActivo = -1;
+            }
+
+            // ÔöÇÔöÇ Navegaci├│n con teclado ÔöÇÔöÇ
+            function actualizarItemActivo() {
+                const items = divResultados.querySelectorAll('.vehiculo-search-item');
+                items.forEach(function (el, i) {
+                    el.classList.toggle('active', i === indiceActivo);
+                });
+                // Scroll al item activo
+                if (indiceActivo >= 0 && items[indiceActivo]) {
+                    items[indiceActivo].scrollIntoView({ block: 'nearest' });
+                }
+            }
+
+            // ÔöÇÔöÇ Utilidades ÔöÇÔöÇ
+            function escapeHtml(str) {
+                if (!str) return '';
+                const div = document.createElement('div');
+                div.textContent = str;
+                return div.innerHTML;
+            }
+
+            function resaltarCoincidencia(texto, termino) {
+                if (!termino || !texto) return escapeHtml(texto);
+                const escaped = escapeHtml(texto);
+                const regex = new RegExp('(' + termino.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
+                return escaped.replace(regex, '<mark>$1</mark>');
+            }
+
+            // ÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉÔòÉ
