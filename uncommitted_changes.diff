+                        divResultados.style.display = 'block';
+                    });
+            }
+
+            // ÔöÇÔöÇ Renderizar resultados ÔöÇÔöÇ
+            function renderResultados(datos, termino) {
+                if (datos.length === 0) {
+                    divResultados.innerHTML = '<div class="vehiculo-search-empty"><i class="fas fa-search me-1"></i>No se encontraron veh├¡culos</div>';
+                    divResultados.style.display = 'block';
+                    return;
+                }
