+                            parseInt(this.dataset.id),
+                            this.dataset.descripcion
+                        );
+                    });
+                    item.addEventListener('mouseenter', function () {
+                        indiceActivo = parseInt(this.dataset.index);
+                        actualizarItemActivo();
+                    });
+                });
+            }
+
+            // ÔöÇÔöÇ Seleccionar veh├¡culo ÔöÇÔöÇ
+            function seleccionarVehiculo(id, descripcion) {
+                inputHidden.value = id;
+                spanTexto.textContent = descripcion;
+                divSeleccionado.style.display = 'flex';
+                inputBuscar.style.display = 'none';
+                inputBuscar.value = '';
