@model IEnumerable<AutoSys.Models.Ingreso>
@{
    ViewData["Title"] = "Gestión de Reparaciones";
}

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-title">
        <i class="fas fa-tools" style="color: var(--accent-orange);"></i>
        Gestión de Reparaciones
    </h1>
    <p class="page-subtitle">Control y seguimiento de todas las reparaciones del taller</p>
</div>

<!-- Estadísticas principales -->
<div class="grid grid-2" style="margin-bottom: var(--spacing-xl);">
    <div class="stat-card" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);">
        <div class="stat-info">
            <div class="stat-label">Total Reparaciones</div>
            <div class="stat-value">@ViewBag.TotalReparaciones</div>
        </div>
        <div class="stat-icon" style="background: rgba(255, 255, 255, 0.2);">
            <i class="fas fa-tools"></i>
        </div>
    </div>
    
    <div class="stat-card" style="background: linear-gradient(135deg, #f59e0b 0%, #ea580c 100%);">
        <div class="stat-info">
            <div class="stat-label">En Taller</div>
            <div class="stat-value">@ViewBag.ReparacionesActivas</div>
        </div>
        <div class="stat-icon" style="background: rgba(255, 255, 255, 0.2);">
            <i class="fas fa-wrench"></i>
        </div>
    </div>
</div>

<!-- Leyenda de semaforización -->
<div class="card" style="margin-bottom: var(--spacing-xl);">
    <div class="card-content">
        <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: var(--spacing-md); display: flex; align-items: center; gap: var(--spacing-sm);">
            <i class="fas fa-traffic-light" style="color: var(--text-secondary);"></i>
            Leyenda de Semaforización por Estado
        </h3>
        <div style="display: flex; gap: var(--spacing-md); flex-wrap: wrap;">
            <span style="color: #b91c1c; font-weight: 700; padding: var(--spacing-sm) 0; display: inline-flex; align-items: center; gap: var(--spacing-xs);">
                <i class="fas fa-circle" style="font-size: 0.625rem;"></i>
                Rojo: En Revisión (Recién ingresado, aún no comenzó)
            </span>
            <span style="color: #b45309; font-weight: 700; padding: var(--spacing-sm) 0; display: inline-flex; align-items: center; gap: var(--spacing-xs);">
                <i class="fas fa-circle" style="font-size: 0.625rem;"></i>
                Amarillo: En Proceso (Reparación en marcha)
            </span>
            <span style="color: #15803d; font-weight: 700; padding: var(--spacing-sm) 0; display: inline-flex; align-items: center; gap: var(--spacing-xs);">
                <i class="fas fa-circle" style="font-size: 0.625rem;"></i>
                Verde: Finalizado/Entregado (Trabajo completado)
            </span>
        </div>
    </div>
</div>

<!-- Tabla de reparaciones -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-list" style="color: var(--text-secondary); margin-right: var(--spacing-sm);"></i>
            Listado de Reparaciones
        </h3>
    </div>
    <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Vehículo</th>
                            <th>Cliente</th>
                            <th>Fecha Ingreso</th>
                            <th>Diagnóstico</th>
                            <th>Estado</th>
                            <th style="text-align: center;">Días</th>
                            <th style="text-align: center;">Indicador</th>
                            <th style="text-align: center;">Acciones</th>
                        </tr>
                    </thead>
                        <tbody>
                            @foreach (var rep in Model)
                            {
                                <tr style="@(rep.ColorSemaforo == "danger" && !rep.FechaEgreso.HasValue ? "background-color: #fee2e2;" : "")">
                                    <td><strong>#@rep.Id</strong></td>
                                    <td>
                                        <div style="font-weight: 600;">@rep.Vehiculo?.Patente</div>
                                        <div style="font-size: 0.875rem; color: var(--text-secondary);">@rep.Vehiculo?.Marca @rep.Vehiculo?.Modelo</div>
                                    </td>
                                    <td>
                                        @rep.Vehiculo?.Cliente?.Nombre @rep.Vehiculo?.Cliente?.Apellido
                                    </td>
                                    <td>@rep.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (rep.Diagnostico.Length > 40)
                                        {
                                            <span title="@rep.Diagnostico">
                                                @rep.Diagnostico.Substring(0, 40)...
                                            </span>
                                        }
                                        else
                                        {
                                            @rep.Diagnostico
                                        }
                                    </td>
                                    <td>
                                        <span class="badge-@rep.ColorSemaforo">
                                            @rep.EstadoDescripcion
                                        </span>
                                    </td>
                                    <td style="text-align: center;">
                                        <strong>@rep.DiasEnTaller</strong>
                                    </td>
                                    <td style="text-align: center;">
                                        @if (!rep.FechaEgreso.HasValue)
                                        {
                                            <span class="semaforo-indicator semaforo-@rep.ColorSemaforo" 
                                                  title="@(rep.ColorSemaforo == "success" ? "En tiempo" : rep.ColorSemaforo == "warning" ? "Atención requerida" : "Urgente")"
                                                  style="font-size: 1.5rem;">
                                                <i class="fas fa-circle"></i>
                                            </span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-check-circle" style="color: var(--accent-green); font-size: 1.5rem;" title="Completado"></i>
                                        }
                                    </td>
                                    <td style="text-align: center;">
                                        <a asp-controller="Ingreso" asp-action="Detalle" asp-route-id="@rep.Id" 
                                           class="btn btn-info btn-sm"
                                           title="Ver detalle">
                                            <i class="fas fa-eye" style="margin-right: var(--spacing-xs);"></i>Detalle
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
            }
            else
            {
                <div style="background-color: #fef3c7; border: 1px solid #f59e0b; color: #92400e; padding: var(--spacing-lg); border-radius: var(--border-radius-md); text-align: center;">
                    <i class="fas fa-exclamation-triangle" style="margin-right: var(--spacing-sm);"></i>
                    No hay reparaciones registradas en el sistema.
                </div>
            }
        </div>
    </div>