@model IEnumerable<AutoSys.Models.Ingreso>
@{
    ViewData["Title"] = "Gestión de Reparaciones";
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div>
        <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
            <i class="fas fa-tools" style="margin-right: 0.5rem; color: #f59e0b;"></i>
            Gestión de Reparaciones
        </h1>
        <p style="color: var(--muted-foreground); margin: 0;">Control y seguimiento de todas las reparaciones del taller</p>
    </div>
</div>

<!-- Stats Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #dbeafe; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-tools" style="color: #3b82f6;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Total Reparaciones</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@ViewBag.TotalReparaciones</h4>
                </div>
            </div>
        </div>
    </div>
    
    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #fef3c7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-wrench" style="color: #f59e0b;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">En Taller</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@ViewBag.ReparacionesActivas</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Leyenda de semaforización -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-body">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
            <i class="fas fa-traffic-light" style="color: var(--muted-foreground);"></i>
            <h3 style="font-size: 1rem; font-weight: 600; margin: 0;">Leyenda de Semaforización por Estado</h3>
        </div>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <span style="color: #b91c1c; font-weight: 700; padding: 0.5rem 0; display: inline-flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-circle" style="font-size: 0.625rem;"></i>
                Rojo: En Revisión (Recién ingresado, aún no comenzó)
            </span>
            <span style="color: #b45309; font-weight: 700; padding: 0.5rem 0; display: inline-flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-circle" style="font-size: 0.625rem;"></i>
                Amarillo: En Proceso (Reparación en marcha)
            </span>
            <span style="color: #15803d; font-weight: 700; padding: 0.5rem 0; display: inline-flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-circle" style="font-size: 0.625rem;"></i>
                Verde: Finalizado/Entregado (Trabajo completado)
            </span>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-body" style="padding: 0;">
        @if (Model != null && Model.Any())
        {
            <div style="overflow-x: auto;">
                <table class="table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Vehículo</th>
                            <th>Cliente</th>
                            <th>Fecha Ingreso</th>
                            <th>Diagnóstico</th>
                            <th>Estado</th>
                            <th style="text-align: center;">Días en Taller</th>
                            <th style="text-align: center;">Indicador</th>
                            <th style="text-align: right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rep in Model)
                        {
                            var diasEnTaller = rep.DiasEnTaller;
                            var colorSemaforo = rep.ColorSemaforo;
                            var iconColor = colorSemaforo == "success" ? "#10b981" : colorSemaforo == "warning" ? "#f59e0b" : "#ef4444";
                            <tr>
                                <td>
                                    <span style="font-weight: 600; font-family: monospace;">#@rep.Id.ToString("D4")</span>
                                </td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <div style="width: 2.5rem; height: 2.5rem; background: #f59e0b; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-car" style="color: white;"></i>
                                        </div>
                                        <div>
                                            <div style="font-weight: 600;">@rep.Vehiculo?.Patente</div>
                                            <div style="font-size: 0.875rem; color: var(--muted-foreground);">
                                                @rep.Vehiculo?.Marca @rep.Vehiculo?.Modelo
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>@rep.Vehiculo?.Cliente?.Nombre @rep.Vehiculo?.Cliente?.Apellido</div>
                                    <div style="font-size: 0.875rem; color: var(--muted-foreground);">
                                        <i class="fas fa-phone"></i> @rep.Vehiculo?.Cliente?.Telefono
                                    </div>
                                </td>
                                <td>
                                    <div style="font-size: 0.875rem;">@rep.FechaIngreso.ToString("dd/MM/yyyy")</div>
                                    <div style="font-size: 0.75rem; color: var(--muted-foreground);">@rep.FechaIngreso.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.875rem;">
                                        @rep.Diagnostico
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var estado = rep.Estado ?? "";
                                        var badgeColor = estado switch
                                        {
                                            "En revisión" => "#b91c1c",
                                            "En proceso" => "#b45309",
                                            "En reparación" => "#b45309",
                                            "Finalizado" => "#15803d",
                                            "Entregado" => "#1e40af",
                                            _ => "#4b5563"
                                        };
                                    }
                                    <span style="color: @badgeColor; font-weight: 700; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.875rem;">
                                        @if (estado == "En revisión") { <i class="fas fa-search"></i> }
                                        else if (estado == "En proceso") { <i class="fas fa-cogs"></i> }
                                        else if (estado == "En reparación") { <i class="fas fa-tools"></i> }
                                        else if (estado == "Finalizado") { <i class="fas fa-check"></i> }
                                        else if (estado == "Entregado") { <i class="fas fa-check-double"></i> }
                                        @estado
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    @{
                                        var colorDias = diasEnTaller <= 2 ? "var(--success)" : diasEnTaller <= 5 ? "var(--warning)" : "var(--destructive)";
                                    }
                                    <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                                        <i class="fas fa-clock" style="color: @colorDias; font-size: 0.875rem;"></i>
                                        <span style="font-weight: 600; color: @colorDias;">@diasEnTaller días</span>
                                    </div>
                                </td>
                                <td style="text-align: center;">
                                    @if (!rep.FechaEgreso.HasValue)
                                    {
                                        <i class="fas fa-circle" style="color: @iconColor; font-size: 1.25rem; animation: pulse 2s infinite;" 
                                           title="@(colorSemaforo == "success" ? "En tiempo" : colorSemaforo == "warning" ? "Atención requerida" : "Urgente")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-check-circle" style="color: #10b981; font-size: 1.25rem;" title="Completado"></i>
                                    }
                                </td>
                                <td style="text-align: right;">
                                    <a asp-controller="Ingreso" asp-action="Detalle" asp-route-id="@rep.Id" 
                                       class="btn btn-sm btn-secondary"
                                       title="Ver detalle">
                                        <i class="fas fa-eye"></i> Ver Detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding: 3rem; text-align: center; color: var(--muted-foreground);">
                <i class="fas fa-tools" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.3;"></i>
                <p style="margin: 0;">No hay reparaciones registradas en el sistema</p>
            </div>
        }
    </div>
</div>