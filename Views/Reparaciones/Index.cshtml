@model IEnumerable<AutoSys.Models.Ingreso>
@{
    ViewData["Title"] = "Gestión de Reparaciones";
}

<div class="mt-4">
    <div class="card shadow-lg border-0 rounded-lg mb-4">
        <div class="card-header bg-dark text-white py-3">
            <h2 class="mb-0"><i class="fas fa-tools me-2"></i>Módulo de Reparaciones</h2>
        </div>
    </div>

    <!-- Estadísticas principales -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card border-primary shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-primary">@ViewBag.TotalReparaciones</h3>
                    <p class="mb-0"><i class="fas fa-tools me-1"></i>Total Reparaciones</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-warning shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-warning">@ViewBag.ReparacionesActivas</h3>
                    <p class="mb-0"><i class="fas fa-wrench me-1"></i>En Taller</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Leyenda de semaforización -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5><i class="fas fa-traffic-light me-2"></i>Leyenda de Semaforización por Estado</h5>
            <div class="d-flex gap-3 flex-wrap">
                <span class="badge bg-danger px-3 py-2">
                    <i class="fas fa-circle me-1"></i>Rojo: En Revisión (Recién ingresado, aún no comenzó)
                </span>
                <span class="badge bg-warning text-dark px-3 py-2">
                    <i class="fas fa-circle me-1"></i>Amarillo: En Proceso (Reparación en marcha)
                </span>
                <span class="badge bg-success px-3 py-2">
                    <i class="fas fa-circle me-1"></i>Verde: Finalizado/Entregado (Trabajo completado)
                </span>
            </div>
        </div>
    </div>

    <!-- Tabla de reparaciones -->
    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-header bg-secondary text-white py-3">
            <h3 class="mb-0"><i class="fas fa-list me-2"></i>Listado de Reparaciones</h3>
        </div>
        <div class="card-body p-4">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Vehículo</th>
                                <th>Cliente</th>
                                <th>Fecha Ingreso</th>
                                <th>Diagnóstico</th>
                                <th>Estado</th>
                                <th class="text-center">Días</th>
                                <th class="text-center">Indicador</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rep in Model)
                            {
                                <tr class="@(rep.ColorSemaforo == "danger" && !rep.FechaEgreso.HasValue ? "table-danger" : "")">
                                    <td><strong>#@rep.Id</strong></td>
                                    <td>
                                        <strong>@rep.Vehiculo?.Patente</strong><br />
                                        <small class="text-muted">@rep.Vehiculo?.Marca @rep.Vehiculo?.Modelo</small>
                                    </td>
                                    <td>
                                        @rep.Vehiculo?.Cliente?.Nombre @rep.Vehiculo?.Cliente?.Apellido
                                    </td>
                                    <td>@rep.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (rep.Diagnostico.Length > 40)
                                        {
                                            <span title="@rep.Diagnostico">
                                                @rep.Diagnostico.Substring(0, 40)...
                                            </span>
                                        }
                                        else
                                        {
                                            @rep.Diagnostico
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-@rep.ColorSemaforo">
                                            @rep.EstadoDescripcion
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <strong>@rep.DiasEnTaller</strong>
                                    </td>
                                    <td class="text-center">
                                        @if (!rep.FechaEgreso.HasValue)
                                        {
                                            <span class="semaforo-indicator semaforo-@rep.ColorSemaforo" 
                                                  title="@(rep.ColorSemaforo == "success" ? "En tiempo" : rep.ColorSemaforo == "warning" ? "Atención requerida" : "Urgente")">
                                                <i class="fas fa-circle fa-2x"></i>
                                            </span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-check-circle text-success fa-2x" title="Completado"></i>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Ingreso" asp-action="Detalle" asp-route-id="@rep.Id" 
                                           class="btn btn-sm btn-info"
                                           title="Ver detalle">
                                            <i class="fas fa-eye me-1"></i>Detalle
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    No hay reparaciones registradas en el sistema.
                </div>
            }
        </div>
    </div>
</div>