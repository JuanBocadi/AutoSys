<!-- 5. INSTRUCTIVO DE RESGUARDO -->
<!-- ════════════════════════════════════════════════════════════════════ -->
<div id="instructivo-backup" class="card" style="margin-bottom: 1.5rem;">
    <div class="card-body">
        <h4 style="font-weight: 700; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 2rem; height: 2rem; background: #dbeafe; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-download" style="color: #3b82f6; font-size: 0.9rem;"></i>
            </div>
            5. Instructivo de Resguardo (Backup)
        </h4>

        <h6 style="font-weight: 700; margin-bottom: 0.75rem;">Procedimiento paso a paso:</h6>

        <div style="position: relative; padding-left: 2rem;">
            <!-- Línea vertical -->
            <div style="position: absolute; left: 0.9rem; top: 0; bottom: 0; width: 2px; background: #e5e7eb;"></div>

            <!-- Paso 1 -->
            <div style="position: relative; margin-bottom: 1.5rem;">
                <div style="position: absolute; left: -1.55rem; width: 1.5rem; height: 1.5rem; background: #3b82f6; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 0.7rem; font-weight: 700;">1</div>
                <div style="background: var(--accent); border-radius: var(--radius); padding: 1rem; margin-left: 0.5rem;">
                    <strong style="font-size: 0.9rem;">Acceder al módulo de Resguardo</strong>
                    <p style="font-size: 0.8rem; color: var(--muted-foreground); margin: 0.25rem 0 0 0;">
                        Iniciar sesión como <strong>Administrador</strong> y navegar a
                        <strong>Resguardo</strong> en el menú lateral del sistema.
                    </p>
                </div>
            </div>

            <!-- Paso 2 -->
            <div style="position: relative; margin-bottom: 1.5rem;">
                <div style="position: absolute; left: -1.55rem; width: 1.5rem; height: 1.5rem; background: #3b82f6; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 0.7rem; font-weight: 700;">2</div>
                <div style="background: var(--accent); border-radius: var(--radius); padding: 1rem; margin-left: 0.5rem;">
                    <strong style="font-size: 0.9rem;">Crear un nuevo backup</strong>
                    <p style="font-size: 0.8rem; color: var(--muted-foreground); margin: 0.25rem 0 0 0;">
                        Hacer clic en el botón <strong>"Crear Backup"</strong>. Se abrirá un formulario donde puede:
                    </p>
                    <ul style="font-size: 0.8rem; color: var(--muted-foreground); margin: 0.25rem 0 0 0; padding-left: 1.2rem;">
                        <li>Escribir una nota descriptiva (ej: "Backup antes de actualización")</li>
                        <li>Seleccionar si desea incluir archivos subidos (fotos de vehículos)</li>
                    </ul>
                </div>
            </div>

            <!-- Paso 3 -->
            <div style="position: relative; margin-bottom: 1.5rem;">
                <div style="position: absolute; left: -1.55rem; width: 1.5rem; height: 1.5rem; background: #3b82f6; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 0.7rem; font-weight: 700;">3</div>
                <div style="background: var(--accent); border-radius: var(--radius); padding: 1rem; margin-left: 0.5rem;">
                    <strong style="font-size: 0.9rem;">Esperar la confirmación</strong>
                    <p style="font-size: 0.8rem; color: var(--muted-foreground); margin: 0.25rem 0 0 0;">
                        El sistema ejecutará el comando <code>BACKUP DATABASE</code> de SQL Server.
                        Al finalizar, mostrará un mensaje de éxito con el nombre del archivo y su tamaño.
                    </p>
                </div>
            </div>

            <!-- Paso 4 -->
            <div style="position: relative; margin-bottom: 1.5rem;">
                <div style="position: absolute; left: -1.55rem; width: 1.5rem; height: 1.5rem; background: #3b82f6; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 0.7rem; font-weight: 700;">4</div>
                <div style="background: var(--accent); border-radius: var(--radius); padding: 1rem; margin-left: 0.5rem;">
                    <strong style="font-size: 0.9rem;">Verificar el backup</strong>
                    <p style="font-size: 0.8rem; color: var(--muted-foreground); margin: 0.25rem 0 0 0;">
                        En la tabla de backups, hacer clic en el botón de verificación
                        (<i class="fas fa-check-double" style="color: #3b82f6;"></i>).
                        El sistema ejecutará <code>RESTORE VERIFYONLY</code> para comprobar la integridad.
                    </p>
                </div>
            </div>

            <!-- Paso 5 -->
            <div style="position: relative; margin-bottom: 0.5rem;">
                <div style="position: absolute; left: -1.55rem; width: 1.5rem; height: 1.5rem; background: #10b981; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 0.7rem; font-weight: 700;">5</div>
                <div style="background: var(--accent); border-radius: var(--radius); padding: 1rem; margin-left: 0.5rem;">
                    <strong style="font-size: 0.9rem;">Descargar y almacenar copia externa</strong>
                    <p style="font-size: 0.8rem; color: var(--muted-foreground); margin: 0.25rem 0 0 0;">
                        Usar el botón de descarga (<i class="fas fa-download" style="color: #10b981;"></i>)
                        para obtener el archivo <code>.bak</code> y copiarlo a un disco externo o servicio de almacenamiento
                        en la nube, cumpliendo con la regla 3-2-1.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

