@{
    ViewData["Title"] = "Instructivo de Resguardo y Restauración";
    ViewData["Breadcrumb"] = "Instructivo";
    ViewData["BreadcrumbParent"] = "Resguardo";
    ViewData["BreadcrumbParentUrl"] = Url.Action("Index", "Backup");
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-book" style="margin-right: 0.5rem; color: #10b981;"></i>
                Instructivo de Resguardo y Restauración
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">Políticas, procedimientos y mejores prácticas para la protección de datos</p>
        </div>
        <a asp-action="Index" class="btn" style="background: #f3f4f6; color: var(--foreground); border: 1px solid var(--border); font-weight: 600;">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>
</div>

<!-- Índice -->
<div class="card" style="margin-bottom: 2rem; border-left: 4px solid #3b82f6;">
    <div class="card-body">
        <h5 style="font-weight: 700; margin-bottom: 1rem;">
            <i class="fas fa-list-ol" style="color: #3b82f6; margin-right: 0.5rem;"></i>
            Índice del Documento
        </h5>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0.5rem;">
            <a href="#politicas" style="text-decoration: none; color: var(--foreground); padding: 0.5rem; border-radius: var(--radius); transition: background 0.2s;"
               onmouseover="this.style.background='var(--accent)'" onmouseout="this.style.background='transparent'">
                <i class="fas fa-gavel" style="color: #6366f1; width: 20px;"></i> 1. Políticas de Resguardo
            </a>
            <a href="#tipos" style="text-decoration: none; color: var(--foreground); padding: 0.5rem; border-radius: var(--radius); transition: background 0.2s;"
               onmouseover="this.style.background='var(--accent)'" onmouseout="this.style.background='transparent'">
                <i class="fas fa-layer-group" style="color: #8b5cf6; width: 20px;"></i> 2. Tipos de Backup (Ventajas y Desventajas)
            </a>
            <a href="#medio" style="text-decoration: none; color: var(--foreground); padding: 0.5rem; border-radius: var(--radius); transition: background 0.2s;"
               onmouseover="this.style.background='var(--accent)'" onmouseout="this.style.background='transparent'">
                <i class="fas fa-hdd" style="color: #f59e0b; width: 20px;"></i> 3. Medio de Almacenamiento
            </a>
            <a href="#frecuencia" style="text-decoration: none; color: var(--foreground); padding: 0.5rem; border-radius: var(--radius); transition: background 0.2s;"
               onmouseover="this.style.background='var(--accent)'" onmouseout="this.style.background='transparent'">
                <i class="fas fa-calendar-alt" style="color: #10b981; width: 20px;"></i> 4. Frecuencia y Responsable
            </a>
            <a href="#instructivo-backup" style="text-decoration: none; color: var(--foreground); padding: 0.5rem; border-radius: var(--radius); transition: background 0.2s;"
               onmouseover="this.style.background='var(--accent)'" onmouseout="this.style.background='transparent'">
                <i class="fas fa-download" style="color: #3b82f6; width: 20px;"></i> 5. Instructivo de Resguardo
            </a>
            <a href="#instructivo-restore" style="text-decoration: none; color: var(--foreground); padding: 0.5rem; border-radius: var(--radius); transition: background 0.2s;"
               onmouseover="this.style.background='var(--accent)'" onmouseout="this.style.background='transparent'">
                <i class="fas fa-upload" style="color: #ef4444; width: 20px;"></i> 6. Instructivo de Restauración
            </a>
            <a href="#verificacion" style="text-decoration: none; color: var(--foreground); padding: 0.5rem; border-radius: var(--radius); transition: background 0.2s;"
               onmouseover="this.style.background='var(--accent)'" onmouseout="this.style.background='transparent'">
                <i class="fas fa-check-double" style="color: #10b981; width: 20px;"></i> 7. Verificación de Backups
            </a>
            <a href="#herramientas" style="text-decoration: none; color: var(--foreground); padding: 0.5rem; border-radius: var(--radius); transition: background 0.2s;"
               onmouseover="this.style.background='var(--accent)'" onmouseout="this.style.background='transparent'">
                <i class="fas fa-tools" style="color: #d97706; width: 20px;"></i> 8. Herramientas Utilizadas
            </a>
            <a href="#automaticos" style="text-decoration: none; color: var(--foreground); padding: 0.5rem; border-radius: var(--radius); transition: background 0.2s;"
               onmouseover="this.style.background='var(--accent)'" onmouseout="this.style.background='transparent'">
                <i class="fas fa-robot" style="color: #8b5cf6; width: 20px;"></i> 9. Backups Automáticos Programados
            </a>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════════════════ -->
<!-- 1. POLÍTICAS DE RESGUARDO -->
<!-- ════════════════════════════════════════════════════════════════════ -->
<div id="politicas" class="card" style="margin-bottom: 1.5rem;">
    <div class="card-body">
        <h4 style="font-weight: 700; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 2rem; height: 2rem; background: #e0e7ff; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-gavel" style="color: #6366f1; font-size: 0.9rem;"></i>
            </div>
            1. Políticas de Resguardo
        </h4>

        <div style="background: var(--accent); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1rem;">
            <p style="font-size: 0.9rem; line-height: 1.7; margin: 0;">
                Las políticas de resguardo definen las reglas y procedimientos para proteger la información del sistema
                <strong>AutoSys</strong> ante posibles pérdidas de datos causadas por fallas de hardware, errores humanos,
                ataques informáticos o desastres naturales. Su cumplimiento es <strong>obligatorio</strong> para todo el
                personal con acceso al sistema.
            </p>
        </div>

        <h6 style="font-weight: 700; margin-bottom: 0.75rem;">Principios Fundamentales:</h6>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
            <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: var(--radius); padding: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                    <i class="fas fa-shield-alt" style="color: #10b981;"></i>
                    <strong style="font-size: 0.875rem;">Integridad</strong>
                </div>
                <p style="font-size: 0.8rem; color: var(--muted-foreground); margin: 0;">
                    Cada backup debe ser verificado para garantizar que los datos son íntegros y restaurables.
                </p>
            </div>
            <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: var(--radius); padding: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                    <i class="fas fa-clock" style="color: #3b82f6;"></i>
                    <strong style="font-size: 0.875rem;">Regularidad</strong>
                </div>
                <p style="font-size: 0.8rem; color: var(--muted-foreground); margin: 0;">
                    Los backups deben realizarse con la frecuencia establecida sin excepción.
                </p>
            </div>
            <div style="background: #fef3c7; border: 1px solid #fde68a; border-radius: var(--radius); padding: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                    <i class="fas fa-lock" style="color: #d97706;"></i>
                    <strong style="font-size: 0.875rem;">Confidencialidad</strong>
                </div>
                <p style="font-size: 0.8rem; color: var(--muted-foreground); margin: 0;">
                    Los archivos de backup contienen datos sensibles y deben protegerse con los mismos controles que la BD.
                </p>
            </div>
            <div style="background: #fce7f3; border: 1px solid #fbcfe8; border-radius: var(--radius); padding: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                    <i class="fas fa-copy" style="color: #ec4899;"></i>
                    <strong style="font-size: 0.875rem;">Redundancia</strong>
                </div>
                <p style="font-size: 0.8rem; color: var(--muted-foreground); margin: 0;">
                    Mantener copias en al menos 2 ubicaciones diferentes para prevenir pérdida total.
                </p>
            </div>
        </div>

        <h6 style="font-weight: 700; margin-bottom: 0.75rem;">Datos que se Resguardan:</h6>
        <div class="table-responsive">
            <table class="table" style="font-size: 0.875rem;">
                <thead>
                    <tr>
                        <th>Componente</th>
                        <th>Descripción</th>
                        <th>Incluido</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Base de datos SQL Server</strong></td>
                        <td>Clientes, vehículos, ingresos, facturas, stock, usuarios, permisos y configuración de Identity</td>
                        <td><span style="color: #10b981;"><i class="fas fa-check-circle"></i> Siempre</span></td>
                    </tr>
                    <tr>
                        <td><strong>Archivos subidos</strong></td>
                        <td>Fotografías de vehículos almacenadas en <code>wwwroot/uploads/</code></td>
                        <td><span style="color: #3b82f6;"><i class="fas fa-check-circle"></i> Opcional</span></td>
                    </tr>
                    <tr>
                        <td><strong>Catálogo de backups</strong></td>
                        <td>Archivo JSON con historial y metadatos de backups realizados</td>
                        <td><span style="color: #f59e0b;"><i class="fas fa-info-circle"></i> Independiente</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════════════════ -->
<!-- 2. TIPOS DE BACKUP -->
<!-- ════════════════════════════════════════════════════════════════════ -->
<div id="tipos" class="card" style="margin-bottom: 1.5rem;">
    <div class="card-body">
        <h4 style="font-weight: 700; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 2rem; height: 2rem; background: #ede9fe; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-layer-group" style="color: #8b5cf6; font-size: 0.9rem;"></i>
            </div>
            2. Tipos de Backup — Ventajas y Desventajas
        </h4>

        <div class="table-responsive">
            <table class="table" style="font-size: 0.875rem;">
                <thead>
                    <tr>
                        <th style="width: 15%;">Tipo</th>
                        <th style="width: 25%;">Descripción</th>
                        <th style="width: 25%;">Ventajas</th>
                        <th style="width: 25%;">Desventajas</th>
                        <th style="width: 10%;">Usado en AutoSys</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <span style="background: #dbeafe; color: #1d4ed8; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600; font-size: 0.8rem;">
                                Completo (Full)
                            </span>
                        </td>
                        <td>Copia íntegra de toda la base de datos. Incluye todos los datos, esquemas, procedimientos y configuración.</td>
                        <td>
                            <ul style="margin: 0; padding-left: 1.2rem;">
                                <li>Restauración más simple y rápida</li>
                                <li>Independiente de otros backups</li>
                                <li>Mayor confiabilidad</li>
                                <li>Punto de restauración completo</li>
                            </ul>
                        </td>
                        <td>
                            <ul style="margin: 0; padding-left: 1.2rem;">
                                <li>Mayor espacio en disco</li>
                                <li>Mayor tiempo de ejecución</li>
                                <li>Mayor carga en el servidor</li>
                            </ul>
                        </td>
                        <td style="text-align: center;">
                            <span style="color: #10b981; font-size: 1.25rem;"><i class="fas fa-check-circle"></i></span>
                            <div style="font-size: 0.75rem; color: var(--muted-foreground);">Implementado</div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span style="background: #fef3c7; color: #92400e; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600; font-size: 0.8rem;">
                                Diferencial
                            </span>
                        </td>
                        <td>Copia solo los datos modificados desde el último backup completo. Requiere el backup completo base para restaurar.</td>
                        <td>
                            <ul style="margin: 0; padding-left: 1.2rem;">
                                <li>Menor espacio que el completo</li>
                                <li>Ejecución más rápida</li>
                                <li>Solo requiere Full + último diferencial</li>
                            </ul>
                        </td>
                        <td>
                            <ul style="margin: 0; padding-left: 1.2rem;">
                                <li>Depende del backup completo</li>
                                <li>Crece con el tiempo</li>
                                <li>Restauración más compleja</li>
                            </ul>
                        </td>
                        <td style="text-align: center;">
                            <span style="color: var(--muted-foreground); font-size: 1.25rem;"><i class="fas fa-minus-circle"></i></span>
                            <div style="font-size: 0.75rem; color: var(--muted-foreground);">No aplica</div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span style="background: #ede9fe; color: #5b21b6; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600; font-size: 0.8rem;">
                                Incremental
                            </span>
                        </td>
                        <td>Copia solo los datos modificados desde el último backup de cualquier tipo. Requiere toda la cadena de backups.</td>
                        <td>
                            <ul style="margin: 0; padding-left: 1.2rem;">
                                <li>Menor espacio en disco</li>
                                <li>Ejecución más rápida</li>
                                <li>Menor impacto en rendimiento</li>
                            </ul>
                        </td>
                        <td>
                            <ul style="margin: 0; padding-left: 1.2rem;">
                                <li>Restauración lenta (toda la cadena)</li>
                                <li>Si un eslabón falla, se pierde todo</li>
                                <li>Gestión compleja</li>
                            </ul>
                        </td>
                        <td style="text-align: center;">
                            <span style="color: var(--muted-foreground); font-size: 1.25rem;"><i class="fas fa-minus-circle"></i></span>
                            <div style="font-size: 0.75rem; color: var(--muted-foreground);">No aplica</div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span style="background: #dcfce7; color: #166534; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600; font-size: 0.8rem;">
                                De Archivos
                            </span>
                        </td>
                        <td>Copia de los archivos físicos del sistema (fotografías, documentos subidos por los usuarios).</td>
                        <td>
                            <ul style="margin: 0; padding-left: 1.2rem;">
                                <li>Protege contenido multimedia</li>
                                <li>Complementa el backup de BD</li>
                                <li>Fácil de restaurar</li>
                            </ul>
                        </td>
                        <td>
                            <ul style="margin: 0; padding-left: 1.2rem;">
                                <li>Puede ocupar mucho espacio</li>
                                <li>Crece de forma continua</li>
                            </ul>
                        </td>
                        <td style="text-align: center;">
                            <span style="color: #10b981; font-size: 1.25rem;"><i class="fas fa-check-circle"></i></span>
                            <div style="font-size: 0.75rem; color: var(--muted-foreground);">Opcional (ZIP)</div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: var(--radius); padding: 1rem; margin-top: 1rem;">
            <div style="display: flex; align-items: start; gap: 0.5rem;">
                <i class="fas fa-lightbulb" style="color: #10b981; margin-top: 2px;"></i>
                <p style="font-size: 0.875rem; margin: 0;">
                    <strong>Decisión de diseño:</strong> Para AutoSys se implementó el <strong>Backup Completo (Full)</strong>
                    por ser un sistema de gestión de taller automotriz con un volumen de datos moderado, donde la simplicidad
                    y confiabilidad de la restauración son prioritarias frente al ahorro de espacio.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════════════════ -->
<!-- 3. MEDIO DE ALMACENAMIENTO -->
<!-- ════════════════════════════════════════════════════════════════════ -->
<div id="medio" class="card" style="margin-bottom: 1.5rem;">
    <div class="card-body">
        <h4 style="font-weight: 700; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 2rem; height: 2rem; background: #fef3c7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-hdd" style="color: #f59e0b; font-size: 0.9rem;"></i>
            </div>
            3. Medio de Almacenamiento y Ubicación
        </h4>

        <div class="table-responsive">
            <table class="table" style="font-size: 0.875rem;">
                <thead>
                    <tr>
                        <th>Medio</th>
                        <th>Ubicación</th>
                        <th>Ventajas</th>
                        <th>Desventajas</th>
                        <th>Recomendación</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong><i class="fas fa-server" style="color: #3b82f6;"></i> Disco local del servidor</strong></td>
                        <td>Carpeta <code>Backups/</code> dentro del proyecto</td>
                        <td>Velocidad máxima, acceso inmediato, sin costo adicional</td>
                        <td>Vulnerable a fallas del disco, ransomware, desastres físicos</td>
                        <td><span style="background: #dbeafe; color: #1d4ed8; padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">Primario</span></td>
                    </tr>
                    <tr>
                        <td><strong><i class="fas fa-usb" style="color: #8b5cf6;"></i> Disco externo / USB</strong></td>
                        <td>Dispositivo extraíble conectado al servidor</td>
                        <td>Portátil, aislado del sistema, bajo costo</td>
                        <td>Puede ser extraviado, capacidad limitada, desgaste</td>
                        <td><span style="background: #dcfce7; color: #166534; padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">Secundario</span></td>
                    </tr>
                    <tr>
                        <td><strong><i class="fas fa-cloud" style="color: #06b6d4;"></i> Almacenamiento en la nube</strong></td>
                        <td>OneDrive, Google Drive, Azure Blob Storage</td>
                        <td>Protección ante desastres, acceso remoto, escalable</td>
                        <td>Requiere Internet, costo mensual, latencia</td>
                        <td><span style="background: #fef3c7; color: #92400e; padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">Terciario</span></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: var(--radius); padding: 1rem; margin-top: 1rem;">
            <div style="display: flex; align-items: start; gap: 0.5rem;">
                <i class="fas fa-info-circle" style="color: #3b82f6; margin-top: 2px;"></i>
                <p style="font-size: 0.875rem; margin: 0;">
                    <strong>Estrategia recomendada (Regla 3-2-1):</strong> Mantener al menos <strong>3 copias</strong>
                    de los datos, en <strong>2 tipos de medio</strong> diferentes, con <strong>1 copia fuera del sitio</strong>
                    (off-site). AutoSys genera el backup en disco local y ofrece la opción de descarga para que el
                    administrador copie el archivo a un medio externo o la nube.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════════════════ -->
<!-- 4. FRECUENCIA Y RESPONSABLE -->
<!-- ════════════════════════════════════════════════════════════════════ -->
<div id="frecuencia" class="card" style="margin-bottom: 1.5rem;">
    <div class="card-body">
        <h4 style="font-weight: 700; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 2rem; height: 2rem; background: #dcfce7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-calendar-alt" style="color: #10b981; font-size: 0.9rem;"></i>
            </div>
            4. Frecuencia de Resguardo y Responsable
        </h4>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
            <!-- Frecuencia -->
            <div>
                <h6 style="font-weight: 700; margin-bottom: 0.75rem;">Cronograma Recomendado:</h6>
                <div style="border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">
                    <div style="background: var(--accent); padding: 0.75rem 1rem; border-bottom: 1px solid var(--border);">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <i class="fas fa-calendar-day" style="color: #3b82f6;"></i>
                            <strong style="font-size: 0.875rem;">Diario</strong>
                        </div>
                        <p style="font-size: 0.8rem; color: var(--muted-foreground); margin: 0.25rem 0 0 1.5rem;">
                            Al finalizar cada jornada laboral. Backup completo con archivos.
                        </p>
                    </div>
                    <div style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--border);">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <i class="fas fa-calendar-week" style="color: #8b5cf6;"></i>
                            <strong style="font-size: 0.875rem;">Semanal</strong>
                        </div>
                        <p style="font-size: 0.8rem; color: var(--muted-foreground); margin: 0.25rem 0 0 1.5rem;">
                            Viernes al cierre. Copiar backup a medio externo (USB / nube).
                        </p>
                    </div>
                    <div style="padding: 0.75rem 1rem;">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <i class="fas fa-calendar" style="color: #10b981;"></i>
                            <strong style="font-size: 0.875rem;">Mensual</strong>
                        </div>
                        <p style="font-size: 0.8rem; color: var(--muted-foreground); margin: 0.25rem 0 0 1.5rem;">
                            Último día hábil del mes. Verificar integridad y archivar en ubicación off-site.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Responsable -->
            <div>
                <h6 style="font-weight: 700; margin-bottom: 0.75rem;">Responsables:</h6>
                <div style="border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">
                    <div style="background: var(--accent); padding: 0.75rem 1rem; border-bottom: 1px solid var(--border);">
