                    <tr>
                        <td>
                            <strong>SQL Server Management Studio (SSMS)</strong>
                            <div style="font-size: 0.75rem; color: var(--muted-foreground);">Herramienta de terceros (Microsoft)</div>
                        </td>
                        <td>Alternativa para restauración manual cuando la aplicación no está disponible</td>
                        <td><span style="background: #fef3c7; color: #92400e; padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.75rem;">Terceros</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

