@model IEnumerable<AutoSys.Models.Stock>
@{
    ViewData["Title"] = "Stock Bajo y Crítico";
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-exclamation-triangle" style="margin-right: 0.5rem; color: #ef4444;"></i>
                Stock Bajo y Crítico
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">Items que necesitan reorden o están en nivel crítico</p>
        </div>
        <a asp-action="Index" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>
</div>

<!-- Stats Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div class="card" style="border-left: 4px solid #ef4444;">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #fee2e2; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-exclamation-triangle" style="color: #ef4444;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Items Críticos</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@ViewBag.ItemsCriticos</h4>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Cantidad &lt; Mínimo</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card" style="border-left: 4px solid #f59e0b;">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #fef3c7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-exclamation-circle" style="color: #f59e0b;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Items Bajo</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@ViewBag.ItemsBajo</h4>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Entre Mínimo y Mínimo × 2</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Info Card -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-body">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <i class="fas fa-info-circle" style="color: #f59e0b; font-size: 1.25rem;"></i>
            <p style="margin: 0;"><strong>Nota:</strong> Este reporte muestra todos los items que necesitan reorden o están en nivel crítico.</p>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-body" style="padding: 0;">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Descripción</th>
                            <th style="text-align: center;">Cantidad</th>
                            <th style="text-align: center;">Mínimo</th>
                            <th style="text-align: center;">Nivel</th>
                            <th style="text-align: right;">Precio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var iconColor = item.ColorSemaforo == "danger" ? "#ef4444" : "#f59e0b";
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <div style="width: 2.5rem; height: 2.5rem; background: #f4f4f5; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-box" style="color: @iconColor;"></i>
                                        </div>
                                        <div>
                                            <div style="font-weight: 600;">@item.Nombre</div>
                                            <div style="font-size: 0.875rem; color: var(--muted-foreground);">@(string.IsNullOrEmpty(item.Unidad) ? "unid." : item.Unidad)</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Descripcion))
                                    {
                                        <div style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.875rem;">@item.Descripcion</div>
                                    }
                                    else
                                    {
                                        <span style="color: var(--muted-foreground);">-</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <span style="font-size: 1.125rem; font-weight: 700; color: @iconColor;">@item.Cantidad</span>
                                </td>
                                <td style="text-align: center;">
                                    <span style="color: #4b5563; font-weight: 600;">@item.StockMinimo</span>
                                </td>
                                <td style="text-align: center;">
                                    <div style="display: flex; flex-direction: column; align-items: center; gap: 0.25rem;">
                                        <i class="fas fa-circle" style="color: @iconColor; font-size: 1.25rem; animation: pulse 2s infinite;"></i>
                                        @{
                                            var nivelColor = item.ColorSemaforo == "danger" ? "#b91c1c" : "#b45309";
                                        }
                                        <span style="color: @nivelColor; font-weight: 700; font-size: 0.875rem;">@item.NivelStock</span>
                                    </div>
                                </td>
                                <td style="text-align: right;">
                                    <span style="font-weight: 600; font-family: monospace;">$@item.PrecioUnitario.ToString("N2")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding: 3rem; text-align: center; color: var(--muted-foreground);">
                <i class="fas fa-check-circle" style="font-size: 3rem; margin-bottom: 1rem; color: #10b981;"></i>
                <p style="margin: 0; font-weight: 600;">¡Excelente! No hay items con stock bajo o crítico</p>
            </div>
        }
    </div>
</div>

<!-- Recomendaciones Card -->
@if (Model != null && Model.Any(i => i.Cantidad < i.StockMinimo))
{
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-body">
            <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-shopping-cart" style="color: #3b82f6;"></i>
                Recomendaciones de Reorden
            </h3>
            <ul style="margin: 0; padding-left: 1.5rem;">
                @foreach (var item in Model.Where(i => i.Cantidad < i.StockMinimo))
                {
                    var cantidadReorden = (item.StockMinimo * 3) - item.Cantidad;
                    <li style="margin-bottom: 0.75rem;">
                        <strong>@item.Nombre:</strong> Ordenar al menos <strong>@cantidadReorden @item.Unidad</strong>
                        (Costo estimado: <strong style="color: #10b981;">$@((cantidadReorden * item.PrecioUnitario).ToString("N2"))</strong>)
                    </li>
                }
            </ul>
        </div>
    </div>
}
