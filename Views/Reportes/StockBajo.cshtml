@model IEnumerable<AutoSys.Models.Stock>
@{
    ViewData["Title"] = "Stock Bajo y Crítico";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-danger text-white">
            <h2><i class="fas fa-boxes me-2"></i>Reporte: Stock Bajo y Crítico</h2>
        </div>
        <div class="card-body">
            <!-- Estadísticas -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card border-danger">
                        <div class="card-body text-center">
                            <h3 class="text-danger">@ViewBag.ItemsCriticos</h3>
                            <p class="mb-0">
                                <i class="fas fa-exclamation-triangle me-1"></i>
                                Items Críticos (Cantidad &lt; Mínimo)
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-warning">
                        <div class="card-body text-center">
                            <h3 class="text-warning">@ViewBag.ItemsBajo</h3>
                            <p class="mb-0">
                                <i class="fas fa-exclamation-circle me-1"></i>
                                Items Bajo (Cantidad entre Mínimo y Mínimo × 2)
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-warning">
                <strong><i class="fas fa-info-circle me-2"></i>Nota:</strong>
                Este reporte muestra todos los items que necesitan reorden o están en nivel crítico.
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th class="text-center">Cantidad Actual</th>
                                <th class="text-center">Stock Mínimo</th>
                                <th>Unidad</th>
                                <th class="text-end">Precio Unit.</th>
                                <th class="text-center">Nivel</th>
                                <th class="text-center">Indicador</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="@(item.ColorSemaforo == "danger" ? "table-danger" : "table-warning")">
                                    <td><strong>@item.Nombre</strong></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Descripcion))
                                        {
                                            if (item.Descripcion.Length > 50)
                                            {
                                                <span title="@item.Descripcion">
                                                    @item.Descripcion.Substring(0, 50)...
                                                </span>
                                            }
                                            else
                                            {
                                                @item.Descripcion
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <strong class="text-@item.ColorSemaforo">@item.Cantidad</strong>
                                    </td>
                                    <td class="text-center">@item.StockMinimo</td>
                                    <td>@(string.IsNullOrEmpty(item.Unidad) ? "-" : item.Unidad)</td>
                                    <td class="text-end">$@item.PrecioUnitario.ToString("N2")</td>
                                    <td class="text-center">
                                        <span class="badge bg-@item.ColorSemaforo">
                                            @item.NivelStock
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="semaforo-indicator semaforo-@item.ColorSemaforo" 
                                              title="@item.NivelStock">
                                            <i class="fas fa-circle fa-2x"></i>
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Resumen de reorden -->
                <div class="card bg-light mt-4">
                    <div class="card-body">
                        <h5><i class="fas fa-shopping-cart me-2"></i>Recomendaciones de Reorden</h5>
                        <ul class="mb-0">
                            @foreach (var item in Model.Where(i => i.Cantidad < i.StockMinimo))
                            {
                                var cantidadReorden = (item.StockMinimo * 3) - item.Cantidad;
                                <li>
                                    <strong>@item.Nombre:</strong> Ordenar al menos <strong>@cantidadReorden @item.Unidad</strong>
                                    (Costo estimado: <strong>$@((cantidadReorden * item.PrecioUnitario).ToString("N2"))</strong>)
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-success text-center">
                    <i class="fas fa-check-circle me-2"></i>
                    ¡Excelente! No hay items con stock bajo o crítico en este momento.
                </div>
            }

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Volver al Dashboard
                </a>
                <a asp-controller="Stock" asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-boxes me-1"></i>Ir a Gestión de Stock
                </a>
            </div>
        </div>
    </div>
</div>
