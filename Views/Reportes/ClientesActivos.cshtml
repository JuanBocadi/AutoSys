@{
    ViewData["Title"] = "Clientes Más Activos";
    var clientes = ViewBag.ClientesConEstadisticas as IEnumerable<dynamic>;
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-user-friends" style="margin-right: 0.5rem; color: #3b82f6;"></i>
                Clientes Más Activos
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">Ranking de los 20 clientes con mayor cantidad de ingresos/reparaciones</p>
        </div>
        <a asp-action="Index" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>
</div>

<!-- Info Card -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-body">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <i class="fas fa-info-circle" style="color: #3b82f6; font-size: 1.25rem;"></i>
            <p style="margin: 0;">Ranking de los 20 clientes con mayor cantidad de ingresos/reparaciones registrados en el sistema.</p>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-body" style="padding: 0;">
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                Ranking de los 20 clientes con mayor cantidad de ingresos/reparaciones.
            </div>

        @if (clientes != null && clientes.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="text-align: center;">#</th>
                            <th>Cliente</th>
                            <th>DNI</th>
                            <th>Teléfono</th>
                            <th style="text-align: center;">Vehículos</th>
                            <th style="text-align: center;">Total Ingresos</th>
                            <th>Último Ingreso</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int posicion = 1;
                        }
                        @foreach (var item in clientes)
                        {
                            <tr>
                                <td style="text-align: center;">
                                    @if (posicion <= 3)
                                    {
                                        var medalColor = posicion == 1 ? "#f59e0b" : posicion == 2 ? "#94a3b8" : "#3b82f6";
                                        <span style="color: @medalColor; font-weight: 700; font-size: 1.25rem;">
                                            <i class="fas fa-medal"></i> @posicion
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="font-weight: 600;">@posicion</span>
                                    }
                                </td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <div style="width: 2.5rem; height: 2.5rem; background: #f4f4f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; color: #71717a;">
                                            @item.Cliente.Nombre?.Substring(0, 1).ToUpper()@item.Cliente.Apellido?.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div style="font-weight: 600;">@item.Cliente.Nombre @item.Cliente.Apellido</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary" style="font-family: monospace;">@(item.Cliente.DNI ?? "-")</span>
                                </td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                        <i class="fas fa-phone" style="color: var(--muted-foreground); font-size: 0.875rem;"></i>
                                        <span>@(item.Cliente.Telefono ?? "-")</span>
                                    </div>
                                </td>
                                <td style="text-align: center;">
                                    <span style="color: #1e40af; font-weight: 700; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.875rem;">
                                        <i class="fas fa-car"></i> @item.TotalVehiculos
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    <span style="color: #15803d; font-weight: 700; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.875rem;">
                                        <i class="fas fa-clipboard-list"></i> @item.TotalIngresos
                                    </span>
                                </td>
                                <td>
                                    @if (item.UltimoIngreso != null)
                                    {
                                        DateTime ultimoIngreso = item.UltimoIngreso;
                                        <div style="font-size: 0.875rem;">@ultimoIngreso.ToString("dd/MM/yyyy")</div>
                                    }
                                    else
                                    {
                                        <span style="color: var(--muted-foreground);">-</span>
                                    }
                                </td>
                            </tr>
                            posicion++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding: 3rem; text-align: center; color: var(--muted-foreground);">
                <i class="fas fa-user-friends" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.3;"></i>
                <p style="margin: 0;">No hay datos de clientes disponibles</p>
            </div>
        }
    </div>
</div>
