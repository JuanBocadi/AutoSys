@model IEnumerable<AutoSys.Models.Ingreso>
@{
    ViewData["Title"] = "Tiempos de Reparación";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-warning text-dark">
            <h2><i class="fas fa-clock me-2"></i>Reporte: Tiempos de Reparación</h2>
        </div>
        <div class="card-body">
            <!-- Estadísticas de tiempo -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card border-info">
                        <div class="card-body text-center">
                            <h3 class="text-info">@ViewBag.TiempoPromedio.ToString("F1")</h3>
                            <p class="mb-0">
                                <i class="fas fa-calculator me-1"></i>
                                Días Promedio
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-success">
                        <div class="card-body text-center">
                            <h3 class="text-success">@ViewBag.TiempoMinimo.ToString("F1")</h3>
                            <p class="mb-0">
                                <i class="fas fa-bolt me-1"></i>
                                Tiempo Mínimo
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-danger">
                        <div class="card-body text-center">
                            <h3 class="text-danger">@ViewBag.TiempoMaximo.ToString("F1")</h3>
                            <p class="mb-0">
                                <i class="fas fa-hourglass-end me-1"></i>
                                Tiempo Máximo
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                Este reporte analiza las últimas 100 reparaciones finalizadas para calcular los tiempos de permanencia en el taller.
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Fecha Ingreso</th>
                                <th>Fecha Egreso</th>
                                <th>Cliente</th>
                                <th>Vehículo</th>
                                <th>Diagnóstico</th>
                                <th class="text-center">Días en Taller</th>
                                <th class="text-center">Rendimiento</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ingreso in Model)
                            {
                                var dias = (ingreso.FechaEgreso!.Value - ingreso.FechaIngreso).TotalDays;
                                var promedio = (double)ViewBag.TiempoPromedio;
                                var rendimiento = dias <= promedio ? "success" : dias <= promedio * 1.5 ? "warning" : "danger";
                                
                                <tr>
                                    <td>@ingreso.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                    <td>@ingreso.FechaEgreso.Value.ToString("dd/MM/yyyy")</td>
                                    <td>@ingreso.Vehiculo?.Cliente?.Nombre @ingreso.Vehiculo?.Cliente?.Apellido</td>
                                    <td>@ingreso.Vehiculo?.Patente - @ingreso.Vehiculo?.Marca @ingreso.Vehiculo?.Modelo</td>
                                    <td>
                                        @if (ingreso.Diagnostico.Length > 40)
                                        {
                                            <span title="@ingreso.Diagnostico">
                                                @ingreso.Diagnostico.Substring(0, 40)...
                                            </span>
                                        }
                                        else
                                        {
                                            @ingreso.Diagnostico
                                        }
                                    </td>
                                    <td class="text-center">
                                        <strong>@dias.ToString("F1")</strong> días
                                    </td>
                                    <td class="text-center">
                                        @if (rendimiento == "success")
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-thumbs-up me-1"></i>Rápido
                                            </span>
                                        }
                                        else if (rendimiento == "warning")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="fas fa-clock me-1"></i>Normal
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fas fa-exclamation-triangle me-1"></i>Lento
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Análisis adicional -->
                <div class="card bg-light mt-4">
                    <div class="card-body">
                        <h5><i class="fas fa-chart-bar me-2"></i>Análisis de Rendimiento</h5>
                        <div class="row">
                            <div class="col-md-4">
                                <p class="mb-1">
                                    <span class="badge bg-success me-2">Rápido</span>
                                    @Model.Count(i => (i.FechaEgreso!.Value - i.FechaIngreso).TotalDays <= (double)ViewBag.TiempoPromedio) reparaciones
                                </p>
                            </div>
                            <div class="col-md-4">
                                <p class="mb-1">
                                    <span class="badge bg-warning text-dark me-2">Normal</span>
                                    @Model.Count(i => {
                                        var d = (i.FechaEgreso!.Value - i.FechaIngreso).TotalDays;
                                        var p = (double)ViewBag.TiempoPromedio;
                                        return d > p && d <= p * 1.5;
                                    }) reparaciones
                                </p>
                            </div>
                            <div class="col-md-4">
                                <p class="mb-1">
                                    <span class="badge bg-danger me-2">Lento</span>
                                    @Model.Count(i => (i.FechaEgreso!.Value - i.FechaIngreso).TotalDays > (double)ViewBag.TiempoPromedio * 1.5) reparaciones
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    No hay suficientes datos de reparaciones finalizadas para generar el reporte.
                </div>
            }

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Volver al Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
