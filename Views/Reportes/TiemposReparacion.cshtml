@model IEnumerable<AutoSys.Models.Ingreso>
@{
    ViewData["Title"] = "Tiempos de Reparación";
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-clock" style="margin-right: 0.5rem; color: #f59e0b;"></i>
                Tiempos de Reparación
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">Análisis de tiempos de permanencia en taller y distribución de rendimiento</p>
        </div>
        <a asp-action="Index" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>
</div>

<!-- KPIs principales -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div class="card" style="border-left: 4px solid #3b82f6;">
        <div class="card-body">
            <div style="display: flex; justify-content: space-between; align-items: start;">
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin-bottom: 0.5rem;">Total Reparaciones</p>
                    <h3 style="font-size: 1.75rem; font-weight: 700; margin: 0; color: #3b82f6;">@ViewBag.TotalReparaciones</h3>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">finalizadas</p>
                </div>
                <div style="width: 2.5rem; height: 2.5rem; background: #dbeafe; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-wrench" style="color: #3b82f6; font-size: 1.25rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card" style="border-left: 4px solid #6366f1;">
        <div class="card-body">
            <div style="display: flex; justify-content: space-between; align-items: start;">
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin-bottom: 0.5rem;">Tiempo Promedio</p>
                    <h3 style="font-size: 1.75rem; font-weight: 700; margin: 0; color: #6366f1;">@ViewBag.TiempoPromedio.ToString("F1")</h3>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">días</p>
                </div>
                <div style="width: 2.5rem; height: 2.5rem; background: #e0e7ff; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-calculator" style="color: #6366f1; font-size: 1.25rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card" style="border-left: 4px solid #10b981;">
        <div class="card-body">
            <div style="display: flex; justify-content: space-between; align-items: start;">
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin-bottom: 0.5rem;">Tiempo Mínimo</p>
                    <h3 style="font-size: 1.75rem; font-weight: 700; margin: 0; color: #10b981;">@ViewBag.TiempoMinimo.ToString("F1")</h3>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">días</p>
                </div>
                <div style="width: 2.5rem; height: 2.5rem; background: #dcfce7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-bolt" style="color: #10b981; font-size: 1.25rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card" style="border-left: 4px solid #ef4444;">
        <div class="card-body">
            <div style="display: flex; justify-content: space-between; align-items: start;">
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin-bottom: 0.5rem;">Tiempo Máximo</p>
                    <h3 style="font-size: 1.75rem; font-weight: 700; margin: 0; color: #ef4444;">@ViewBag.TiempoMaximo.ToString("F1")</h3>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">días</p>
                </div>
                <div style="width: 2.5rem; height: 2.5rem; background: #fee2e2; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-hourglass-end" style="color: #ef4444; font-size: 1.25rem;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Gráficos -->
<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
    <!-- Gráfico de Barras: Distribución de tiempos -->
    <div class="card">
        <div class="card-header">
            <h3 style="font-size: 1.125rem; font-weight: 700; margin: 0;">
                <i class="fas fa-chart-bar" style="margin-right: 0.5rem; color: #3b82f6;"></i>
                Distribución de Tiempos de Reparación
            </h3>
        </div>
        <div class="card-body">
            <canvas id="chartDistribucion" style="max-height: 400px;"></canvas>
        </div>
    </div>

    <!-- Gráfico de Torta: Rendimiento -->
    <div class="card">
        <div class="card-header">
            <h3 style="font-size: 1.125rem; font-weight: 700; margin: 0;">
                <i class="fas fa-chart-pie" style="margin-right: 0.5rem; color: #6366f1;"></i>
                Clasificación de Rendimiento
            </h3>
        </div>
        <div class="card-body" style="display: flex; align-items: center; justify-content: center;">
            <canvas id="chartRendimiento" style="max-height: 350px;"></canvas>
        </div>
    </div>
</div>

<!-- Info de toma de decisiones -->
<div class="card" style="margin-bottom: 1.5rem; border-left: 4px solid #3b82f6;">
    <div class="card-body">
        <h4 style="font-size: 1rem; font-weight: 700; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fas fa-lightbulb" style="color: #f59e0b;"></i>
            Información para la Toma de Decisiones
        </h4>
        <ul style="margin: 0; padding-left: 1.5rem; line-height: 1.8;">
            <li>La <strong>distribución de tiempos</strong> permite identificar si hay reparaciones atípicamente largas que requieren atención.</li>
            <li>Un alto porcentaje de reparaciones <strong>lentas</strong> puede indicar falta de personal, repuestos o herramientas.</li>
            <li>Compare el <strong>tiempo promedio</strong> con el mínimo para evaluar margen de mejora en eficiencia.</li>
            <li>Use estos datos para <strong>estimar plazos</strong> de entrega más precisos a los clientes.</li>
        </ul>
    </div>
</div>

<!-- Tabla detallada -->
<div class="card">
    <div class="card-header">
        <h3 style="font-size: 1.125rem; font-weight: 700; margin: 0;">
            <i class="fas fa-table" style="margin-right: 0.5rem;"></i>
            Detalle de Reparaciones Finalizadas (últimas 100)
        </h3>
    </div>
    <div class="card-body" style="padding: 0;">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Fecha Ingreso</th>
                            <th>Fecha Egreso</th>
                            <th>Cliente</th>
                            <th>Vehículo</th>
                            <th>Diagnóstico</th>
                            <th style="text-align: center;">Días en Taller</th>
                            <th style="text-align: center;">Rendimiento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ingreso in Model)
                        {
                            var dias = (ingreso.FechaEgreso!.Value - ingreso.FechaIngreso).TotalDays;
                            var promedio = (double)ViewBag.TiempoPromedio;
                            var rendimiento = dias <= promedio ? "success" : dias <= promedio * 1.5 ? "warning" : "danger";

                            <tr>
                                <td>@ingreso.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                <td>@ingreso.FechaEgreso.Value.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                        <div style="width: 2rem; height: 2rem; background: #f4f4f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; color: #71717a; font-size: 0.75rem;">
                                            @(ingreso.Vehiculo?.Cliente?.Nombre?.Substring(0, 1).ToUpper())@(ingreso.Vehiculo?.Cliente?.Apellido?.Substring(0, 1).ToUpper())
                                        </div>
                                        <span>@ingreso.Vehiculo?.Cliente?.Nombre @ingreso.Vehiculo?.Cliente?.Apellido</span>
                                    </div>
                                </td>
                                <td>
                                    <span style="font-family: monospace; font-size: 0.875rem;">@ingreso.Vehiculo?.Patente</span>
                                    <span style="color: var(--muted-foreground); font-size: 0.875rem;"> - @ingreso.Vehiculo?.Marca @ingreso.Vehiculo?.Modelo</span>
                                </td>
                                <td>
                                    @if (ingreso.Diagnostico.Length > 40)
                                    {
                                        <span title="@ingreso.Diagnostico" style="font-size: 0.875rem;">
                                            @ingreso.Diagnostico.Substring(0, 40)...
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="font-size: 0.875rem;">@ingreso.Diagnostico</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <strong style="font-size: 1.125rem;">@dias.ToString("F1")</strong>
                                    <span style="font-size: 0.75rem; color: var(--muted-foreground);"> días</span>
                                </td>
                                <td style="text-align: center;">
                                    @if (rendimiento == "success")
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-thumbs-up me-1"></i>Rápido
                                        </span>
                                    }
                                    else if (rendimiento == "warning")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fas fa-clock me-1"></i>Normal
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fas fa-exclamation-triangle me-1"></i>Lento
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding: 3rem; text-align: center; color: var(--muted-foreground);">
                <i class="fas fa-clock" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.3;"></i>
                <p style="margin: 0;">No hay suficientes datos de reparaciones finalizadas para generar el reporte.</p>
            </div>
        }
    </div>
</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Datos serializados desde el servidor
        var rangosLabels = @Html.Raw(ViewBag.RangosLabels);
        var rangosCantidades = @Html.Raw(ViewBag.RangosCantidades);
        var rapidos = @ViewBag.Rapidos;
        var normales = @ViewBag.Normales;
        var lentos = @ViewBag.Lentos;

        // 1. Gráfico de Barras: Distribución de tiempos por rango
        var ctx1 = document.getElementById('chartDistribucion').getContext('2d');
        new Chart(ctx1, {
            type: 'bar',
            data: {
                labels: rangosLabels,
                datasets: [{
                    label: 'Cantidad de reparaciones',
                    data: rangosCantidades,
                    backgroundColor: [
                        'rgba(16, 185, 129, 0.8)',  // 0-1: verde
                        'rgba(59, 130, 246, 0.8)',  // 1-3: azul
                        'rgba(99, 102, 241, 0.8)',  // 3-5: indigo
                        'rgba(245, 158, 11, 0.8)',  // 5-7: amarillo
                        'rgba(239, 68, 68, 0.7)',   // 7-10: rojo claro
                        'rgba(185, 28, 28, 0.8)'    // 10+: rojo oscuro
                    ],
                    borderColor: [
                        'rgba(16, 185, 129, 1)',
                        'rgba(59, 130, 246, 1)',
                        'rgba(99, 102, 241, 1)',
                        'rgba(245, 158, 11, 1)',
                        'rgba(239, 68, 68, 1)',
                        'rgba(185, 28, 28, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Distribución de reparaciones por tiempo de permanencia',
                        font: { size: 14 }
                    },
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: 'Cantidad de reparaciones' },
                        ticks: { stepSize: 1 }
                    },
                    x: {
                        title: { display: true, text: 'Rango de tiempo' }
                    }
                }
            }
        });

        // 2. Gráfico de Torta: Rendimiento
        var ctx2 = document.getElementById('chartRendimiento').getContext('2d');
        new Chart(ctx2, {
            type: 'doughnut',
            data: {
                labels: ['Rápido (≤ promedio)', 'Normal (≤ 1.5x promedio)', 'Lento (> 1.5x promedio)'],
                datasets: [{
                    data: [rapidos, normales, lentos],
                    backgroundColor: [
                        'rgba(16, 185, 129, 0.8)',
                        'rgba(245, 158, 11, 0.8)',
                        'rgba(239, 68, 68, 0.8)'
                    ],
                    borderColor: [
                        'rgba(16, 185, 129, 1)',
                        'rgba(245, 158, 11, 1)',
                        'rgba(239, 68, 68, 1)'
                    ],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Clasificación por rendimiento',
                        font: { size: 14 }
                    },
                    legend: { position: 'bottom' },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                var total = context.dataset.data.reduce((a, b) => a + b, 0);
                                var pct = total > 0 ? ((context.raw / total) * 100).toFixed(1) : 0;
                                return context.label + ': ' + context.raw + ' (' + pct + '%)';
                            }
                        }
                    }
                }
            }
        });
    });
</script>
