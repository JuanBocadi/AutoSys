@{
    ViewData["Title"] = "Rentabilidad por Cliente";
    var rentabilidad = ViewBag.Rentabilidad as IEnumerable<dynamic>;
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-chart-bar" style="margin-right: 0.5rem; color: #10b981;"></i>
                Rentabilidad por Cliente
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">Análisis de ingresos generados por cliente, cruzando facturación, vehículos y reparaciones</p>
        </div>
        <a asp-action="Index" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>
</div>

<!-- KPIs principales -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div class="card" style="border-left: 4px solid #10b981;">
        <div class="card-body">
            <div style="display: flex; justify-content: space-between; align-items: start;">
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin-bottom: 0.5rem;">Total Recaudado</p>
                    <h3 style="font-size: 1.75rem; font-weight: 700; margin: 0; color: #10b981;">$@(((decimal)ViewBag.TotalRecaudadoGlobal).ToString("N0"))</h3>
                </div>
                <div style="width: 2.5rem; height: 2.5rem; background: #dcfce7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-dollar-sign" style="color: #10b981; font-size: 1.25rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card" style="border-left: 4px solid #3b82f6;">
        <div class="card-body">
            <div style="display: flex; justify-content: space-between; align-items: start;">
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin-bottom: 0.5rem;">Ticket Promedio</p>
                    <h3 style="font-size: 1.75rem; font-weight: 700; margin: 0; color: #3b82f6;">$@(((decimal)ViewBag.TicketPromedioGlobal).ToString("N0"))</h3>
                </div>
                <div style="width: 2.5rem; height: 2.5rem; background: #dbeafe; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-receipt" style="color: #3b82f6; font-size: 1.25rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card" style="border-left: 4px solid #6366f1;">
        <div class="card-body">
            <div style="display: flex; justify-content: space-between; align-items: start;">
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin-bottom: 0.5rem;">Clientes con Facturación</p>
                    <h3 style="font-size: 1.75rem; font-weight: 700; margin: 0; color: #6366f1;">@ViewBag.ClientesConFactura / @ViewBag.TotalClientes</h3>
                </div>
                <div style="width: 2.5rem; height: 2.5rem; background: #e0e7ff; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-users" style="color: #6366f1; font-size: 1.25rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card" style="border-left: 4px solid #f59e0b;">
        <div class="card-body">
            <div style="display: flex; justify-content: space-between; align-items: start;">
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin-bottom: 0.5rem;">Servicios vs Repuestos</p>
                    <h3 style="font-size: 1.25rem; font-weight: 700; margin: 0;">
                        <span style="color: #3b82f6;">$@(((decimal)ViewBag.TotalServiciosGlobal).ToString("N0"))</span>
                        <span style="color: var(--muted-foreground); font-size: 0.875rem;"> / </span>
                        <span style="color: #f59e0b;">$@(((decimal)ViewBag.TotalRepuestosGlobal).ToString("N0"))</span>
                    </h3>
                </div>
                <div style="width: 2.5rem; height: 2.5rem; background: #fef3c7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-balance-scale" style="color: #f59e0b; font-size: 1.25rem;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Gráficos -->
<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
    <!-- Gráfico de Barras: Top 10 Clientes más Rentables -->
    <div class="card">
        <div class="card-header">
            <h3 style="font-size: 1.125rem; font-weight: 700; margin: 0;">
                <i class="fas fa-chart-bar" style="margin-right: 0.5rem; color: #10b981;"></i>
                Top 10 Clientes más Rentables
            </h3>
        </div>
        <div class="card-body">
            <canvas id="chartRentabilidad" style="max-height: 400px;"></canvas>
        </div>
    </div>

    <!-- Gráfico de Torta: Servicios vs Repuestos -->
    <div class="card">
        <div class="card-header">
            <h3 style="font-size: 1.125rem; font-weight: 700; margin: 0;">
                <i class="fas fa-chart-pie" style="margin-right: 0.5rem; color: #6366f1;"></i>
                Composición de Facturación
            </h3>
        </div>
        <div class="card-body" style="display: flex; align-items: center; justify-content: center;">
            <canvas id="chartComposicion" style="max-height: 350px;"></canvas>
        </div>
    </div>
</div>

<!-- Info de toma de decisiones -->
<div class="card" style="margin-bottom: 1.5rem; border-left: 4px solid #3b82f6;">
    <div class="card-body">
        <h4 style="font-size: 1rem; font-weight: 700; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fas fa-lightbulb" style="color: #f59e0b;"></i>
            Información para la Toma de Decisiones
        </h4>
        <ul style="margin: 0; padding-left: 1.5rem; line-height: 1.8;">
            <li>Los <strong>clientes del Top 10</strong> representan la mayor fuente de ingresos. Considere estrategias de fidelización para retenerlos.</li>
            <li>Compare la proporción de <strong>Servicios vs Repuestos</strong> para optimizar el inventario y definir promociones.</li>
            <li>Los clientes con <strong>alta frecuencia pero bajo ticket</strong> podrían beneficiarse de paquetes de mantenimiento.</li>
            <li>Clientes con <strong>múltiples vehículos</strong> tienen mayor potencial de ingresos recurrentes.</li>
        </ul>
    </div>
</div>

<!-- Tabla detallada -->
<div class="card">
    <div class="card-header">
        <h3 style="font-size: 1.125rem; font-weight: 700; margin: 0;">
            <i class="fas fa-table" style="margin-right: 0.5rem;"></i>
            Detalle de Rentabilidad por Cliente
        </h3>
    </div>
    <div class="card-body" style="padding: 0;">
        @if (rentabilidad != null && rentabilidad.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="text-align: center;">#</th>
                            <th>Cliente</th>
                            <th style="text-align: center;">Vehículos</th>
                            <th style="text-align: center;">Ingresos</th>
                            <th style="text-align: center;">Facturas</th>
                            <th style="text-align: right;">Servicios</th>
                            <th style="text-align: right;">Repuestos</th>
                            <th style="text-align: right;">Total Facturado</th>
                            <th style="text-align: right;">Ticket Prom.</th>
                            <th>Última Visita</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int pos = 1;
                        }
                        @foreach (var item in rentabilidad)
                        {
                            <tr>
                                <td style="text-align: center;">
                                    @if (pos <= 3)
                                    {
                                        var medalColor = pos == 1 ? "#f59e0b" : pos == 2 ? "#94a3b8" : "#3b82f6";
                                        <span style="color: @medalColor; font-weight: 700; font-size: 1.25rem;">
                                            <i class="fas fa-medal"></i> @pos
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="font-weight: 600;">@pos</span>
                                    }
                                </td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <div style="width: 2.5rem; height: 2.5rem; background: #f4f4f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; color: #71717a;">
                                            @item.Cliente.Nombre?.Substring(0, 1).ToUpper()@item.Cliente.Apellido?.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div style="font-weight: 600;">@item.Cliente.Nombre @item.Cliente.Apellido</div>
                                            <div style="font-size: 0.75rem; color: var(--muted-foreground);">DNI: @(item.Cliente.DNI ?? "-")</div>
                                        </div>
                                    </div>
                                </td>
                                <td style="text-align: center;">
                                    <span style="color: #1e40af; font-weight: 700;"><i class="fas fa-car"></i> @item.TotalVehiculos</span>
                                </td>
                                <td style="text-align: center;">
                                    <span style="color: #15803d; font-weight: 700;"><i class="fas fa-clipboard-list"></i> @item.TotalIngresos</span>
                                </td>
                                <td style="text-align: center;">
                                    <span style="font-weight: 600;">@item.CantidadFacturas</span>
                                </td>
                                <td style="text-align: right; font-family: monospace;">
                                    $@(((decimal)item.TotalServicios).ToString("N2"))
                                </td>
                                <td style="text-align: right; font-family: monospace;">
                                    $@(((decimal)item.TotalRepuestos).ToString("N2"))
                                </td>
                                <td style="text-align: right;">
                                    <strong style="font-family: monospace; color: #10b981;">$@(((decimal)item.TotalFacturado).ToString("N2"))</strong>
                                </td>
                                <td style="text-align: right; font-family: monospace;">
                                    $@(((decimal)item.TicketPromedio).ToString("N2"))
                                </td>
                                <td>
                                    @if (item.UltimaVisita != null)
                                    {
                                        DateTime ultimaVisita = item.UltimaVisita;
                                        <div style="font-size: 0.875rem;">@ultimaVisita.ToString("dd/MM/yyyy")</div>
                                    }
                                    else
                                    {
                                        <span style="color: var(--muted-foreground);">-</span>
                                    }
                                </td>
                            </tr>
                            pos++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding: 3rem; text-align: center; color: var(--muted-foreground);">
                <i class="fas fa-chart-bar" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.3;"></i>
                <p style="margin: 0;">No hay datos de clientes disponibles</p>
            </div>
        }
    </div>
</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Datos serializados desde el servidor
        var nombres = @Html.Raw(ViewBag.Top10Nombres);
        var facturado = @Html.Raw(ViewBag.Top10Facturado);
        var servicios = @Html.Raw(ViewBag.Top10Servicios);
        var repuestos = @Html.Raw(ViewBag.Top10Repuestos);
        var serviciosVsRepuestos = @Html.Raw(ViewBag.ServiciosVsRepuestos);

        // Gráfico de Barras Apiladas: Top 10 Clientes
        var ctx1 = document.getElementById('chartRentabilidad').getContext('2d');
        new Chart(ctx1, {
            type: 'bar',
            data: {
                labels: nombres,
                datasets: [
                    {
                        label: 'Servicios ($)',
                        data: servicios,
                        backgroundColor: 'rgba(59, 130, 246, 0.8)',
                        borderColor: 'rgba(59, 130, 246, 1)',
                        borderWidth: 1
                    },
                    {
                        label: 'Repuestos ($)',
                        data: repuestos,
                        backgroundColor: 'rgba(245, 158, 11, 0.8)',
                        borderColor: 'rgba(245, 158, 11, 1)',
                        borderWidth: 1
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Facturación desglosada por cliente (Servicios vs Repuestos)',
                        font: { size: 14 }
                    },
                    legend: { position: 'top' }
                },
                scales: {
                    x: {
                        stacked: true,
                        ticks: { maxRotation: 45, minRotation: 25 }
                    },
                    y: {
                        stacked: true,
                        beginAtZero: true,
                        title: { display: true, text: 'Monto ($)' },
                        ticks: {
                            callback: function (value) {
                                return '$' + value.toLocaleString();
                            }
                        }
                    }
                }
            }
        });

        // Gráfico de Torta: Servicios vs Repuestos
        var ctx2 = document.getElementById('chartComposicion').getContext('2d');
        new Chart(ctx2, {
            type: 'doughnut',
            data: {
                labels: ['Servicios', 'Repuestos'],
                datasets: [{
                    data: serviciosVsRepuestos,
                    backgroundColor: [
                        'rgba(59, 130, 246, 0.8)',
                        'rgba(245, 158, 11, 0.8)'
                    ],
                    borderColor: [
                        'rgba(59, 130, 246, 1)',
                        'rgba(245, 158, 11, 1)'
                    ],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Distribución: Servicios vs Repuestos',
                        font: { size: 14 }
                    },
                    legend: { position: 'bottom' },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                var total = context.dataset.data.reduce((a, b) => a + b, 0);
                                var pct = total > 0 ? ((context.raw / total) * 100).toFixed(1) : 0;
                                return context.label + ': $' + context.raw.toLocaleString() + ' (' + pct + '%)';
                            }
                        }
                    }
                }
            }
        });
    });
</script>
