@inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> UserManager
@inject AutoSys.Services.IPermissionService PermissionService
@using System.Security.Claims
@{
    string currentUsername = "";
    bool navVerClientes     = false;
    bool navVerVehiculos    = false;
    bool navVerIngresos     = false;
    bool navVerReparaciones = false;
    bool navVerStock        = false;
    bool navVerFacturacion  = false;
    bool navVerReportes     = false;
    bool navVerBackups      = false;
    bool navVerAuditoria    = false;
    bool navVerServiciosFijos = false;
    bool navGestionarServiciosFijos = false;
    bool navEsAdmin         = false;
    string userRoleName     = "Sin rol";

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        currentUsername = currentUser?.UserName ?? User.Identity.Name ?? "";

        var roles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
        userRoleName = roles.FirstOrDefault() ?? "Sin rol";

        navEsAdmin = userRoleName == "Administrador";

        if (navEsAdmin)
        {
            navVerClientes = navVerVehiculos = navVerIngresos = navVerReparaciones =
            navVerStock = navVerFacturacion = navVerReportes = navVerBackups = navVerAuditoria = 
            navVerServiciosFijos = navGestionarServiciosFijos = true;
        }
        else
        {
            var userId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
            var permisos = await PermissionService.ObtenerPermisosEfectivosAsync(userId, userRoleName);

            navVerClientes     = permisos.VerClientes;
            navVerVehiculos    = permisos.VerVehiculos;
            navVerIngresos     = permisos.VerIngresos;
            navVerReparaciones = permisos.VerReparaciones;
            navVerStock        = permisos.VerStock;
            navVerFacturacion  = permisos.VerFacturacion;
            navVerReportes     = permisos.VerReportes;
            navVerBackups      = permisos.VerBackups;
            navVerAuditoria    = permisos.VerAuditoria;
            navVerServiciosFijos = permisos.VerServiciosFijos;
            navGestionarServiciosFijos = permisos.GestionarServiciosFijos;
        }
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, viewport-fit=cover" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>@ViewData["Title"] - AutoSys Taller</title>
    <meta name="description" content="AutoSys - Sistema de gestión integral para talleres mecánicos. Administre clientes, vehículos, reparaciones, stock y facturación." />
    <link rel="preload" as="image" href="@Url.Content("~/images/logo-light.png")" fetchpriority="high" />
    <link rel="preload" as="image" href="@Url.Content("~/images/logo-dark.png")" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />
    
    @await Html.PartialAsync("_CriticalCss")
    <!-- Bootstrap local (no blocking con preload) -->
    <link rel="preload" href="~/lib/bootstrap/dist/css/bootstrap.min.css" as="style" asp-append-version="true" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" /></noscript>
    <!-- site.css no blocking -->
    <link rel="preload" href="~/css/site.css" as="style" asp-append-version="true" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></noscript>

    <!-- Carga diferida de recursos no críticos -->
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" /></noscript>
</head>
<body class="autosys-layout">
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <!-- Mobile Menu Toggle -->
        <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle Menu">
            <i class="fas fa-bars"></i>
        </button>
        
        <!-- Mobile Overlay -->
        <div class="mobile-overlay" id="mobileOverlay"></div>
        
        <div class="autosys-container">
            <!-- Sidebar -->
            <aside class="autosys-sidebar" id="sidebar">
                <!-- Theme Toggle Button - Top Right of Sidebar -->
                <button id="themeToggleSidebar" class="theme-toggle-sidebar" title="Cambiar tema">
                    <i class="fas fa-moon" id="themeIconSidebar"></i>
                </button>
                
                <div class="sidebar-header">
                    <div class="sidebar-logo">
                        <img src="~/images/logo-light.png" alt="AutoSys Logo" class="sidebar-logo-img logo-light" id="sidebarLogo" width="180" height="101" />
                        <img src="~/images/logo-dark.png" alt="AutoSys Logo" class="sidebar-logo-img logo-dark" id="sidebarLogoDark" width="180" height="101" fetchpriority="high" />
                    </div>
                </div>

                <nav class="sidebar-nav">
                    <a asp-controller="Home" asp-action="Index" class="nav-item">
                        <i class="fas fa-home"></i>
                        <span>Dashboard</span>
                    </a>
                    
                    @if (navVerClientes)
                    {
                        <a asp-controller="Clientes" asp-action="Index" class="nav-item">
                            <i class="fas fa-users"></i>
                            <span>Clientes</span>
                        </a>
                    }

                    @if (navVerVehiculos)
                    {
                        <a asp-controller="Vehiculos" asp-action="Index" class="nav-item">
                            <i class="fas fa-car"></i>
                            <span>Vehículos</span>
                        </a>
                    }
                    
                    @if (navVerIngresos)
                    {
                        <a asp-controller="Ingreso" asp-action="Index" class="nav-item">
                            <i class="fas fa-clipboard-list"></i>
                            <span>Ingresos</span>
                        </a>
                    }
                    
                    @if (navVerReparaciones)
                    {
                        <a asp-controller="Reparaciones" asp-action="Index" class="nav-item">
                            <i class="fas fa-tools"></i>
                            <span>Reparaciones</span>
                        </a>
                    }
                    
                    @if (navVerServiciosFijos)
                    {
                        <a asp-controller="ServiciosFijos" asp-action="Index" class="nav-item">
                            <i class="fas fa-list-check"></i>
                            <span>Servicios Fijos</span>
                        </a>
                    }

                    @if (navVerStock)
                    {
                        <a asp-controller="Stock" asp-action="Index" class="nav-item">
                            <i class="fas fa-boxes"></i>
                            <span>Stock</span>
                        </a>
                    }
                    
                    @if (navVerFacturacion)
                    {
                        <a asp-controller="Facturacion" asp-action="Index" class="nav-item">
                            <i class="fas fa-receipt"></i>
                            <span>Facturación</span>
                        </a>
                    }
                    
                    @if (navVerReportes)
                    {
                        <a asp-controller="Reportes" asp-action="Index" class="nav-item">
                            <i class="fas fa-chart-bar"></i>
                            <span>Reportes</span>
                        </a>
                    }

                    @if (navVerBackups)
                    {
                        <a asp-controller="Backup" asp-action="Index" class="nav-item">
                            <i class="fas fa-shield-alt"></i>
                            <span>Resguardo</span>
                        </a>
                    }
                    @if (navVerAuditoria)
                    {
                        <a asp-controller="Auditoria" asp-action="Index" class="nav-item">
                            <i class="fas fa-clipboard-check"></i>
                            <span>Auditoría</span>
                        </a>
                    }
                    @if (navEsAdmin)
                    {
                        <a asp-controller="Usuarios" asp-action="Index" class="nav-item">
                            <i class="fas fa-user-cog"></i>
                            <span>Usuarios</span>
                        </a>
                    }
                </nav>

                <div class="sidebar-footer">
                    <div style="padding: 0 0.75rem 0.5rem; text-align: center;">
                        <a asp-controller="Account" asp-action="CambiarPassword"
                           style="font-size: 0.75rem; color: var(--text-secondary); text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 0.35rem; padding: 0.4rem; border-radius: var(--radius); transition: background 0.15s;"
                           onmouseover="this.style.background='var(--bg-light)'" onmouseout="this.style.background='transparent'">
                            <i class="fas fa-key" style="font-size: 0.7rem;"></i>
                            Cambiar Contraseña
                        </a>
                    </div>
                    <div class="user-profile">
                        <div class="user-avatar">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="user-info">
                            <p class="user-name">@currentUsername</p>
                            <p class="user-role">@userRoleName</p>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-logout" title="Cerrar sesión">
                                <i class="fas fa-sign-out-alt"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </aside>

            <!-- Main Content -->
            <div class="autosys-main">
                <!-- Theme Toggle Button - Desktop Floating -->
                <button id="themeToggle" class="theme-toggle-floating" title="Cambiar tema">
                    <i class="fas fa-moon" id="themeIcon"></i>
                </button>
                
                <main role="main">
                    <!-- Breadcrumbs -->
                    @if (ViewData["Breadcrumb"] != null)
                    {
                        <nav aria-label="breadcrumb" class="mb-3">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                                @if (ViewData["BreadcrumbParent"] != null)
                                {
                                    <li class="breadcrumb-item"><a href="@ViewData["BreadcrumbParentUrl"]">@ViewData["BreadcrumbParent"]</a></li>
                                }
                                <li class="breadcrumb-item active" aria-current="page">@ViewData["Breadcrumb"]</li>
                            </ol>
                        </nav>
                    }
                    
                    @if (TempData["SuccessMessage"] != null || TempData["Success"] != null)
                    {
                        <div class="autosys-alert autosys-alert-success alert-dismissible">
                            <i class="fas fa-check-circle"></i>
                            <span>@(TempData["SuccessMessage"] ?? TempData["Success"])</span>
                            <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
                    {
                        <div class="autosys-alert autosys-alert-error alert-dismissible">
                            <i class="fas fa-exclamation-triangle"></i>
                            <span>@(TempData["ErrorMessage"] ?? TempData["Error"])</span>
                            <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    }
                    @if (TempData["InfoMessage"] != null || TempData["Info"] != null)
                    {
                        <div class="autosys-alert autosys-alert-info alert-dismissible">
                            <i class="fas fa-info-circle"></i>
                            <span>@(TempData["InfoMessage"] ?? TempData["Info"])</span>
                            <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- Login Page Layout -->
        <div class="login-container">
            @RenderBody()
        </div>
    }
    <!-- Scripts con defer para mejor performance -->
    <script src="~/lib/jquery/dist/jquery.min.js" defer></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <!-- AutoSys UI Components -->
    <script src="~/js/toast.js" asp-append-version="true" defer></script>
    <script src="~/js/ui-utilities.js" asp-append-version="true" defer></script>
    
    <!-- DarkReader: carga inmediata si dark mode está guardado (evita flash) -->
    <script>
        (function() {
            var saved = localStorage.getItem('theme') || 'light';
            if (saved === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
            function loadDR() {
                var s = document.createElement('script');
                s.src = '@Url.Content("~/lib/darkreader/darkreader.min.js")?v=0SC5raGph';
                s.onload = function() {
                    if (typeof DarkReader !== 'undefined' && localStorage.getItem('theme') === 'dark') {
                        DarkReader.setFetchMethod(window.fetch);
                        DarkReader.enable({ brightness: 100, contrast: 90, sepia: 10 });
                    }
                    document.dispatchEvent(new Event('darkreaderReady'));
                };
                document.head.appendChild(s);
            }
            if (saved === 'dark') {
                // Cargar DarkReader de inmediato para evitar el flash blanco
                loadDR();
            } else if ('requestIdleCallback' in window) {
                requestIdleCallback(loadDR, { timeout: 2000 });
            } else {
                setTimeout(loadDR, 100);
            }
        })();
    </script>
    
    <!-- Auto-convert TempData messages to Toasts -->
    <script>
        @if (TempData["SuccessMessage"] != null || TempData["Success"] != null)
        {
            <text>
            Toast.success('@Html.Raw(TempData["SuccessMessage"] ?? TempData["Success"])', 'Éxito');
            </text>
        }
        @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
        {
            <text>
            Toast.error('@Html.Raw(TempData["ErrorMessage"] ?? TempData["Error"])', 'Error');
            </text>
        }
        @if (TempData["WarningMessage"] != null || TempData["Warning"] != null)
        {
            <text>
            Toast.warning('@Html.Raw(TempData["WarningMessage"] ?? TempData["Warning"])', 'Advertencia');
            </text>
        }
        @if (TempData["InfoMessage"] != null || TempData["Info"] != null)
        {
            <text>
            Toast.info('@Html.Raw(TempData["InfoMessage"] ?? TempData["Info"])', 'Información');
            </text>
        }
    </script>
    
    <!-- Mobile Menu Handler -->
    <script src="~/js/mobile-menu.js" asp-append-version="true" defer></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>