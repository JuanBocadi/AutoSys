<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoSys Taller</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="autosys-layout">
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="autosys-container">
            <!-- Sidebar -->
            <aside class="autosys-sidebar">
                <div class="sidebar-header">
                    <div class="sidebar-logo">
                        <div class="logo-icon">
                            <i class="fas fa-wrench"></i>
                        </div>
                        <div class="logo-text">
                            <h1>AutoSys</h1>
                            <p>Gestión de Taller</p>
                        </div>
                    </div>
                </div>

                <nav class="sidebar-nav">
                    <a asp-controller="Home" asp-action="Index" class="nav-item">
                        <i class="fas fa-home"></i>
                        <span>Dashboard</span>
                    </a>
                    
                    @if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista"))
                    {
                        <a asp-controller="Clientes" asp-action="Index" class="nav-item">
                            <i class="fas fa-users"></i>
                            <span>Clientes</span>
                        </a>
                        <a asp-controller="Vehiculos" asp-action="Index" class="nav-item">
                            <i class="fas fa-car"></i>
                            <span>Vehículos</span>
                        </a>
                    }
                    
                    @if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista") || User.IsInRole("Mecanico"))
                    {
                        <a asp-controller="Ingreso" asp-action="Index" class="nav-item">
                            <i class="fas fa-clipboard-list"></i>
                            <span>Ingresos</span>
                        </a>
                    }
                    
                    @if (User.IsInRole("Administrador") || User.IsInRole("Mecanico"))
                    {
                        <a asp-controller="Reparaciones" asp-action="Index" class="nav-item">
                            <i class="fas fa-tools"></i>
                            <span>Reparaciones</span>
                        </a>
                        <a asp-controller="Stock" asp-action="Index" class="nav-item">
                            <i class="fas fa-boxes"></i>
                            <span>Stock</span>
                        </a>
                    }
                    
                    @if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista"))
                    {
                        <a asp-controller="Facturacion" asp-action="Index" class="nav-item">
                            <i class="fas fa-receipt"></i>
                            <span>Facturación</span>
                        </a>
                    }
                    
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-controller="Reportes" asp-action="Index" class="nav-item">
                            <i class="fas fa-chart-bar"></i>
                            <span>Reportes</span>
                        </a>
                        <a asp-controller="Usuarios" asp-action="Index" class="nav-item">
                            <i class="fas fa-user-cog"></i>
                            <span>Usuarios</span>
                        </a>
                    }
                </nav>

                <div class="sidebar-footer">
                    <div class="user-profile">
                        <div class="user-avatar">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="user-info">
                            <p class="user-name">@User.Identity.Name</p>
                            <p class="user-role">@(User.IsInRole("Administrador") ? "Administrador" : User.IsInRole("Recepcionista") ? "Recepcionista" : "Mecánico")</p>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-logout" title="Cerrar sesión">
                                <i class="fas fa-sign-out-alt"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </aside>

            <!-- Main Content -->
            <div class="autosys-main">
                <!-- Theme Toggle Button - Floating -->
                <button id="themeToggle" class="theme-toggle-floating" title="Cambiar tema">
                    <i class="fas fa-moon" id="themeIcon"></i>
                </button>
                
                <main role="main">
                    @if (TempData["SuccessMessage"] != null || TempData["Success"] != null)
                    {
                        <div class="autosys-alert autosys-alert-success">
                            <i class="fas fa-check-circle"></i>
                            <span>@(TempData["SuccessMessage"] ?? TempData["Success"])</span>
                            <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
                    {
                        <div class="autosys-alert autosys-alert-error">
                            <i class="fas fa-exclamation-triangle"></i>
                            <span>@(TempData["ErrorMessage"] ?? TempData["Error"])</span>
                            <button type="button" class="alert-close" onclick="this.parentElement.remove()">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- Login Page Layout -->
        <div class="login-container">
            @RenderBody()
        </div>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>