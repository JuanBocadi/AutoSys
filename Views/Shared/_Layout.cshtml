<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoSys Taller</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-car-wrench me-2"></i>
                    <strong>AutoSys</strong>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            // --- MÓDULOS COMUNES O CON MÚLTIPLES ROLES ---
                            if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista") || User.IsInRole("Mecanico"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Ingreso" asp-action="Index"><i class="fas fa-sign-in-alt me-1"></i>Ingresos</a></li>
                            }
                            if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Clientes" asp-action="Index"><i class="fas fa-users me-1"></i>Clientes</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Vehiculos" asp-action="Index"><i class="fas fa-car me-1"></i>Vehículos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Facturacion" asp-action="Index"><i class="fas fa-file-invoice-dollar me-1"></i>Facturación</a></li>
                            }
                            if (User.IsInRole("Administrador") || User.IsInRole("Mecanico"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Reparaciones" asp-action="Index"><i class="fas fa-tools me-1"></i>Reparaciones</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Stock" asp-action="Index"><i class="fas fa-boxes me-1"></i>Stock</a></li>
                            }

                            // --- MÓDULOS EXCLUSIVOS DE ADMINISTRADOR ---
                            if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Reportes" asp-action="Index"><i class="fas fa-chart-line me-1"></i>Reportes</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index"><i class="fas fa-user-cog me-1"></i>Usuarios</a></li>
                            }
                        }
                    </ul>
                    <div class="d-flex align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="navbar-text text-white me-3">
                                Hola, @User.Identity.Name!
                            </span>
                            <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light">
                                    <i class="fas fa-sign-out-alt me-1"></i>Cerrar Sesión
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-primary" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-sign-in-alt me-1"></i>Iniciar Sesión
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4 mb-4 flex-grow-1">
        <main role="main" class="pb-3">
            @if (TempData["SuccessMessage"] != null || TempData["Success"] != null)
            {
                <div id="autosys-alert-success" class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@(TempData["SuccessMessage"] ?? TempData["Success"]) 
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null || TempData["Error"] != null)
            {
                <div id="autosys-alert-error" class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>@(TempData["ErrorMessage"] ?? TempData["Error"]) 
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top text-muted bg-light py-3">
        <div class="container text-center">
            &copy; @DateTime.Now.Year - AutoSys - Sistema de Gestión de Taller
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>