@model AutoSys.Models.Cliente
@{
    ViewData["Title"] = $"Vehículos de {Model.Nombre} {Model.Apellido}";
}

<div class="mt-4">
    <!-- Breadcrumb para navegación jerárquica -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Clientes" asp-action="Index">
                    <i class="fas fa-users me-1"></i>Clientes
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fas fa-car me-1"></i>@Model.Nombre @Model.Apellido
            </li>
        </ol>
    </nav>

    <!-- Información del cliente -->
    <div class="card shadow-lg border-0 rounded-lg mb-4">
        <div class="card-header bg-primary text-white py-3">
            <h2 class="mb-0">
                <i class="fas fa-user me-2"></i>@Model.Nombre @Model.Apellido
            </h2>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <p><strong><i class="fas fa-phone me-2"></i>Teléfono:</strong> @Model.Telefono</p>
                </div>
                <div class="col-md-4">
                    <p><strong><i class="fas fa-id-card me-2"></i>DNI:</strong> @(string.IsNullOrEmpty(Model.DNI) ? "-" : Model.DNI)</p>
                </div>
                <div class="col-md-4">
                    <p><strong><i class="fas fa-envelope me-2"></i>Email:</strong> @(string.IsNullOrEmpty(Model.Email) ? "-" : Model.Email)</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Estadísticas de vehículos -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-info shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-info">@(Model.Vehiculos?.Count ?? 0)</h3>
                    <p class="mb-0"><i class="fas fa-car me-1"></i>Vehículos Totales</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-warning shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-warning">@(Model.Vehiculos?.Sum(v => v.Ingresos?.Count ?? 0) ?? 0)</h3>
                    <p class="mb-0"><i class="fas fa-tools me-1"></i>Reparaciones Totales</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-success shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-success">@(Model.Vehiculos?.Sum(v => v.Ingresos?.Count(i => !i.FechaEgreso.HasValue) ?? 0) ?? 0)</h3>
                    <p class="mb-0"><i class="fas fa-wrench me-1"></i>Reparaciones Activas</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de vehículos -->
    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-header bg-secondary text-white py-3">
            <h3 class="mb-0"><i class="fas fa-car me-2"></i>Vehículos del Cliente</h3>
        </div>
        <div class="card-body p-4">
            @if (Model.Vehiculos != null && Model.Vehiculos.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Patente</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th class="text-center">Reparaciones</th>
                                <th class="text-center">Activas</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Vehiculos)
                            {
                                var reparacionesActivas = v.Ingresos?.Count(i => !i.FechaEgreso.HasValue) ?? 0;
                                <tr>
                                    <td><strong>@v.Patente</strong></td>
                                    <td>@v.Marca</td>
                                    <td>@v.Modelo</td>
                                    <td class="text-center">
                                        <span class="badge bg-info">@(v.Ingresos?.Count ?? 0)</span>
                                    </td>
                                    <td class="text-center">
                                        @if (reparacionesActivas > 0)
                                        {
                                            <span class="badge bg-warning text-dark">@reparacionesActivas</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Vehiculos" 
                                           asp-action="ReparacionesDelVehiculo" 
                                           asp-route-id="@v.Id" 
                                           class="btn btn-sm btn-primary"
                                           title="Ver reparaciones de @v.Patente">
                                            <i class="fas fa-tools me-1"></i>Ver Reparaciones
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Este cliente no tiene vehículos registrados.
                </div>
            }
        </div>
    </div>

    <!-- Botón para volver -->
    <div class="mt-3">
        <a asp-controller="Clientes" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver a Clientes
        </a>
    </div>
</div>
