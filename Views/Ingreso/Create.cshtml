@model AutoSys.Models.Ingreso
@{
    ViewData["Title"] = "Registrar Nuevo Ingreso";
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-clipboard-list" style="margin-right: 0.5rem; color: #3b82f6;"></i>
                Registrar Nuevo Ingreso
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">Complete los datos para registrar el ingreso del vehículo al taller</p>
        </div>
        <a asp-action="Index" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>
</div>

<!-- Formulario -->
<div class="card">
    <div class="card-body">

        <form asp-action="Create" enctype="multipart/form-data" method="post" id="ingresoForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row g-3">
                <!-- Vehículo -->
                <div class="col-12">
                    <label asp-for="VehiculoId" class="form-label">
                        <i class="fas fa-car me-1"></i> Vehículo
                        <span class="text-danger">*</span>
                    </label>
                    <select asp-for="VehiculoId" class="form-select" asp-items="@(new SelectList(ViewBag.Vehiculos, "Id", "Descripcion"))" required>
                        <option value="">-- Seleccione un vehículo --</option>
                    </select>
                    <span asp-validation-for="VehiculoId" class="text-danger"></span>
                    <div class="form-text">
                        <i class="fas fa-info-circle me-1"></i>
                        Si el vehículo no existe, <a asp-controller="Vehiculos" asp-action="Create" target="_blank">créalo aquí primero</a>.
                    </div>
                </div>

                <!-- Diagnóstico -->
                <div class="col-12">
                    <label asp-for="Diagnostico" class="form-label">
                        <i class="fas fa-stethoscope me-1"></i> Diagnóstico Inicial
                        <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="Diagnostico" class="form-control" rows="4" placeholder="Describa el problema o la solicitud del cliente..." required></textarea>
                    <span asp-validation-for="Diagnostico" class="text-danger"></span>
                </div>

                <!-- Foto -->
                <div class="col-12">
                    <label for="customFile" class="form-label">
                        <i class="fas fa-camera me-1"></i> Foto del vehículo (opcional)
                    </label>
                    <input type="file" name="Foto" class="form-control" id="customFile" accept="image/*" onchange="previewImage(event)">

                    @if (ViewBag.FotoTempPath != null)
                    {
                        <input type="hidden" name="FotoTempPath" value="@ViewBag.FotoTempPath" />
                        <div style="margin-top: 1rem;">
                            <img id="imagePreview" src="@ViewBag.FotoTempPath" alt="Vista previa" style="max-height: 250px; border-radius: var(--radius); border: 1px solid var(--border);" />
                        </div>
                    }
                    else
                    {
                        <img id="imagePreview" src="#" alt="Vista previa" style="display: none; margin-top: 1rem; max-height: 250px; border-radius: var(--radius); border: 1px solid var(--border);" />
                    }
                </div>
            </div>

            <!-- Botones -->
            <div style="margin-top: 2rem; display: flex; gap: 0.75rem; justify-content: flex-end;">
                <a asp-action="Index" class="btn btn-outline">
                    <i class="fas fa-times me-2"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <i class="fas fa-save me-2"></i>Registrar Ingreso
                </button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Preview de imagen
        function previewImage(event) {
            const imagePreview = document.getElementById('imagePreview');
            const file = event.target.files[0];

            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.src = e.target.result;
                    imagePreview.style.display = 'block';
                }
                reader.readAsDataURL(file);
            } else {
                imagePreview.src = '#';
                imagePreview.style.display = 'none';
            }
        }

        // Mostrar preview si ya existe imagen
        window.addEventListener("load", function () {
            const imagePreview = document.getElementById('imagePreview');
            if (imagePreview && imagePreview.src && !imagePreview.src.endsWith('#')) {
                imagePreview.style.display = 'block';
            }
        });

        // Loading state al enviar
        document.getElementById('ingresoForm').addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('submitBtn');
            
            if (this.checkValidity()) {
                AutoSysUI.setButtonLoading(submitBtn, true);
            }
        });
    </script>
}