@model AutoSys.Models.Ingreso
@{
    ViewData["Title"] = "Registrar Nuevo Ingreso";
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-clipboard-list" style="margin-right: 0.5rem; color: #3b82f6;"></i>
                Registrar Nuevo Ingreso
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">Complete los datos para registrar el ingreso del vehículo al taller</p>
        </div>
        <a asp-action="Index" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>
</div>

<!-- Formulario -->
<div class="card">
    <div class="card-body">

        <form asp-action="Create" enctype="multipart/form-data" method="post" id="ingresoForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row g-3">
                <!-- Vehículo - Búsqueda estilo Google -->
                <div class="col-12">
                    <label asp-for="VehiculoId" class="form-label">
                        <i class="fas fa-car me-1"></i> Vehículo
                        <span class="text-danger">*</span>
                    </label>

                    <input type="hidden" asp-for="VehiculoId" id="VehiculoId" />

                    <div class="vehiculo-search-container">
                        <!-- Badge del vehículo seleccionado -->
                        <div id="vehiculoSeleccionado" class="vehiculo-selected-badge" style="display: none;">
                            <i class="fas fa-car"></i>
                            <span id="vehiculoSeleccionadoTexto"></span>
                            <button type="button" class="vehiculo-selected-clear" id="limpiarVehiculo" title="Quitar selección">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>

                        <!-- Input de búsqueda -->
                        <input type="text"
                               id="buscarVehiculoInput"
                               class="form-control search-input"
                               placeholder="Buscar por patente, marca, modelo o cliente..."
                               autocomplete="off" />

                        <!-- Dropdown de resultados -->
                        <div id="vehiculoResultados" class="vehiculo-search-results" style="display: none;">
                            <!-- Los resultados se cargan dinámicamente -->
                        </div>
                    </div>

                    <span asp-validation-for="VehiculoId" class="text-danger"></span>
                    <div class="form-text">
                        <i class="fas fa-info-circle me-1"></i>
                        Si el vehículo no existe, <a asp-controller="Vehiculos" asp-action="Create" target="_blank">créalo aquí primero</a>.
                    </div>
                </div>

                <!-- Servicios Fijos (Múltiples con Buscador) -->
                <div class="col-12">
                    <label class="form-label">
                        <i class="fas fa-list-check me-1"></i> Servicios Fijos (Opcional)
                    </label>

                    <div class="servicio-search-container" style="position: relative;">
                        <!-- Contenedor de Servicios Seleccionados (Tags) -->
                        <div id="serviciosSeleccionadosContainer" class="mb-2 d-flex flex-wrap gap-2">
                            <!-- Los tags se agregan aquí dinámicamente -->
                        </div>

                        <!-- Input de búsqueda -->
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input type="text"
                                   id="buscarServicioInput"
                                   class="form-control"
                                   placeholder="Escriba para buscar un servicio (ej: aceite, frenos...)"
                                   autocomplete="off" />
                        </div>

                        <!-- Dropdown de resultados -->
                        <div id="servicioResultadosDropdown" class="vehiculo-search-results" style="display: none; padding-top: 0; padding-bottom: 0;">
                            <!-- Los resultados se cargan dinámicamente -->
                        </div>

                        <!-- Inputs ocultos para el POST -->
                        <div id="hiddenServiciosInputs">
                            @if (ViewBag.SelectedServicioIds != null)
                            {
                                foreach (var id in (List<int>)ViewBag.SelectedServicioIds)
                                {
                                    <input type="hidden" name="SelectedServicioIds" value="@id" />
                                }
                            }
                        </div>
                    </div>

                    <div class="form-text">
                        <i class="fas fa-info-circle me-1"></i> 
                        Busque y seleccione los servicios predefinidos que desea realizar.
                    </div>
                </div>

                <!-- Diagnóstico -->
                <div class="col-12">
                    <label asp-for="Diagnostico" class="form-label" id="labelDiagnostico">
                        <i class="fas fa-stethoscope me-1"></i> Diagnóstico Inicial
                        <span class="text-danger" id="reqDiagnostico">*</span>
                    </label>
                    <textarea asp-for="Diagnostico" class="form-control" rows="4" placeholder="Describa el problema o la solicitud del cliente..." id="Diagnostico"></textarea>
                    <span asp-validation-for="Diagnostico" class="text-danger"></span>
                    <div class="form-text" id="helpDiagnostico">El diagnóstico es obligatorio si no selecciona ningún servicio.</div>
                </div>

                <!-- Foto -->
                <div class="col-12">
                    <label for="customFile" class="form-label">
                        <i class="fas fa-camera me-1"></i> Foto del vehículo (opcional)
                    </label>
                    <input type="file" name="Foto" class="form-control" id="customFile" accept="image/*" onchange="previewImage(event)">

                    @if (ViewBag.FotoTempPath != null)
                    {
                        <input type="hidden" name="FotoTempPath" value="@ViewBag.FotoTempPath" />
                        <div style="margin-top: 1rem;">
                            <img id="imagePreview" src="@ViewBag.FotoTempPath" alt="Vista previa" style="max-height: 250px; border-radius: var(--radius); border: 1px solid var(--border);" />
                        </div>
                    }
                    else
                    {
                        <img id="imagePreview" src="#" alt="Vista previa" style="display: none; margin-top: 1rem; max-height: 250px; border-radius: var(--radius); border: 1px solid var(--border);" />
                    }
                </div>
            </div>

            <!-- Botones -->
            <div style="margin-top: 2rem; display: flex; gap: 0.75rem; justify-content: flex-end;">
                <a asp-action="Index" class="btn btn-outline">
                    <i class="fas fa-times me-2"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <i class="fas fa-save me-2"></i>Registrar Ingreso
                </button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // ══════════════════════════════════════════════════════
        // BÚSQUEDA DE VEHÍCULOS - Autocomplete estilo Google
        // ══════════════════════════════════════════════════════
        (function () {
            const inputBuscar = document.getElementById('buscarVehiculoInput');
            const inputHidden = document.getElementById('VehiculoId');
            const divResultados = document.getElementById('vehiculoResultados');
            const divSeleccionado = document.getElementById('vehiculoSeleccionado');
            const spanTexto = document.getElementById('vehiculoSeleccionadoTexto');
            const btnLimpiar = document.getElementById('limpiarVehiculo');

            let debounceTimer = null;
            let resultadosData = [];
            let indiceActivo = -1;

            // ── Fetch de vehículos ──
            function buscarVehiculos(termino) {
                const url = '@Url.Action("BuscarVehiculos", "Ingreso")' + 
                    (termino ? '?termino=' + encodeURIComponent(termino) : '');

                fetch(url)
                    .then(r => r.json())
                    .then(data => {
                        resultadosData = data;
                        indiceActivo = -1;
                        renderResultados(data, termino);
                    })
                    .catch(() => {
                        divResultados.innerHTML = '<div class="vehiculo-search-empty"><i class="fas fa-exclamation-triangle me-1"></i>Error al buscar vehículos</div>';
                        divResultados.style.display = 'block';
                    });
            }

            // ── Renderizar resultados ──
            function renderResultados(datos, termino) {
                if (datos.length === 0) {
                    divResultados.innerHTML = '<div class="vehiculo-search-empty"><i class="fas fa-search me-1"></i>No se encontraron vehículos</div>';
                    divResultados.style.display = 'block';
                    return;
                }

                let html = '';
                datos.forEach(function (v, i) {
                    const textoResaltado = termino ? resaltarCoincidencia(v.descripcion, termino) : v.descripcion;
                    html += '<div class="vehiculo-search-item" data-index="' + i + '" data-id="' + v.id + '" data-descripcion="' + escapeHtml(v.descripcion) + '">'
                        + '<div class="vehiculo-search-item-main">'
                        + '<i class="fas fa-car vehiculo-search-item-icon"></i>'
                        + '<div>'
                        + '<div class="vehiculo-search-item-patente">' + resaltarCoincidencia(v.patente, termino) + '</div>'
                        + '<div class="vehiculo-search-item-detalle">' + escapeHtml(v.marca) + ' ' + escapeHtml(v.modelo) + '</div>'
                        + '</div>'
                        + '</div>'
                        + '<div class="vehiculo-search-item-cliente"><i class="fas fa-user me-1"></i>' + escapeHtml(v.clienteNombre) + '</div>'
                        + '</div>';
                });

                divResultados.innerHTML = html;
                divResultados.style.display = 'block';

                // Event listeners en los items
                divResultados.querySelectorAll('.vehiculo-search-item').forEach(function (item) {
                    item.addEventListener('click', function () {
                        seleccionarVehiculo(
                            parseInt(this.dataset.id),
                            this.dataset.descripcion
                        );
                    });
                    item.addEventListener('mouseenter', function () {
                        indiceActivo = parseInt(this.dataset.index);
                        actualizarItemActivo();
                    });
                });
            }

            // ── Seleccionar vehículo ──
            function seleccionarVehiculo(id, descripcion) {
                inputHidden.value = id;
                spanTexto.textContent = descripcion;
                divSeleccionado.style.display = 'flex';
                inputBuscar.style.display = 'none';
                inputBuscar.value = '';
                cerrarResultados();
            }

            // ── Limpiar selección ──
            function limpiarSeleccion() {
                inputHidden.value = '';
                spanTexto.textContent = '';
                divSeleccionado.style.display = 'none';
                inputBuscar.style.display = '';
                inputBuscar.value = '';
                inputBuscar.focus();
            }

            // ── Cerrar dropdown ──
            function cerrarResultados() {
                divResultados.style.display = 'none';
                indiceActivo = -1;
            }

            // ── Navegación con teclado ──
            function actualizarItemActivo() {
                const items = divResultados.querySelectorAll('.vehiculo-search-item');
                items.forEach(function (el, i) {
                    el.classList.toggle('active', i === indiceActivo);
                });
                // Scroll al item activo
                if (indiceActivo >= 0 && items[indiceActivo]) {
                    items[indiceActivo].scrollIntoView({ block: 'nearest' });
                }
            }

            // ── Utilidades ──
            function escapeHtml(str) {
                if (!str) return '';
                const div = document.createElement('div');
                div.textContent = str;
                return div.innerHTML;
            }

            function resaltarCoincidencia(texto, termino) {
                if (!termino || !texto) return escapeHtml(texto);
                const escaped = escapeHtml(texto);
                const regex = new RegExp('(' + termino.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
                return escaped.replace(regex, '<mark>$1</mark>');
            }

            // ══════════════════════════════════
            // EVENT LISTENERS
            // ══════════════════════════════════

            // Focus → mostrar todos si está vacío
            inputBuscar.addEventListener('focus', function () {
                buscarVehiculos(this.value.trim());
            });

            // Input → debounce de búsqueda
            inputBuscar.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                const val = this.value.trim();
                debounceTimer = setTimeout(function () {
                    buscarVehiculos(val);
                }, 300);
            });

            // Teclado (flechas, enter, escape)
            inputBuscar.addEventListener('keydown', function (e) {
                const items = divResultados.querySelectorAll('.vehiculo-search-item');
                if (!items.length) return;

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    indiceActivo = Math.min(indiceActivo + 1, items.length - 1);
                    actualizarItemActivo();
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    indiceActivo = Math.max(indiceActivo - 1, 0);
                    actualizarItemActivo();
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (indiceActivo >= 0 && items[indiceActivo]) {
                        items[indiceActivo].click();
                    }
                } else if (e.key === 'Escape') {
                    cerrarResultados();
                    inputBuscar.blur();
                }
            });

            // Clic fuera → cerrar
            document.addEventListener('click', function (e) {
                if (!e.target.closest('.vehiculo-search-container')) {
                    cerrarResultados();
                }
            });

            // Botón limpiar
            btnLimpiar.addEventListener('click', limpiarSeleccion);

            // ══════════════════════════════════
            // PRESELECCIÓN (volver de Confirmar)
            // ══════════════════════════════════
            (function () {
                const vehiculoIdPrecargado = inputHidden.value;
                if (vehiculoIdPrecargado && vehiculoIdPrecargado !== '0' && vehiculoIdPrecargado !== '') {
                    // Buscar la descripción del vehículo precargado
                    fetch('@Url.Action("BuscarVehiculos", "Ingreso")')
                        .then(r => r.json())
                        .then(data => {
                            const vehiculo = data.find(v => v.id === parseInt(vehiculoIdPrecargado));
                            if (vehiculo) {
                                seleccionarVehiculo(vehiculo.id, vehiculo.descripcion);
                            }
                        });
                }
            })();
        })();

        // ══════════════════════════════════════════════════════
        // PREVIEW DE IMAGEN (existente)
        // ══════════════════════════════════════════════════════
        function previewImage(event) {
            const imagePreview = document.getElementById('imagePreview');
            const file = event.target.files[0];

            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.src = e.target.result;
                    imagePreview.style.display = 'block';
                }
                reader.readAsDataURL(file);
            } else {
                imagePreview.src = '#';
                imagePreview.style.display = 'none';
            }
        }

        // Mostrar preview si ya existe imagen
        window.addEventListener("load", function () {
            const imagePreview = document.getElementById('imagePreview');
            if (imagePreview && imagePreview.src && !imagePreview.src.endsWith('#')) {
                imagePreview.style.display = 'block';
            }
        });

        // Loading state al enviar
        document.getElementById('ingresoForm').addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('submitBtn');
            
            if (this.checkValidity()) {
                AutoSysUI.setButtonLoading(submitBtn, true);
            }
        });

        // ══════════════════════════════════════════════════════
        // LÓGICA DE SERVICIOS FIJOS (Buscador y Tags)
        // ══════════════════════════════════════════════════════
        (function() {
            // Datos iniciales desde ViewBag
            const todosLosServicios = @Html.Raw(Json.Serialize(ViewBag.ServiciosFijos));
            const containerTags = document.getElementById('serviciosSeleccionadosContainer');
            const dropdown = document.getElementById('servicioResultadosDropdown');
            const inputBuscar = document.getElementById('buscarServicioInput');
            const containerHidden = document.getElementById('hiddenServiciosInputs');
            const textarea = document.getElementById('Diagnostico');
            const reqStar = document.getElementById('reqDiagnostico');
            const helpText = document.getElementById('helpDiagnostico');

            let seleccionadosIds = [];
            @if (ViewBag.SelectedServicioIds != null)
            {
                <text>seleccionadosIds = @Html.Raw(Json.Serialize(ViewBag.SelectedServicioIds));</text>
            }

            function actualizarUI() {
                // 1. Limpiar container de tags e inputs ocultos
                containerTags.innerHTML = '';
                containerHidden.innerHTML = '';

                // 2. Generar Tags y Hidden Inputs
                seleccionadosIds.forEach(id => {
                    const serv = todosLosServicios.find(s => s.id === id);
                    if (serv) {
                        // Crear Tag
                        const tag = document.createElement('span');
                        tag.className = 'badge bg-info d-inline-flex align-items-center gap-1 p-2';
                        tag.style.fontSize = '0.9rem';
                        tag.innerHTML = `<i class="fas fa-list-check me-1"></i> ${serv.nombre} 
                                        <button type="button" class="btn-close btn-close-white" style="font-size: 0.6rem; padding: 0.2rem;" onclick="quitarServicio(${serv.id})"></button>`;
                        containerTags.appendChild(tag);

                        // Crear Hidden Input
                        const hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = 'SelectedServicioIds';
                        hidden.value = serv.id;
                        containerHidden.appendChild(hidden);
                    }
                });

                // 3. Actualizar validación de diagnóstico
                const tieneServicios = seleccionadosIds.length > 0;
                if (tieneServicios) {
                    textarea.required = false;
                    reqStar.style.display = 'none';
                    helpText.style.color = 'var(--muted-foreground)';
                } else {
                    textarea.required = true;
                    reqStar.style.display = 'inline';
                    helpText.style.color = 'var(--danger)';
                }
            }

            // Exponer función de quitar a nivel global para el onclick del botón close
            window.quitarServicio = function(id) {
                seleccionadosIds = seleccionadosIds.filter(sid => sid !== id);
                actualizarUI();
            };

            function agregarServicio(id) {
                if (!seleccionadosIds.includes(id)) {
                    seleccionadosIds.push(id);
                    actualizarUI();
                    
                    // Lógica de autocompletado en diagnóstico
                    const serv = todosLosServicios.find(s => s.id === id);
                    if (serv && serv.descripcionPredeterminada) {
                        let currentVal = textarea.value.trim();
                        if (!currentVal.includes(serv.descripcionPredeterminada)) {
                            if (currentVal !== "") currentVal += "\n";
                            currentVal += "- " + serv.descripcionPredeterminada;
                            textarea.value = currentVal;
                            
                            textarea.style.backgroundColor = '#ecfdf5';
                            setTimeout(() => textarea.style.backgroundColor = '', 500);
                        }
                    }
                }
                cerrarDropdown();
                inputBuscar.value = '';
            }

            function renderResultados(termino) {
                const filtrados = todosLosServicios.filter(s => 
                    !seleccionadosIds.includes(s.id) && 
                    (s.nombre.toLowerCase().includes(termino.toLowerCase()) || 
                     (s.descripcionPredeterminada && s.descripcionPredeterminada.toLowerCase().includes(termino.toLowerCase())))
                ).slice(0, 10); // Limitar a 10 resultados

                if (filtrados.length === 0) {
                    dropdown.innerHTML = '<div class="vehiculo-search-empty"><i class="fas fa-search me-1"></i>No se encontraron servicios</div>';
                } else {
                    let html = '';
                    filtrados.forEach(s => {
                        html += `
                            <div class="vehiculo-search-item" onclick="agregarServicioDesdeUI(${s.id})">
                                <div class="vehiculo-search-item-main">
                                    <i class="fas fa-list-check vehiculo-search-item-icon"></i>
                                    <div>
                                        <div class="vehiculo-search-item-patente">${s.nombre}</div>
                                        <div class="vehiculo-search-item-detalle">${s.descripcionPredeterminada || ''}</div>
                                    </div>
                                </div>
                                <div class="vehiculo-search-item-cliente">${s.precioSugerido ? '$' + s.precioSugerido.toLocaleString('es-AR') : ''}</div>
                            </div>`;
                    });
                    dropdown.innerHTML = html;
                }
                dropdown.style.display = 'block';
            }

            window.agregarServicioDesdeUI = function(id) {
                agregarServicio(id);
            };

            function cerrarDropdown() {
                dropdown.style.display = 'none';
            }

            inputBuscar.addEventListener('focus', function() {
                renderResultados(this.value.trim());
            });

            inputBuscar.addEventListener('click', function(e) {
                e.stopPropagation();
                renderResultados(this.value.trim());
            });

            inputBuscar.addEventListener('input', function() {
                renderResultados(this.value.trim());
            });

            // Hacer que todo el contenedor de búsqueda sea clickeable para enfocar el input
            inputBuscar.closest('.servicio-search-container').addEventListener('click', function(e) {
                if (e.target !== inputBuscar) {
                    inputBuscar.focus();
                }
            });

            document.addEventListener('click', function(e) {
                if (!e.target.closest('.servicio-search-container')) {
                    cerrarDropdown();
                }
            });

            // Inicializar al cargar
            actualizarUI();
        })();
    </script>
}