@model AutoSys.Models.Ingreso

@{
    ViewData["Title"] = "Detalle del Ingreso";
}

<div style="max-width: 900px; margin: 0 auto;">
    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">
            <i class="fas fa-file-alt" style="color: var(--accent-green);"></i>
            Detalle del Ingreso
        </h1>
        <p class="page-subtitle">Información completa del ingreso del vehículo</p>
    </div>

    <div class="card">
        <div class="card-body">
            <dl style="display: grid; grid-template-columns: 200px 1fr; gap: var(--spacing-md); margin-bottom: var(--spacing-lg);">
                <dt style="font-weight: 600; color: var(--text-primary);">Cliente</dt>
                <dd style="color: var(--text-primary);">
                    @Model.Vehiculo?.Cliente?.Nombre @Model.Vehiculo?.Cliente?.Apellido
                </dd>

                <dt style="font-weight: 600; color: var(--text-primary);">Vehículo</dt>
                <dd style="color: var(--text-primary);">
                    @Model.Vehiculo?.Marca @Model.Vehiculo?.Modelo (@Model.Vehiculo?.Patente)
                </dd>

                <dt style="font-weight: 600; color: var(--text-primary);">Diagnóstico</dt>
                <dd style="color: var(--text-primary);">
                    @Model.Diagnostico
                </dd>

                <dt style="font-weight: 600; color: var(--text-primary);">Fecha de Ingreso</dt>
                <dd style="color: var(--text-primary);">
                    @Model.FechaIngreso.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt style="font-weight: 600; color: var(--text-primary);">Fecha de Egreso</dt>
                <dd style="color: var(--text-primary);">
                    @if (Model.FechaEgreso == null)
                    {
                        <span class="badge-warning">Aún no egresado</span>
                    }
                    else
                    {
                        @Model.FechaEgreso?.ToString("dd/MM/yyyy HH:mm")
                    }
                </dd>

                <dt style="font-weight: 600; color: var(--text-primary);">Estado</dt>
                <dd>
                    <form asp-action="ActualizarEstado"
                          asp-controller="Ingreso"
                          method="post"
                          style="display: flex; gap: var(--spacing-sm); align-items: center;">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <select name="estado" class="form-select" style="width: auto;">
                                    @if (Model.Estado == "En revisión")
                                    {
                                        <option value="En revisión" selected>En revisión</option>
                                    }
                                    else
                                    {
                                        <option value="En revisión">En revisión</option>
                                    }

                                    @if (Model.Estado == "En proceso")
                                    {
                                        <option value="En proceso" selected>En proceso</option>
                                    }
                                    else
                                    {
                                        <option value="En proceso">En proceso</option>
                                    }

                                    @if (Model.Estado == "Finalizado")
                                    {
                                        <option value="Finalizado" selected>Finalizado</option>
                                    }
                                    else
                                    {
                                        <option value="Finalizado">Finalizado</option>
                                    }

                                    @if (Model.Estado == "Entregado")
                                    {
                                        <option value="Entregado" selected>Entregado</option>
                                    }
                                    else
                                    {
                                        <option value="Entregado">Entregado</option>
                                    }
                        </select>

                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="fas fa-save" style="margin-right: var(--spacing-xs);"></i>Guardar
                        </button>
                    </form>
                </dd>

                @if (!string.IsNullOrEmpty(Model.FotoPath))
                {
                    <dt style="font-weight: 600; color: var(--text-primary);">Foto</dt>
                    <dd>
                        <img src="@Model.FotoPath"
                             alt="Foto del vehículo"
                             style="max-width: 100%; height: auto; border-radius: var(--border-radius-md); box-shadow: var(--shadow-md); max-height: 300px;" />
                    </dd>
                }
            </dl>

            <div style="display: flex; flex-direction: column; gap: var(--spacing-md); margin-top: var(--spacing-xl);">
                <a href="@Url.Action("Create", "Ingreso")" class="btn btn-primary btn-lg">
                    <i class="fas fa-plus" style="margin-right: var(--spacing-sm);"></i>Registrar otro ingreso
                </a>

                <a href="@Url.Action("Index", "Ingreso")" class="btn btn-secondary btn-lg">
                    <i class="fas fa-list" style="margin-right: var(--spacing-sm);"></i> Ver todos los ingresos
                </a>
            </div>
        </div>
    </div>
</div>
