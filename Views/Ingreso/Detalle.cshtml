@model AutoSys.Models.Ingreso

@{
    ViewData["Title"] = "Detalle del Ingreso";
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-file-alt" style="margin-right: 0.5rem; color: #3b82f6;"></i>
                Detalle del Ingreso #@Model.Id.ToString("D4")
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">Información completa del ingreso del vehículo</p>
        </div>
        <a asp-action="Index" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>
</div>

<!-- Info Card -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-body">
        <div class="row g-4">
            <!-- Cliente -->
            <div class="col-md-6">
                <div style="padding: 1rem; background: #f9fafb; border-radius: var(--radius);">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                        <i class="fas fa-user" style="color: var(--muted-foreground);"></i>
                        <h3 style="font-size: 0.875rem; font-weight: 600; color: var(--muted-foreground); margin: 0;">Cliente</h3>
                    </div>
                    <p style="font-size: 1.125rem; font-weight: 700; margin: 0;">
                        @(Model.Cliente?.Nombre ?? Model.Vehiculo?.Cliente?.Nombre) @(Model.Cliente?.Apellido ?? Model.Vehiculo?.Cliente?.Apellido)
                    </p>
                    <p style="font-size: 0.875rem; color: var(--muted-foreground); margin: 0;">
                        <i class="fas fa-phone"></i> @(Model.Cliente?.Telefono ?? Model.Vehiculo?.Cliente?.Telefono)
                    </p>
                </div>
            </div>

            <!-- Vehículo -->
            <div class="col-md-6">
                <div style="padding: 1rem; background: #f9fafb; border-radius: var(--radius);">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                        <i class="fas fa-car" style="color: var(--muted-foreground);"></i>
                        <h3 style="font-size: 0.875rem; font-weight: 600; color: var(--muted-foreground); margin: 0;">Vehículo</h3>
                    </div>
                    <p style="font-size: 1.125rem; font-weight: 700; margin: 0;">
                        @Model.Vehiculo?.Marca @Model.Vehiculo?.Modelo
                    </p>
                    <p style="font-size: 0.875rem; color: var(--muted-foreground); margin: 0; font-family: monospace;">
                        Patente: @Model.Vehiculo?.Patente
                    </p>
                </div>
            </div>

            <!-- Diagnóstico -->
            <div class="col-12">
                <div style="padding: 1rem; background: #f9fafb; border-radius: var(--radius);">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                        <i class="fas fa-stethoscope" style="color: var(--muted-foreground);"></i>
                        <h3 style="font-size: 0.875rem; font-weight: 600; color: var(--muted-foreground); margin: 0;">Diagnóstico</h3>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Diagnostico))
                    {
                        <p style="font-size: 1rem; margin: 0;">@Model.Diagnostico</p>
                    }
                    else
                    {
                        <p style="font-size: 1rem; margin: 0; color: var(--muted-foreground); font-style: italic;">
                            Sin diagnóstico manual (Servicios predefinidos seleccionados)
                        </p>
                    }
                    
                    @if (Model.ServiciosFijos != null && Model.ServiciosFijos.Any())
                    {
                        <div style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px dotted var(--border);">
                            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem;">
                                @foreach (var s in Model.ServiciosFijos)
                                {
                                    <span class="badge bg-info" style="font-size: 0.85rem;">
                                        <i class="fas fa-list-check me-1"></i> @s.Nombre
                                        @if (s.PrecioSugerido.HasValue)
                                        {
                                            <span style="border-left: 1px solid rgba(255,255,255,0.3); margin-left: 0.5rem; padding-left: 0.5rem;">
                                                @s.PrecioSugerido.Value.ToString("C")
                                            </span>
                                        }
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Fechas -->
            <div class="col-md-6">
                <div style="padding: 1rem; background: #f9fafb; border-radius: var(--radius);">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                        <i class="fas fa-calendar-plus" style="color: var(--muted-foreground);"></i>
                        <h3 style="font-size: 0.875rem; font-weight: 600; color: var(--muted-foreground); margin: 0;">Fecha de Ingreso</h3>
                    </div>
                    <p style="font-size: 1.125rem; font-weight: 700; margin: 0;">
                        @Model.FechaIngreso.ToString("dd/MM/yyyy HH:mm")
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div style="padding: 1rem; background: #f9fafb; border-radius: var(--radius);">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                        <i class="fas fa-calendar-check" style="color: var(--muted-foreground);"></i>
                        <h3 style="font-size: 0.875rem; font-weight: 600; color: var(--muted-foreground); margin: 0;">Fecha de Egreso</h3>
                    </div>
                    @if (Model.FechaEgreso == null)
                    {
                        <span style="color: #f59e0b; font-weight: 700; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.875rem;">
                            <i class="fas fa-clock"></i> Aún en taller
                        </span>
                    }
                    else
                    {
                        <p style="font-size: 1.125rem; font-weight: 700; margin: 0;">
                            @Model.FechaEgreso?.ToString("dd/MM/yyyy HH:mm")
                        </p>
                    }
                </div>
            </div>

            <!-- Estado -->
            <div class="col-12">
                <div style="padding: 1rem; background: #f9fafb; border-radius: var(--radius);">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
                        <i class="fas fa-tasks" style="color: var(--muted-foreground);"></i>
                        <h3 style="font-size: 0.875rem; font-weight: 600; color: var(--muted-foreground); margin: 0;">Estado del Ingreso</h3>
                    </div>
                    <form asp-action="ActualizarEstado"
                          asp-controller="Ingreso"
                          method="post"
                          style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <select name="estado" class="form-select" style="flex: 1; min-width: 200px;">
                            @if (Model.Estado == "En revisión")
                            {
                                <option value="En revisión" selected>En revisión</option>
                            }
                            else
                            {
                                <option value="En revisión">En revisión</option>
                            }
                            
                            @if (Model.Estado == "En proceso")
                            {
                                <option value="En proceso" selected>En proceso</option>
                            }
                            else
                            {
                                <option value="En proceso">En proceso</option>
                            }
                            
                            @if (Model.Estado == "Finalizado")
                            {
                                <option value="Finalizado" selected>Finalizado</option>
                            }
                            else
                            {
                                <option value="Finalizado">Finalizado</option>
                            }
                            
                            @if (Model.Estado == "Entregado")
                            {
                                <option value="Entregado" selected>Entregado</option>
                            }
                            else
                            {
                                <option value="Entregado">Entregado</option>
                            }
                        </select>

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Guardar Estado
                        </button>
                    </form>
                </div>
            </div>

            <!-- Foto -->
            @if (!string.IsNullOrEmpty(Model.FotoPath))
            {
                <div class="col-12">
                    <div style="padding: 1rem; background: #f9fafb; border-radius: var(--radius);">
                        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
                            <i class="fas fa-camera" style="color: var(--muted-foreground);"></i>
                            <h3 style="font-size: 0.875rem; font-weight: 600; color: var(--muted-foreground); margin: 0;">Foto del Vehículo</h3>
                        </div>
                        <img src="@Model.FotoPath"
                             alt="Foto del vehículo"
                             loading="lazy"
                             style="max-width: 100%; height: auto; border-radius: var(--radius); border: 1px solid var(--border); max-height: 400px;" />
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Actions Card -->
<div class="card">
    <div class="card-body">
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            @if (ViewBag.PuedeCrearIngreso == true)
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Registrar Otro Ingreso
                </a>
            }

            @if (Model.Estado == "Finalizado" || Model.Estado == "Entregado")
            {
                <a asp-controller="Facturacion" asp-action="Create" asp-route-ingresoId="@Model.Id" class="btn btn-success">
                    <i class="fas fa-file-invoice-dollar me-2"></i>Emitir Factura
                </a>
            }

            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-list me-2"></i>Ver Todos los Ingresos
            </a>
        </div>
    </div>
</div>
