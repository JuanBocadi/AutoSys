@model List<AutoSys.Models.Ingreso>
@{
    ViewData["Title"] = "Listado de Ingresos";
}

<div class="mt-4">
    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
            <h2 class="mb-0">
                <i class="fas fa-list me-2"></i> Ingresos Registrados
            </h2>
            @if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista"))
            {
                <a class="btn btn-light" asp-controller="Ingreso" asp-action="Create">
                    <i class="fas fa-plus-circle me-2"></i>Nuevo Ingreso
                </a>
            }
        </div>
        <div class="card-body p-4">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info text-center">
                    No hay ingresos registrados aún.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark text-center">
                            <tr>
                                <th>#</th>
                                <th>Cliente</th>
                                <th>Vehículo</th>
                                <th>Fecha Ingreso</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ingreso in Model)
                            {
                                <tr>
                                    <td class="text-center">@ingreso.Id</td>
                                    <td>@ingreso.Vehiculo?.Cliente?.Nombre @ingreso.Vehiculo?.Cliente?.Apellido</td>
                                    <td>@ingreso.Vehiculo?.Marca @ingreso.Vehiculo?.Modelo (@ingreso.Vehiculo?.Patente)</td>
                                    <td>@ingreso.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">
@{
    var estado = ingreso.Estado ?? "";
    string badgeClass = estado switch
    {
        "En revisión" => "badge bg-warning text-dark",
        "En proceso" => "badge bg-info text-dark",
        "Finalizado" => "badge bg-success",
        "Entregado" => "badge bg-secondary",
        _ => "badge bg-light text-dark"
    };
}
                                        <span class="@badgeClass">@estado</span>
                                    </td>
                                    <td class="text-center">
                                        <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Detalle", "Ingreso", new { id = ingreso.Id })">
                                            <i class="fas fa-eye me-1"></i> Ver
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>