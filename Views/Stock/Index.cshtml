@model IEnumerable<AutoSys.Models.Stock>
@{
    ViewData["Title"] = "Gestión de Stock";
}

<div class="mt-4">
    <div class="card shadow-lg border-0 rounded-lg mb-4">
        <div class="card-header bg-dark text-white py-3">
            <h2 class="mb-0"><i class="fas fa-boxes me-2"></i>Gestión de Stock</h2>
        </div>
    </div>

    <!-- Estadísticas principales -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-primary">@ViewBag.TotalItems</h3>
                    <p class="mb-0"><i class="fas fa-boxes me-1"></i>Total Items</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-success">@ViewBag.ItemsSuficientes</h3>
                    <p class="mb-0"><i class="fas fa-circle me-1"></i>Suficiente</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-warning">@ViewBag.ItemsBajo</h3>
                    <p class="mb-0"><i class="fas fa-circle me-1"></i>Bajo</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-danger shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-danger">@ViewBag.ItemsCriticos</h3>
                    <p class="mb-0"><i class="fas fa-circle me-1"></i>Crítico</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Leyenda de semaforización -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5><i class="fas fa-traffic-light me-2"></i>Leyenda de Semaforización</h5>
            <div class="d-flex gap-3 flex-wrap">
                <span class="badge bg-success px-3 py-2">
                    <i class="fas fa-circle me-1"></i>Verde: Suficiente (Cantidad > Mínimo × 2)
                </span>
                <span class="badge bg-warning text-dark px-3 py-2">
                    <i class="fas fa-circle me-1"></i>Amarillo: Bajo (Cantidad entre Mínimo y Mínimo × 2)
                </span>
                <span class="badge bg-danger px-3 py-2">
                    <i class="fas fa-circle me-1"></i>Rojo: Crítico (Cantidad < Mínimo)
                </span>
            </div>
        </div>
    </div>

    <!-- Tabla de stock -->
    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-header bg-secondary text-white py-3 d-flex justify-content-between align-items-center">
            <h3 class="mb-0"><i class="fas fa-list me-2"></i>Inventario de Stock</h3>
            @if (User.IsInRole("Administrador"))
            {
                <a asp-action="Create" class="btn btn-light">
                    <i class="fas fa-plus me-1"></i>Agregar Item
                </a>
            }
        </div>
        <div class="card-body p-4">
            <!-- Búsqueda -->
            <form method="get" asp-action="Index" class="mb-3">
                <div class="input-group">
                    <input type="text" name="buscar" class="form-control" 
                           placeholder="Buscar por nombre o descripción..." 
                           value="@ViewBag.Buscar">
                    <button class="btn btn-primary" type="submit">
                        <i class="fas fa-search me-1"></i>Buscar
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.Buscar))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-times"></i>
                        </a>
                    }
                </div>
            </form>
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-center">Stock Mínimo</th>
                                <th>Unidad</th>
                                <th class="text-end">Precio</th>
                                <th class="text-center">Nivel</th>
                                <th class="text-center">Indicador</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="@(item.ColorSemaforo == "danger" ? "table-danger" : "")">
                                    <td><strong>@item.Nombre</strong></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Descripcion))
                                        {
                                            if (item.Descripcion.Length > 50)
                                            {
                                                <span title="@item.Descripcion">
                                                    @item.Descripcion.Substring(0, 50)...
                                                </span>
                                            }
                                            else
                                            {
                                                @item.Descripcion
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center"><strong>@item.Cantidad</strong></td>
                                    <td class="text-center">@item.StockMinimo</td>
                                    <td>@(string.IsNullOrEmpty(item.Unidad) ? "-" : item.Unidad)</td>
                                    <td class="text-end">$@item.PrecioUnitario.ToString("N2")</td>
                                    <td class="text-center">
                                        <span class="badge bg-@item.ColorSemaforo">
                                            @item.NivelStock
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="semaforo-indicator semaforo-@item.ColorSemaforo" 
                                              title="@item.NivelStock">
                                            <i class="fas fa-circle fa-2x"></i>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <!-- Ajustar stock (todos los roles autorizados) -->
                                            <button type="button" class="btn btn-sm btn-info" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#ajustarModal@(item.Id)">
                                                <i class="fas fa-exchange-alt"></i>
                                            </button>
                                            
                                            @if (User.IsInRole("Administrador"))
                                            {
                                                <!-- Editar -->
                                                <a asp-action="Edit" asp-route-id="@item.Id" 
                                                   class="btn btn-sm btn-warning">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <!-- Eliminar -->
                                                <a asp-action="Delete" asp-route-id="@item.Id" 
                                                   class="btn btn-sm btn-danger">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            }
                                        </div>

                                        <!-- Modal para ajustar stock -->
                                        <div class="modal fade" id="ajustarModal@(item.Id)" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="AjustarStock" method="post">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Ajustar Stock - @item.Nombre</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p>Stock actual: <strong>@item.Cantidad @item.Unidad</strong></p>
                                                            <div class="mb-3">
                                                                <label class="form-label">Cantidad</label>
                                                                <input type="number" name="cantidad" class="form-control" 
                                                                       min="1" required />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label">Tipo de Ajuste</label>
                                                                <select name="tipo" class="form-select" required>
                                                                    <option value="agregar">Agregar al stock</option>
                                                                    <option value="quitar">Quitar del stock</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" 
                                                                    data-bs-dismiss="modal">Cancelar</button>
                                                            <button type="submit" class="btn btn-primary">
                                                                Ajustar Stock
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    No hay items en el stock.
                </div>
            }
        </div>
    </div>
</div>