@model IEnumerable<AutoSys.Models.Stock>
@{
    ViewData["Title"] = "Stock";
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-boxes" style="margin-right: 0.5rem; color: #10b981;"></i>
                Gestión de Stock
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">Control de inventario y niveles de stock</p>
        </div>
        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Agregar Item
            </a>
        }
    </div>
</div>

<!-- Stats Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #dbeafe; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-boxes" style="color: #3b82f6;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Total Items</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@ViewBag.TotalItems</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #dcfce7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-check-circle" style="color: #10b981;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Suficiente</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@ViewBag.ItemsSuficientes</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #fef3c7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-exclamation-circle" style="color: #f59e0b;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Stock Bajo</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@ViewBag.ItemsBajo</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #fee2e2; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-exclamation-triangle" style="color: #ef4444;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Crítico</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@ViewBag.ItemsCriticos</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Legend -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-body">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
            <i class="fas fa-traffic-light" style="color: var(--muted-foreground);"></i>
            <h3 style="font-size: 1rem; font-weight: 600; margin: 0;">Leyenda de Niveles</h3>
        </div>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <span style="color: #15803d; font-weight: 700; padding: 0.5rem 0; display: inline-flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-circle" style="font-size: 0.625rem;"></i> Verde: Suficiente (Cantidad > Mínimo × 2)
            </span>
            <span style="color: #b45309; font-weight: 700; padding: 0.5rem 0; display: inline-flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-circle" style="font-size: 0.625rem;"></i> Amarillo: Bajo (Cantidad entre Mínimo y Mínimo × 2)
            </span>
            <span style="color: #b91c1c; font-weight: 700; padding: 0.5rem 0; display: inline-flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-circle" style="font-size: 0.625rem;"></i> Rojo: Crítico (Cantidad ≤ Mínimo)
            </span>
        </div>
    </div>
</div>

<!-- Search Bar -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div style="display: flex; gap: 0.75rem;">
                <div style="position: relative; flex: 1;">
                    <input type="text" name="buscar" class="form-control" 
                           placeholder="Buscar por nombre o descripción..." 
                           value="@ViewBag.Buscar"
                           style="padding-left: 2.5rem;">
                    <i class="fas fa-search" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--muted-foreground);"></i>
                </div>
                <button class="btn btn-primary" type="submit">
                    <i class="fas fa-search"></i> Buscar
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.Buscar))
                {
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Limpiar
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-body" style="padding: 0;"
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th style="text-align: center;">Stock Actual</th>
                            <th style="text-align: center;">Mínimo</th>
                            <th style="text-align: center;">Nivel</th>
                            <th style="text-align: right;">Precio Unit.</th>
                            <th style="text-align: right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var iconColor = item.ColorSemaforo == "success" ? "#10b981" : item.ColorSemaforo == "warning" ? "#f59e0b" : "#ef4444";
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <div style="width: 2.5rem; height: 2.5rem; background: #f4f4f5; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-box" style="color: @iconColor;"></i>
                                        </div>
                                        <div>
                                            <div style="font-weight: 600;">@item.Nombre</div>
                                            <div style="font-size: 0.875rem; color: var(--muted-foreground);">
                                                @if (!string.IsNullOrEmpty(item.Descripcion))
                                                {
                                                    if (item.Descripcion.Length > 60)
                                                    {
                                                        <span title="@item.Descripcion">@item.Descripcion.Substring(0, 60)...</span>
                                                    }
                                                    else
                                                    {
                                                        @item.Descripcion
                                                    }
                                                }
                                                else
                                                {
                                                    <span>Sin descripción</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td style="text-align: center;">
                                    <div style="display: flex; flex-direction: column; align-items: center;">
                                        <span style="font-size: 1.25rem; font-weight: 700;">@item.Cantidad</span>
                                        <span style="font-size: 0.75rem; color: var(--muted-foreground);">@(string.IsNullOrEmpty(item.Unidad) ? "unid." : item.Unidad)</span>
                                    </div>
                                </td>
                                <td style="text-align: center;">
                                    <span style="color: #4b5563; font-weight: 600;">@item.StockMinimo</span>
                                </td>
                                <td style="text-align: center;">
                                    <div style="display: flex; flex-direction: column; align-items: center; gap: 0.25rem;">
                                        <i class="fas fa-circle semaforo-indicator" style="color: @iconColor; font-size: 1.25rem; animation: pulse 2s infinite;"></i>
                                        @{
                                            var nivelColor = item.ColorSemaforo == "success" ? "#15803d" : item.ColorSemaforo == "warning" ? "#b45309" : "#b91c1c";
                                        }
                                        <span style="color: @nivelColor; font-weight: 700; font-size: 0.875rem;">
                                            @item.NivelStock
                                        </span>
                                    </div>
                                </td>
                                <td style="text-align: right;">
                                    <span style="font-weight: 600; font-family: monospace;">$@item.PrecioUnitario.ToString("N2")</span>
                                </td>
                                <td style="text-align: right;">
                                    <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                        <button type="button" class="btn btn-sm btn-info btn-ajustar-stock" 
                                                data-stock-id="@item.Id"
                                                data-stock-nombre="@item.Nombre"
                                                data-stock-cantidad="@item.Cantidad"
                                                data-stock-unidad="@item.Unidad"
                                                title="Ajustar stock">
                                            <i class="fas fa-exchange-alt"></i> Ajustar
                                        </button>
                                        
                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <button type="button" class="btn btn-sm btn-warning btn-editar-stock"
                                                    data-stock-id="@item.Id"
                                                    data-stock-nombre="@item.Nombre"
                                                    data-stock-descripcion="@item.Descripcion"
                                                    data-stock-cantidad="@item.Cantidad"
                                                    data-stock-minimo="@item.StockMinimo"
                                                    data-stock-unidad="@item.Unidad"
                                                    data-stock-precio="@item.PrecioUnitario"
                                                    title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-danger btn-eliminar-stock"
                                                    data-stock-id="@item.Id"
                                                    data-stock-nombre="@item.Nombre"
                                                    data-stock-cantidad="@item.Cantidad"
                                                    data-stock-unidad="@item.Unidad"
                                                    title="Eliminar">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding: 3rem; text-align: center; color: var(--muted-foreground);">
                <i class="fas fa-boxes" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.3;"></i>
                <p style="margin: 0;">No hay items en el inventario</p>
            </div>
        }
    </div>
</div>

<!-- Modal único para ajustar stock -->
<div class="modal fade" id="ajustarStockModal" tabindex="-1" aria-labelledby="ajustarStockModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formAjustarStock" asp-action="AjustarStock" asp-controller="Stock" method="post">
                <input type="hidden" id="stockId" name="id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="ajustarStockModalLabel">
                        <i class="fas fa-exchange-alt" style="margin-right: 0.5rem;"></i>
                        Ajustar Stock - <span id="modalStockNombre"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div style="background: #f4f4f5; padding: 1rem; border-radius: var(--radius); margin-bottom: 1rem;">
                        <p style="margin: 0; color: var(--muted-foreground); font-size: 0.875rem;">Stock actual:</p>
                        <p style="font-size: 1.5rem; font-weight: 700; margin: 0;">
                            <span id="modalStockCantidad"></span> <span id="modalStockUnidad"></span>
                        </p>
                    </div>
                    <div class="mb-3">
                        <label for="stockCantidad" class="form-label">Cantidad</label>
                        <input type="number" id="stockCantidad" name="cantidad" class="form-control" 
                               min="1" required placeholder="Ingrese la cantidad" value="1" />
                    </div>
                    <div class="mb-3">
                        <label for="stockTipo" class="form-label">Tipo de Ajuste</label>
                        <select id="stockTipo" name="tipo" class="form-select" required>
                            <option value="agregar" selected>➕ Agregar al stock</option>
                            <option value="quitar">➖ Quitar del stock</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="btnConfirmarAjuste">
                        <i class="fas fa-check"></i> Confirmar Ajuste
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para editar stock -->
<div class="modal fade" id="editarStockModal" tabindex="-1" aria-labelledby="editarStockModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="formEditarStock" asp-action="Edit" asp-controller="Stock" method="post">
                <input type="hidden" id="editId" name="Id" />
                <div class="modal-header" style="background: var(--accent-orange); color: white;">
                    <h5 class="modal-title" id="editarStockModalLabel">
                        <i class="fas fa-edit" style="margin-right: 0.5rem;"></i>
                        Editar Item: <span id="editNombre"></span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="editNombreInput" class="form-label">Nombre</label>
                            <input type="text" id="editNombreInput" name="Nombre" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="editUnidad" class="form-label">Unidad</label>
                            <input type="text" id="editUnidad" name="Unidad" class="form-control" placeholder="ej: unid., kg, litros" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="editDescripcion" class="form-label">Descripción</label>
                        <textarea id="editDescripcion" name="Descripcion" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="editCantidad" class="form-label">Cantidad</label>
                            <input type="number" id="editCantidad" name="Cantidad" class="form-control" min="0" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="editStockMinimo" class="form-label">Stock Mínimo</label>
                            <input type="number" id="editStockMinimo" name="StockMinimo" class="form-control" min="1" required />
                            <small class="form-text text-muted">Cantidad mínima antes de reorden</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="editPrecio" class="form-label">Precio Unitario</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" id="editPrecio" name="PrecioUnitario" class="form-control" step="0.01" min="0" required />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-save"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para eliminar stock -->
<div class="modal fade" id="eliminarStockModal" tabindex="-1" aria-labelledby="eliminarStockModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formEliminarStock" asp-action="Delete" asp-controller="Stock" method="post">
                <input type="hidden" id="deleteId" name="Id" />
                <div class="modal-header" style="background: var(--accent-red); color: white;">
                    <h5 class="modal-title" id="eliminarStockModalLabel">
                        <i class="fas fa-trash" style="margin-right: 0.5rem;"></i>
                        Eliminar Item del Inventario
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger">
                        <h4 class="alert-heading">
                            <i class="fas fa-exclamation-triangle me-2"></i>¿Está seguro que desea eliminar este item?
                        </h4>
                        <p class="mb-0">Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Nombre:</dt>
                                <dd class="col-sm-8"><strong id="deleteNombre"></strong></dd>
                                
                                <dt class="col-sm-4">Cantidad Actual:</dt>
                                <dd class="col-sm-8">
                                    <strong><span id="deleteCantidad"></span> <span id="deleteUnidad"></span></strong>
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Confirmar Eliminación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/stock.js" asp-append-version="true"></script>
}