@model AutoSys.Models.Stock
@{
    ViewData["Title"] = "Editar Item";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-warning text-dark">
            <h2><i class="fas fa-edit me-2"></i>Editar Item: @Model.Nombre</h2>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Unidad" class="form-label"></label>
                        <input asp-for="Unidad" class="form-control" />
                        <span asp-validation-for="Unidad" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Cantidad" class="form-label"></label>
                        <input asp-for="Cantidad" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Cantidad" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="StockMinimo" class="form-label"></label>
                        <input asp-for="StockMinimo" class="form-control" type="number" min="1" />
                        <span asp-validation-for="StockMinimo" class="text-danger"></span>
                        <small class="form-text text-muted">Cantidad mínima antes de reorden</small>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="PrecioUnitario" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="PrecioUnitario" class="form-control" type="number" 
                                   step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="PrecioUnitario" class="text-danger"></span>
                    </div>
                </div>

                <div class="alert alert-info">
                    <strong>Última actualización:</strong> @Model.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Volver
                    </a>
                    <button type="submit" class="btn btn-warning text-dark">
                        <i class="fas fa-save me-1"></i>Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
