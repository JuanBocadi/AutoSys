@model AutoSys.Models.Stock
@{
    ViewData["Title"] = "Agregar Item al Stock";
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-box" style="margin-right: 0.5rem; color: #10b981;"></i>
                Agregar Item al Stock
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">Complete los datos del nuevo item de inventario</p>
        </div>
        <a asp-action="Index" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>
</div>

<!-- Formulario -->
<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" id="formStock">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row g-3">
                <!-- Nombre -->
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label">
                        <i class="fas fa-tag me-1"></i> Nombre
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Aceite 10W40" required />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <!-- Unidad -->
                <div class="col-md-6">
                    <label asp-for="Unidad" class="form-label">
                        <i class="fas fa-ruler me-1"></i> Unidad de Medida
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Unidad" class="form-control" placeholder="Ej: Litros, Unidades, etc." required />
                    <span asp-validation-for="Unidad" class="text-danger"></span>
                </div>

                <!-- Descripción -->
                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label">
                        <i class="fas fa-align-left me-1"></i> Descripción
                    </label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3" 
                              placeholder="Descripción detallada del item"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <!-- Cantidad -->
                <div class="col-md-4">
                    <label asp-for="Cantidad" class="form-label">
                        <i class="fas fa-boxes me-1"></i> Cantidad Actual
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Cantidad" class="form-control" type="number" min="0" required />
                    <span asp-validation-for="Cantidad" class="text-danger"></span>
                </div>

                <!-- Stock Mínimo -->
                <div class="col-md-4">
                    <label asp-for="StockMinimo" class="form-label">
                        <i class="fas fa-exclamation-triangle me-1"></i> Stock Mínimo
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="StockMinimo" class="form-control" type="number" min="1" required />
                    <span asp-validation-for="StockMinimo" class="text-danger"></span>
                    <div class="form-text">
                        <i class="fas fa-info-circle me-1"></i>
                        Cantidad mínima antes de reorden
                    </div>
                </div>

                <!-- Precio Unitario -->
                <div class="col-md-4">
                    <label asp-for="PrecioUnitario" class="form-label">
                        <i class="fas fa-dollar-sign me-1"></i> Precio Unitario
                        <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="PrecioUnitario" class="form-control" type="number" 
                               step="0.01" min="0" required />
                    </div>
                    <span asp-validation-for="PrecioUnitario" class="text-danger"></span>
                </div>
            </div>

            <!-- Botones -->
            <div style="margin-top: 2rem; display: flex; gap: 0.75rem; justify-content: flex-end;">
                <a asp-action="Index" class="btn btn-outline">
                    <i class="fas fa-times me-2"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <i class="fas fa-save me-2"></i>Guardar Item
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Agregar loading state al guardar
        document.getElementById('formStock').addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('submitBtn');
            
            if (this.checkValidity()) {
                AutoSysUI.setButtonLoading(submitBtn, true);
            }
        });
    </script>
}
