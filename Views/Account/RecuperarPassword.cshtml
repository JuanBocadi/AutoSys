@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoSys</title>
    <meta name="description" content="Recupere su contraseña de AutoSys de forma segura mediante enlace por correo electrónico." />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <style>:root{--bg-primary:#FFFFFF;--text-primary:#0A0A0A;--text-secondary:#737373;--bg-light:#FAFAFA;--border-color:#E5E5E5;--spacing-xs:.25rem;--spacing-sm:.5rem;--spacing-md:1rem;--spacing-lg:1.5rem;--spacing-xl:2rem;--spacing-2xl:3rem;--radius:.5rem;--radius-md:.5rem;--radius-lg:.75rem;--shadow-md:0 4px 6px -1px rgba(0,0,0,.1);--border-radius-md:.5rem;--border-radius-lg:.75rem}*{margin:0;padding:0;box-sizing:border-box}html,body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;background-color:var(--bg-primary);color:var(--text-primary);line-height:1.5}.login-container{min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg-light)}</style>
    <link rel="preload" href="~/css/site.css" as="style" asp-append-version="true" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></noscript>
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" /></noscript>
</head>
<body>
    <button id="themeToggle" class="theme-toggle-floating" title="Cambiar tema">
        <i class="fas fa-moon" id="themeIcon"></i>
    </button>
    
    <div class="login-container">
        <div class="card" style="width: 100%; max-width: 450px; margin: var(--spacing-xl);">
            <!-- Header -->
            <div style="padding: var(--spacing-2xl); text-align: center; border-bottom: 1px solid var(--border-color);">
                <div style="width: 4rem; height: 4rem; background: #fef3c7; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto var(--spacing-lg);">
                    <i class="fas fa-unlock-alt" style="font-size: 1.5rem; color: #f59e0b;"></i>
                </div>
                <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--text-primary); margin-bottom: var(--spacing-sm);">
                    Recuperar Contraseña
                </h1>
                <p style="color: var(--text-secondary); font-size: 0.9rem;">
                    Ingrese su correo electrónico para recibir un enlace de restablecimiento
                </p>
            </div>

            <!-- Contenido -->
            <div class="card-body" style="padding: var(--spacing-2xl);">
                @if (ViewBag.Error != null)
                {
                    <div style="background-color: #fee2e2; border: 1px solid #fca5a5; color: #991b1b; padding: var(--spacing-md); border-radius: var(--border-radius-md); margin-bottom: var(--spacing-lg); display: flex; align-items: center; gap: var(--spacing-sm);">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                @if (ViewBag.EmailEnviado == true)
                {
                    <!-- Confirmación de envío -->
                    <div style="text-align: center; padding: var(--spacing-lg) 0;">
                        <div style="width: 5rem; height: 5rem; background: #dcfce7; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto var(--spacing-lg);">
                            <i class="fas fa-envelope-open-text" style="font-size: 2rem; color: #10b981;"></i>
                        </div>
                        <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin-bottom: var(--spacing-md);">
                            ¡Revise su correo electrónico!
                        </h2>
                        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: var(--spacing-sm);">
                            Si existe una cuenta asociada a <strong>@ViewBag.EmailIngresado</strong>, 
                            se ha enviado un enlace para restablecer su contraseña.
                        </p>
                        <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: var(--spacing-lg);">
                            Revise también su carpeta de <strong>spam</strong> o <strong>correo no deseado</strong>.
                        </p>

                        <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: var(--border-radius-md); padding: var(--spacing-md); margin-bottom: var(--spacing-lg);">
                            <p style="font-size: 0.8rem; color: #1e40af; margin: 0;">
                                <i class="fas fa-clock" style="margin-right: 0.25rem;"></i>
                                El enlace tiene una duración limitada. Si expira, puede solicitar uno nuevo.
                            </p>
                        </div>

                        <a asp-action="RecuperarPassword" class="btn btn-primary" style="width: 100%; margin-bottom: var(--spacing-md); display: inline-block; text-decoration: none;">
                            <i class="fas fa-redo" style="margin-right: var(--spacing-sm);"></i>
                            Solicitar nuevo enlace
                        </a>

                        <div style="text-align: center;">
                            <a asp-action="Login" style="color: var(--text-secondary); font-size: 0.875rem; text-decoration: none;">
                                <i class="fas fa-arrow-left" style="margin-right: 0.25rem;"></i>
                                Volver al inicio de sesión
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Formulario de solicitud -->
                    <form asp-action="RecuperarPassword" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="form-group" style="margin-bottom: var(--spacing-lg);">
                            <label class="form-label" style="font-weight: 600;">
                                <i class="fas fa-envelope" style="margin-right: var(--spacing-xs); color: var(--text-secondary);"></i>
                                Correo electrónico
                            </label>
                            <input type="email" name="email" class="form-control"
                                   placeholder="ejemplo@correo.com"
                                   required autofocus
                                   style="padding-left: var(--spacing-md);" />
                        </div>

                        <button type="submit" class="btn btn-primary" style="width: 100%; margin-bottom: var(--spacing-md);">
                            <i class="fas fa-paper-plane" style="margin-right: var(--spacing-sm);"></i>
                            Enviar enlace de restablecimiento
                        </button>

                        <div style="text-align: center;">
                            <a asp-action="Login" style="color: var(--text-secondary); font-size: 0.875rem; text-decoration: none;">
                                <i class="fas fa-arrow-left" style="margin-right: 0.25rem;"></i>
                                Volver al inicio de sesión
                            </a>
                        </div>
                    </form>

                    <!-- Info de seguridad -->
                    <div style="margin-top: var(--spacing-xl); padding: var(--spacing-md); background: #eff6ff; border: 1px solid #bfdbfe; border-radius: var(--border-radius-md);">
                        <p style="font-size: 0.8rem; color: #1e40af; margin: 0 0 var(--spacing-sm) 0;">
                            <i class="fas fa-shield-alt" style="margin-right: 0.25rem;"></i>
                            <strong>Proceso seguro:</strong>
                        </p>
                        <ol style="font-size: 0.78rem; color: #1e40af; margin: 0; padding-left: var(--spacing-lg);">
                            <li>Ingrese su correo electrónico registrado</li>
                            <li>Recibirá un enlace seguro en su bandeja de entrada</li>
                            <li>Haga clic en el enlace para crear una nueva contraseña</li>
                        </ol>
                    </div>

                    <div style="margin-top: var(--spacing-md); padding: var(--spacing-md); background: #fef3c7; border: 1px solid #fcd34d; border-radius: var(--border-radius-md);">
                        <p style="font-size: 0.8rem; color: #92400e; margin: 0;">
                            <i class="fas fa-info-circle" style="margin-right: 0.25rem;"></i>
                            Si no tiene acceso a su correo, contacte al administrador del sistema para que restablezca su contraseña.
                        </p>
                    </div>
                }
            </div>

            <!-- Footer -->
            <div style="padding: var(--spacing-lg); background-color: var(--bg-light); border-top: 1px solid var(--border-color); text-align: center; border-bottom-left-radius: var(--border-radius-lg); border-bottom-right-radius: var(--border-radius-lg);">
                <p style="color: var(--text-secondary); font-size: 0.875rem; margin: 0;">
                    © 2025 AutoSys - Sistema de Gestión de Taller
                </p>
            </div>
        </div>
    </div>

    <script src="~/lib/darkreader/darkreader.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
