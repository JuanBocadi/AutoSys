@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoSys</title>
    <meta name="description" content="Inicie sesión en AutoSys para gestionar clientes, vehículos, reparaciones, stock y facturación del taller." />
    <link rel="preload" as="image" href="@Url.Content("~/images/logo-light.png")" fetchpriority="high" />
    <link rel="preload" as="image" href="@Url.Content("~/images/logo-dark.png")" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <style>:root{--bg-primary:#FFFFFF;--text-primary:#0A0A0A;--text-secondary:#737373;--bg-card:#FFFFFF;--sidebar-bg:#FAFAFA;--border-color:#E5E5E5;--border:#E5E5E5;--background:#FFFFFF;--bg-light:#FAFAFA;--foreground:#0A0A0A;--primary-blue:#161616;--spacing-xs:.25rem;--spacing-sm:.5rem;--spacing-md:1rem;--spacing-lg:1.5rem;--spacing-xl:2rem;--spacing-2xl:3rem;--radius:.5rem;--radius-md:.5rem;--radius-lg:.75rem;--shadow-md:0 4px 6px -1px rgba(0,0,0,.1);--border-radius-md:.5rem;--border-radius-lg:.75rem}*{margin:0;padding:0;box-sizing:border-box}html,body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;background-color:var(--bg-primary);color:var(--text-primary);line-height:1.5}.login-container{min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg-light)}.login-logo-img{max-width:200px;height:auto}.login-logo-img.logo-light{display:block}.login-logo-img.logo-dark{display:none}</style>
    <link rel="preload" href="~/css/site.css" as="style" asp-append-version="true" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></noscript>
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" /></noscript>
</head>
<body>
    <!-- Theme Toggle Button - Floating -->
    <button id="themeToggle" class="theme-toggle-floating" title="Cambiar tema">
        <i class="fas fa-moon" id="themeIcon"></i>
    </button>
    
    <div class="login-container">
        <div class="card" style="width: 100%; max-width: 450px; margin: var(--spacing-xl);">
            <!-- Header con logo y título -->
            <div style="padding: var(--spacing-2xl); text-align: center; border-bottom: 1px solid var(--border-color);">
                <div class="login-logo-container">
                    <img src="~/images/logo-light.png" alt="AutoSys Logo" class="login-logo-img logo-light" id="loginLogo" width="180" height="101" fetchpriority="high" loading="eager" decoding="async" />
                    <img src="~/images/logo-dark.png" alt="AutoSys Logo" class="login-logo-img logo-dark" id="loginLogoDark" width="180" height="101" loading="eager" decoding="async" />
                </div>
                <h1 style="font-size: 1.875rem; font-weight: 700; color: var(--text-primary); margin-bottom: var(--spacing-sm);">
                    Bienvenido a AutoSys
                </h1>
                <p style="color: var(--text-secondary); font-size: 0.95rem;">
                    Sistema de Gestión de Taller Mecánico
                </p>
            </div>

            <!-- Formulario -->
            <div class="card-body" style="padding: var(--spacing-2xl);">
                @if (ViewBag.Error != null)
                {
                    <div style="background-color: #fee2e2; border: 1px solid var(--accent-red); color: #991b1b; padding: var(--spacing-md); border-radius: var(--border-radius-md); margin-bottom: var(--spacing-lg); display: flex; align-items: center; gap: var(--spacing-sm);">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <form asp-action="Login" method="post">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-user" style="margin-right: var(--spacing-xs); color: var(--text-secondary);"></i>
                            Usuario o Correo electrónico
                        </label>
                        <input type="text" 
                               name="email" 
                               class="form-control" 
                               placeholder="Ingresa tu usuario o email"
                               required 
                               autofocus
                               style="padding-left: var(--spacing-md);" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-lock" style="margin-right: var(--spacing-xs); color: var(--text-secondary);"></i>
                            Contraseña
                        </label>
                        <input type="password" 
                               name="password" 
                               class="form-control" 
                               placeholder="••••••••"
                               required 
                               style="padding-left: var(--spacing-md);" />
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg" style="width: 100%; margin-top: var(--spacing-md);">
                        <i class="fas fa-sign-in-alt" style="margin-right: var(--spacing-sm);"></i>
                        Iniciar Sesión
                    </button>

                    <div style="text-align: center; margin-top: var(--spacing-md);">
                        <a asp-action="RecuperarPassword" style="color: var(--text-secondary); font-size: 0.875rem; text-decoration: none;">
                            <i class="fas fa-key" style="margin-right: 0.25rem;"></i>
                            ¿Olvidó su contraseña?
                        </a>
                    </div>
                </form>

                <!-- Info adicional -->
                <div style="margin-top: var(--spacing-xl); padding-top: var(--spacing-lg); border-top: 1px solid var(--border-color); text-align: center;">
                    <p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: var(--spacing-sm);">
                        <i class="fas fa-shield-alt" style="margin-right: var(--spacing-xs);"></i>
                        Acceso seguro y protegido
                    </p>
                    <div style="display: flex; gap: var(--spacing-md); justify-content: center; margin-top: var(--spacing-md); flex-wrap: wrap;">
                        <span style="color: #1e40af; font-weight: 700; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                            <i class="fas fa-users" style="font-size: 0.75rem;"></i>
                            Multi-usuario
                        </span>
                        <span style="color: #15803d; font-weight: 700; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                            <i class="fas fa-lock" style="font-size: 0.75rem;"></i>
                            Seguro
                        </span>
                        <span style="color: #1e40af; font-weight: 700; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                            <i class="fas fa-cloud" style="font-size: 0.75rem;"></i>
                            Cloud Ready
                        </span>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div style="padding: var(--spacing-lg); background-color: var(--bg-light); border-top: 1px solid var(--border-color); text-align: center; border-bottom-left-radius: var(--border-radius-lg); border-bottom-right-radius: var(--border-radius-lg);">
                <p style="color: var(--text-secondary); font-size: 0.875rem; margin: 0;">
                    © 2025 AutoSys - Sistema de Gestión de Taller
                </p>
            </div>
        </div>
    </div>
    
    <script src="~/lib/darkreader/darkreader.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
