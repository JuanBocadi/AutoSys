@model AutoSys.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoSys</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <!-- Theme Toggle Button - Floating -->
    <button id="themeToggle" class="theme-toggle-floating" title="Cambiar tema">
        <i class="fas fa-moon" id="themeIcon"></i>
    </button>
    
    <div class="login-container">
        <div class="card" style="width: 100%; max-width: 450px; margin: var(--spacing-xl);">
            <!-- Header con logo y título -->
            <div style="padding: var(--spacing-2xl); text-align: center; border-bottom: 1px solid var(--border-color);">
                <div style="width: 64px; height: 64px; background: linear-gradient(135deg, var(--primary-blue) 0%, var(--accent-purple) 100%); border-radius: var(--border-radius-lg); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--spacing-lg); box-shadow: var(--shadow-lg);">
                    <i class="fas fa-car" style="font-size: 2rem; color: white;"></i>
                </div>
                <h1 style="font-size: 1.875rem; font-weight: 700; color: var(--text-primary); margin-bottom: var(--spacing-sm);">
                    Bienvenido a AutoSys
                </h1>
                <p style="color: var(--text-secondary); font-size: 0.95rem;">
                    Sistema de Gestión de Taller Mecánico
                </p>
            </div>

            <!-- Formulario -->
            <div class="card-body" style="padding: var(--spacing-2xl);">
                @if (ViewBag.Error != null)
                {
                    <div style="background-color: #fee2e2; border: 1px solid var(--accent-red); color: #991b1b; padding: var(--spacing-md); border-radius: var(--border-radius-md); margin-bottom: var(--spacing-lg); display: flex; align-items: center; gap: var(--spacing-sm);">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <form asp-action="Login" method="post">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-user" style="margin-right: var(--spacing-xs); color: var(--text-secondary);"></i>
                            Usuario o Correo electrónico
                        </label>
                        <input type="text" 
                               name="email" 
                               class="form-control" 
                               placeholder="Ingresa tu usuario o email"
                               required 
                               autofocus
                               style="padding-left: var(--spacing-md);" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-lock" style="margin-right: var(--spacing-xs); color: var(--text-secondary);"></i>
                            Contraseña
                        </label>
                        <input type="password" 
                               name="password" 
                               class="form-control" 
                               placeholder="••••••••"
                               required 
                               style="padding-left: var(--spacing-md);" />
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg" style="width: 100%; margin-top: var(--spacing-md);">
                        <i class="fas fa-sign-in-alt" style="margin-right: var(--spacing-sm);"></i>
                        Iniciar Sesión
                    </button>
                </form>

                <!-- Info adicional -->
                <div style="margin-top: var(--spacing-xl); padding-top: var(--spacing-lg); border-top: 1px solid var(--border-color); text-align: center;">
                    <p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: var(--spacing-sm);">
                        <i class="fas fa-shield-alt" style="margin-right: var(--spacing-xs);"></i>
                        Acceso seguro y protegido
                    </p>
                    <div style="display: flex; gap: var(--spacing-md); justify-content: center; margin-top: var(--spacing-md); flex-wrap: wrap;">
                        <span style="color: #1e40af; font-weight: 700; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                            <i class="fas fa-users" style="font-size: 0.75rem;"></i>
                            Multi-usuario
                        </span>
                        <span style="color: #15803d; font-weight: 700; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                            <i class="fas fa-lock" style="font-size: 0.75rem;"></i>
                            Seguro
                        </span>
                        <span style="color: #1e40af; font-weight: 700; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                            <i class="fas fa-cloud" style="font-size: 0.75rem;"></i>
                            Cloud Ready
                        </span>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div style="padding: var(--spacing-lg); background-color: var(--bg-light); border-top: 1px solid var(--border-color); text-align: center; border-bottom-left-radius: var(--border-radius-lg); border-bottom-right-radius: var(--border-radius-lg);">
                <p style="color: var(--text-secondary); font-size: 0.875rem; margin: 0;">
                    © 2025 AutoSys - Sistema de Gestión de Taller
                </p>
            </div>
        </div>
    </div>
    
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
