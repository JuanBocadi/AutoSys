@{
    ViewData["Title"] = "Cambiar Contraseña";
    ViewData["Breadcrumb"] = "Cambiar Contraseña";
}

<div style="max-width: 550px; margin: 0 auto;">
    <div style="margin-bottom: 2rem;">
        <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
            <i class="fas fa-key" style="margin-right: 0.5rem; color: #f59e0b;"></i>
            Cambiar Contraseña
        </h1>
        <p style="color: var(--muted-foreground); margin: 0;">
            Actualice su contraseña de acceso al sistema
        </p>
    </div>

    <div class="card">
        <div class="card-body" style="padding: 2rem;">
            @if (ViewBag.Error != null)
            {
                <div style="background-color: #fee2e2; border: 1px solid #fca5a5; color: #991b1b; padding: 0.75rem 1rem; border-radius: var(--border-radius-md); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem;">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <form asp-action="CambiarPassword" method="post">
                @Html.AntiForgeryToken()

                <!-- Contraseña Actual -->
                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label class="form-label" style="font-weight: 600;">
                        <i class="fas fa-lock" style="margin-right: 0.25rem; color: var(--text-secondary);"></i>
                        Contraseña actual
                    </label>
                    <input type="password" name="passwordActual" class="form-control"
                           placeholder="Ingrese su contraseña actual" required autofocus />
                </div>

                <hr style="margin: 1.5rem 0; border-color: var(--border-color);" />

                <!-- Nueva Contraseña -->
                <div class="form-group" style="margin-bottom: 1.25rem;">
                    <label class="form-label" style="font-weight: 600;">
                        <i class="fas fa-lock" style="margin-right: 0.25rem; color: var(--text-secondary);"></i>
                        Nueva contraseña
                    </label>
                    <input type="password" name="nuevaPassword" id="nuevaPassword" class="form-control"
                           placeholder="Mínimo 8 caracteres" required minlength="8" />
                    <small style="color: var(--text-secondary); font-size: 0.75rem;">
                        Debe contener: mayúscula, minúscula, número y carácter especial.
                    </small>
                </div>

                <!-- Confirmar Nueva Contraseña -->
                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label class="form-label" style="font-weight: 600;">
                        <i class="fas fa-check-circle" style="margin-right: 0.25rem; color: var(--text-secondary);"></i>
                        Confirmar nueva contraseña
                    </label>
                    <input type="password" name="confirmarPassword" id="confirmarPassword" class="form-control"
                           placeholder="Repita la nueva contraseña" required minlength="8" />
                </div>

                <!-- Indicador de fortaleza -->
                <div id="strengthIndicator" style="margin-bottom: 1.5rem; display: none;">
                    <div style="display: flex; gap: 0.25rem; margin-bottom: 0.25rem;">
                        <div id="bar1" style="height: 4px; flex: 1; border-radius: 2px; background: #e5e7eb;"></div>
                        <div id="bar2" style="height: 4px; flex: 1; border-radius: 2px; background: #e5e7eb;"></div>
                        <div id="bar3" style="height: 4px; flex: 1; border-radius: 2px; background: #e5e7eb;"></div>
                        <div id="bar4" style="height: 4px; flex: 1; border-radius: 2px; background: #e5e7eb;"></div>
                    </div>
                    <small id="strengthText" style="font-size: 0.75rem;"></small>
                </div>

                <div style="display: flex; gap: 0.75rem;">
                    <button type="submit" class="btn btn-primary" style="flex: 1;">
                        <i class="fas fa-save" style="margin-right: 0.5rem;"></i>
                        Cambiar Contraseña
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="btn" 
                       style="background: var(--bg-light); border: 1px solid var(--border-color); color: var(--text-primary);">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Sugerencias de seguridad -->
    <div class="card" style="margin-top: 1rem;">
        <div class="card-body" style="padding: 1.25rem;">
            <h6 style="font-weight: 600; margin-bottom: 0.75rem;">
                <i class="fas fa-info-circle" style="color: #3b82f6; margin-right: 0.25rem;"></i>
                Recomendaciones de seguridad
            </h6>
            <ul style="margin: 0; padding-left: 1.25rem; color: var(--text-secondary); font-size: 0.875rem;">
                <li>No use la misma contraseña que en otros servicios</li>
                <li>Combine letras mayúsculas, minúsculas, números y símbolos</li>
                <li>Evite datos personales (nombre, fecha de nacimiento)</li>
                <li>Cambie su contraseña periódicamente</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('nuevaPassword').addEventListener('input', function() {
        var pw = this.value;
        var indicator = document.getElementById('strengthIndicator');
        var bars = [document.getElementById('bar1'), document.getElementById('bar2'), 
                    document.getElementById('bar3'), document.getElementById('bar4')];
        var text = document.getElementById('strengthText');
        
        if (pw.length === 0) { indicator.style.display = 'none'; return; }
        indicator.style.display = 'block';
        
        var score = 0;
        if (pw.length >= 8) score++;
        if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) score++;
        if (/\d/.test(pw)) score++;
        if (/[^A-Za-z0-9]/.test(pw)) score++;
        
        var colors = ['#ef4444', '#f59e0b', '#3b82f6', '#10b981'];
        var labels = ['Débil', 'Regular', 'Buena', 'Fuerte'];
        
        bars.forEach(function(bar, i) {
            bar.style.background = i < score ? colors[score - 1] : '#e5e7eb';
        });
        text.textContent = labels[score - 1] || 'Muy débil';
        text.style.color = colors[score - 1] || '#ef4444';
    });
</script>
}
