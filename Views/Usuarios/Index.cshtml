@model List<AutoSys.ViewModels.UsuarioViewModel>
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="mt-4">
    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
            <h2 class="mb-0">
                <i class="fas fa-user-cog me-2"></i> Usuarios Registrados
            </h2>
            <a class="btn btn-light" asp-controller="Account" asp-action="Register">
                <i class="fas fa-user-plus me-2"></i>Registrar Nuevo Usuario
            </a>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Correo Electrónico</th>
                            <th>Rol</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Email</td>
                                <td><span class="badge bg-secondary">@user.Rol</span></td>
                                <td class="text-center">
                                    <button class="btn btn-outline-primary btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#userModal"
                                            data-userid="@user.Id">
                                        <i class="fas fa-eye me-1"></i> Ver Detalles
                                    </button>
                                    <form asp-action="Delete" asp-controller="Usuarios" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que desea eliminar este usuario?');">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="fas fa-trash-alt me-1"></i> Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- =============================================== -->
<!-- MODAL (POPUP) PARA DETALLES DE USUARIO          -->
<!-- =============================================== -->
<div class="modal fade" id="userModal" tabindex="-1" aria-labelledby="userModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userModalLabel"><i class="fas fa-user-circle me-2"></i>Detalles del Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- El contenido se cargará aquí con JavaScript -->
                <div id="modal-content-placeholder" class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2">Cargando información...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
<script>
    $(document).ready(function () {
        // Obtenemos la referencia al modal
        var userModal = document.getElementById('userModal');

        // Escuchamos el evento que se dispara JUSTO ANTES de que el modal se muestre
        userModal.addEventListener('show.bs.modal', function (event) {
            
            // Identificamos el botón que activó el modal
            var button = event.relatedTarget;
            
            // Extraemos el ID del usuario del atributo data-userid del botón
            var userId = button.getAttribute('data-userid');

            var modalBody = $('#modal-content-placeholder');
            
            // Mostramos el spinner de "Cargando..." mientras hacemos la petición
            modalBody.html('<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div><p class="mt-2">Cargando información...</p></div>');

            // Hacemos una llamada AJAX para obtener los detalles del usuario
            $.ajax({
                url: '/Usuarios/GetUserDetails?id=' + userId,
                type: 'GET',
                success: function (data) {
                    // Si la llamada es exitosa, construimos el HTML con los datos
                    var content = '<dl class="row">' +
                                  '<dt class="col-sm-3">Email</dt>' +
                                  '<dd class="col-sm-9">' + data.email + '</dd>' +
                                  '<dt class="col-sm-3">Rol</dt>' +
                                  '<dd class="col-sm-9"><span class="badge bg-primary">' + data.rol + '</span></dd>' +
                                  '</dl>';
                    // Reemplazamos el spinner con el contenido final
                    modalBody.html(content);
                },
                error: function () {
                    // Si hay un error, mostramos un mensaje
                    modalBody.html('<div class="alert alert-danger">No se pudo cargar la información del usuario.</div>');
                }
            });
        });
    });
</script>
}