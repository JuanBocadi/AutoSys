@model List<AutoSys.ViewModels.UsuarioViewModel>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-user-cog" style="margin-right: 0.5rem; color: #6366f1;"></i>
                Gestión de Usuarios
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">Administración de usuarios del sistema</p>
        </div>
        <div style="display: flex; gap: 0.75rem;">
            <a asp-controller="Usuarios" asp-action="GrupoPermisos"
               class="btn"
               style="background: #f3f0ff; color: #6366f1; border: 1px solid #c4b5fd; font-weight: 600;">
                <i class="fas fa-users-cog"></i> Permisos de Grupos
            </a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary">
                <i class="fas fa-user-plus"></i> Registrar Usuario
            </a>
        </div>
    </div>
</div>

<!-- Stats Card -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #e0e7ff; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-users" style="color: #6366f1;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Total Usuarios</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@Model.Count()</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #fef3c7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-user-shield" style="color: #f59e0b;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Administradores</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@Model.Count(u => u.Rol == "Administrador")</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #dbeafe; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-user-tie" style="color: #3b82f6;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Recepcionistas</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@Model.Count(u => u.Rol == "Recepcionista")</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #dcfce7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-tools" style="color: #10b981;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Mecánicos</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@Model.Count(u => u.Rol == "Mecanico")</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Correo Electrónico</th>
                        <th>Rol</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: 0.75rem;">
                                    <div style="width: 2.5rem; height: 2.5rem; background: #f4f4f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; color: #71717a;">
                                        @user.UserName?.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div style="font-weight: 600;">@user.UserName</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <i class="fas fa-envelope" style="color: var(--muted-foreground); font-size: 0.875rem;"></i>
                                    <span>@user.Email</span>
                                </div>
                            </td>
                            <td>
                                @{
                                    var rolColor = user.Rol switch
                                    {
                                        "Administrador" => "#b45309",
                                        "Recepcionista" => "#1e40af",
                                        "Mecanico" => "#15803d",
                                        _ => "#4b5563"
                                    };
                                }
                                <span style="color: @rolColor; font-weight: 700; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.875rem;">
                                    @if (user.Rol == "Administrador") { <i class="fas fa-user-shield"></i> }
                                    else if (user.Rol == "Recepcionista") { <i class="fas fa-user-tie"></i> }
                                    else if (user.Rol == "Mecanico") { <i class="fas fa-tools"></i> }
                                    @user.Rol
                                </span>
                            </td>
                            <td style="text-align: right;">
                                <button class="btn btn-sm btn-secondary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#userModal"
                                        data-userid="@user.Id"
                                        data-username="@user.UserName"
                                        data-email="@user.Email"
                                        data-rol="@user.Rol">
                                    <i class="fas fa-eye"></i> Ver Detalles
                                </button>
                                <button class="btn btn-sm"
                                        style="background: #e0e7ff; color: #6366f1; border: none;"
                                        onclick="abrirVerificacion('@user.Id', '@user.UserName')"
                                        title="Gestionar permisos de @user.UserName">
                                    <i class="fas fa-shield-alt"></i> Permisos
                                </button>
                                <button class="btn btn-sm"
                                        style="background: #fef3c7; color: #92400e; border: 1px solid #fde68a;"
                                        onclick="abrirResetPassword('@user.Id', '@user.UserName')"
                                        title="Restablecer contraseña de @user.UserName">
                                    <i class="fas fa-key"></i> Contraseña
                                </button>
                                <form asp-action="Delete"
                                      asp-controller="Usuarios"
                                      method="post"
                                      style="display: inline;"
                                      onsubmit="return confirm('¿Seguro que desea eliminar este usuario?');">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash-alt"></i> Eliminar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ===== Modal verificación de contraseña ===== -->
<div class="modal fade" id="modalVerificarPassword" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content" style="border: none; border-radius: var(--radius);">
            <div class="modal-header" style="border-bottom: 1px solid var(--border); padding: 1.5rem;">
                <h5 class="modal-title" style="font-weight: 700; display: flex; align-items: center; gap: 0.5rem;">
                    <i class="fas fa-lock" style="color: #6366f1;"></i>
                    Verificar Identidad
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: 1.5rem;">
                <div style="text-align: center; margin-bottom: 1.5rem;">
                    <div style="width: 4rem; height: 4rem; background: #e0e7ff; border-radius: 50%;
                                display: flex; align-items: center; justify-content: center;
                                margin: 0 auto 0.75rem;">
                        <i class="fas fa-user-shield" style="color: #6366f1; font-size: 1.5rem;"></i>
                    </div>
                    <p style="color: var(--muted-foreground); font-size: 0.9rem; margin: 0;">
                        Para gestionar los permisos de
                        <strong id="verif-username"></strong>,
                        confirme su contraseña de administrador.
                    </p>
                </div>

                <div id="verif-error" class="alert alert-danger" style="display: none; font-size: 0.875rem;"></div>

                <div style="margin-bottom: 1rem;">
                    <label style="font-size: 0.875rem; font-weight: 600; margin-bottom: 0.4rem; display: block;">
                        <i class="fas fa-key me-1" style="color: var(--muted-foreground);"></i>
                        Contraseña
                    </label>
                    <input type="password" id="verif-password"
                           class="form-control"
                           placeholder="Ingrese su contraseña"
                           autocomplete="current-password" />
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--border); padding: 1rem 1.5rem;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btn-verificar" onclick="verificarPassword()">
                    <i class="fas fa-unlock me-1"></i>Verificar y continuar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para mostrar los detalles del usuario -->
<div class="modal fade" id="userModal" tabindex="-1" aria-labelledby="userModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border: none; border-radius: var(--radius);">
            <div class="modal-header" style="border-bottom: 1px solid var(--border); padding: 1.5rem;">
                <h5 class="modal-title" id="userModalLabel" style="font-weight: 700; font-size: 1.25rem;">
                    <i class="fas fa-user-circle" style="margin-right: 0.5rem; color: #6366f1;"></i>
                    Detalles del Usuario
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" style="padding: 1.5rem;">
                <!-- Contenedor donde se cargan los datos del usuario -->
                <div id="modal-content-placeholder" class="text-center">
                    <div style="padding: 2rem;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <p style="margin-top: 1rem; color: var(--muted-foreground);">Cargando información...</p>
                    </div>
                </div>
            </div>

            <div class="modal-footer" style="border-top: 1px solid var(--border); padding: 1rem 1.5rem;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cerrar
                </button>
                <button type="button" class="btn btn-sm"
                        id="modal-btn-reset-pw"
                        style="background: #fef3c7; color: #92400e; border: 1px solid #fde68a;"
                        onclick="abrirResetDesdeModal()">
                    <i class="fas fa-key me-1"></i>Cambiar contraseña
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ===== Modal restablecer contraseña ===== -->
<div class="modal fade" id="modalResetPassword" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 460px;">
        <div class="modal-content" style="border: none; border-radius: var(--radius);">
            <div class="modal-header" style="border-bottom: 1px solid var(--border); padding: 1.5rem;
                                             background: #fffbeb;">
                <h5 class="modal-title" style="font-weight: 700; display: flex; align-items: center; gap: 0.5rem;">
                    <i class="fas fa-key" style="color: #92400e;"></i>
                    Restablecer Contraseña
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="RestablecerPassword" asp-controller="Usuarios" method="post"
                  id="formResetPassword" onsubmit="return validarResetPassword()">
                @Html.AntiForgeryToken()
                <input type="hidden" id="reset-userId" name="userId" />

                <div class="modal-body" style="padding: 1.5rem;">
                    <div style="text-align: center; margin-bottom: 1.25rem;">
                        <div style="width: 3.5rem; height: 3.5rem; background: #fef3c7; border-radius: 50%;
                                    display: flex; align-items: center; justify-content: center;
                                    margin: 0 auto 0.6rem;">
                            <i class="fas fa-user-lock" style="color: #92400e; font-size: 1.25rem;"></i>
                        </div>
                        <p style="margin: 0; color: var(--muted-foreground); font-size: 0.875rem;">
                            Nueva contraseña para <strong id="reset-username"></strong>
                        </p>
                    </div>

                    <div id="reset-error" class="alert alert-danger" style="display:none; font-size:0.875rem;"></div>

                    <div style="margin-bottom: 1rem;">
                        <label class="form-label" style="font-size:0.875rem; font-weight:600;">
                            <i class="fas fa-lock me-1" style="color:var(--muted-foreground);"></i>
                            Nueva Contraseña
                        </label>
                        <input type="password" id="reset-nueva" name="nuevaPassword"
                               class="form-control" placeholder="Mínimo 6 caracteres"
                               autocomplete="new-password" required minlength="6" />
                    </div>
                    <div>
                        <label class="form-label" style="font-size:0.875rem; font-weight:600;">
                            <i class="fas fa-lock me-1" style="color:var(--muted-foreground);"></i>
                            Confirmar Contraseña
                        </label>
                        <input type="password" id="reset-confirmar" name="confirmarPassword"
                               class="form-control" placeholder="Repetir contraseña"
                               autocomplete="new-password" required minlength="6" />
                    </div>

                    <div style="margin-top: 1rem; padding: 0.75rem; background: #fff7ed;
                                border: 1px solid #fed7aa; border-radius: var(--radius);
                                font-size: 0.8rem; color: #9a3412;">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        El usuario deberá usar la nueva contraseña en su próximo inicio de sesión.
                    </div>
                </div>

                <div class="modal-footer" style="border-top: 1px solid var(--border); padding: 1rem 1.5rem;">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i>Cancelar
                    </button>
                    <button type="submit" class="btn"
                            style="background: #92400e; color: white; border: none;">
                        <i class="fas fa-key me-1"></i>Confirmar Restablecimiento
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Variables para la verificación ──
    var _targetUserId = '';
    var _modalUserId = '';       // para poder abrir reset desde el modal de detalles
    var _modalUserName = '';

    function abrirResetPassword(userId, userName) {
        document.getElementById('reset-userId').value    = userId;
        document.getElementById('reset-username').textContent = userName;
        document.getElementById('reset-nueva').value     = '';
        document.getElementById('reset-confirmar').value = '';
        document.getElementById('reset-error').style.display = 'none';
        var modal = new bootstrap.Modal(document.getElementById('modalResetPassword'));
        modal.show();
        document.getElementById('modalResetPassword').addEventListener('shown.bs.modal', function() {
            document.getElementById('reset-nueva').focus();
        }, { once: true });
    }

    function abrirResetDesdeModal() {
        // Cierra el modal de detalles y abre el de reset
        var detailModal = bootstrap.Modal.getInstance(document.getElementById('userModal'));
        if (detailModal) detailModal.hide();
        document.getElementById('userModal').addEventListener('hidden.bs.modal', function() {
            abrirResetPassword(_modalUserId, _modalUserName);
        }, { once: true });
    }

    function validarResetPassword() {
        var nueva     = document.getElementById('reset-nueva').value;
        var confirmar = document.getElementById('reset-confirmar').value;
        var errDiv    = document.getElementById('reset-error');
        if (nueva.length < 6) {
            errDiv.textContent = 'La contraseña debe tener al menos 6 caracteres.';
            errDiv.style.display = 'block';
            return false;
        }
        if (nueva !== confirmar) {
            errDiv.textContent = 'Las contraseñas no coinciden.';
            errDiv.style.display = 'block';
            return false;
        }
        return confirm('¿Confirma el restablecimiento de contraseña para ' + document.getElementById('reset-username').textContent + '?');
    }

    function abrirVerificacion(userId, userName) {
        _targetUserId = userId;
        document.getElementById('verif-username').textContent = userName;
        document.getElementById('verif-password').value = '';
        document.getElementById('verif-error').style.display = 'none';
        document.getElementById('btn-verificar').disabled = false;
        document.getElementById('btn-verificar').innerHTML = '<i class="fas fa-unlock me-1"></i>Verificar y continuar';

        var modal = new bootstrap.Modal(document.getElementById('modalVerificarPassword'));
        modal.show();

        // Focus en el input al abrirse
        document.getElementById('modalVerificarPassword').addEventListener('shown.bs.modal', function () {
            document.getElementById('verif-password').focus();
        }, { once: true });
    }

    // Enter en el campo de contraseña = verificar
    document.getElementById('verif-password').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') verificarPassword();
    });

    function verificarPassword() {
        var password = document.getElementById('verif-password').value;
        var errorDiv = document.getElementById('verif-error');
        var btn = document.getElementById('btn-verificar');

        if (!password) {
            errorDiv.textContent = 'Debe ingresar su contraseña.';
            errorDiv.style.display = 'block';
            return;
        }

        // Deshabilitar botón mientras procesa
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Verificando...';
        errorDiv.style.display = 'none';

        // Obtener el token antiforgery
        var token = document.querySelector('input[name="__RequestVerificationToken"]');
        var tokenValue = token ? token.value : '';

        fetch('/Usuarios/VerificarPassword', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': tokenValue
            },
            body: JSON.stringify({ password: password })
        })
        .then(function (response) { return response.json(); })
        .then(function (data) {
            if (data.success) {
                // Contraseña correcta: redirigir a la página de permisos
                btn.innerHTML = '<i class="fas fa-check me-1"></i>Acceso concedido...';
                window.location.href = '/Usuarios/Permisos/' + _targetUserId;
            } else {
                errorDiv.textContent = data.mensaje || 'Contraseña incorrecta.';
                errorDiv.style.display = 'block';
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-unlock me-1"></i>Verificar y continuar';
                document.getElementById('verif-password').value = '';
                document.getElementById('verif-password').focus();
            }
        })
        .catch(function () {
            errorDiv.textContent = 'Error de conexión. Intente nuevamente.';
            errorDiv.style.display = 'block';
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-unlock me-1"></i>Verificar y continuar';
        });
    }

    // ── Modal detalles de usuario (existente) ──
    document.addEventListener('DOMContentLoaded', function () {
        var userModal = document.getElementById('userModal');

        userModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var userId = button.getAttribute('data-userid');
            var userName = button.getAttribute('data-username');
            var email = button.getAttribute('data-email');
            var rol = button.getAttribute('data-rol');

            // Guardar para abrirResetDesdeModal()
            _modalUserId   = userId;
            _modalUserName = userName;

            var modalBody = document.getElementById('modal-content-placeholder');

            var rolColor = '#4b5563';
            var rolIcon = 'fa-user';
            if (rol === 'Administrador') { rolColor = '#b45309'; rolIcon = 'fa-user-shield'; }
            else if (rol === 'Recepcionista') { rolColor = '#1e40af'; rolIcon = 'fa-user-tie'; }
            else if (rol === 'Mecanico') { rolColor = '#15803d'; rolIcon = 'fa-tools'; }

            var content =
                '<div style="display: flex; flex-direction: column; gap: 1.5rem;">' +
                    '<div style="text-align: center; padding-bottom: 1rem; border-bottom: 1px solid var(--border);">' +
                        '<div style="width: 5rem; height: 5rem; background: #e0e7ff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 2rem; color: #6366f1; margin: 0 auto 1rem;">' +
                            userName.substring(0, 1).toUpperCase() +
                        '</div>' +
                        '<h4 style="font-weight: 700; margin: 0;">' + userName + '</h4>' +
                    '</div>' +
                    '<div style="display: flex; flex-direction: column; gap: 1rem;">' +
                        '<div style="padding: 1rem; background: #f9fafb; border-radius: var(--radius);">' +
                            '<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">' +
                                '<i class="fas fa-envelope" style="color: var(--muted-foreground);"></i>' +
                                '<span style="font-size: 0.875rem; font-weight: 600; color: var(--muted-foreground);">Correo Electrónico</span>' +
                            '</div>' +
                            '<p style="margin: 0; font-weight: 500;">' + email + '</p>' +
                        '</div>' +
                        '<div style="padding: 1rem; background: #f9fafb; border-radius: var(--radius);">' +
                            '<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">' +
                                '<i class="fas ' + rolIcon + '" style="color: var(--muted-foreground);"></i>' +
                                '<span style="font-size: 0.875rem; font-weight: 600; color: var(--muted-foreground);">Rol en el Sistema</span>' +
                            '</div>' +
                            '<span style="color: ' + rolColor + '; font-weight: 700; display: inline-flex; align-items: center; gap: 0.5rem; font-size: 1rem;">' +
                                '<i class="fas ' + rolIcon + '"></i> ' + rol +
                            '</span>' +
                        '</div>' +
                        '<div style="padding: 1rem; background: #f9fafb; border-radius: var(--radius);">' +
                            '<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">' +
                                '<i class="fas fa-id-card" style="color: var(--muted-foreground);"></i>' +
                                '<span style="font-size: 0.875rem; font-weight: 600; color: var(--muted-foreground);">ID de Usuario</span>' +
                            '</div>' +
                            '<code style="font-size: 0.75rem; color: var(--muted-foreground); word-break: break-all;">' + userId + '</code>' +
                        '</div>' +
                    '</div>' +
                '</div>';

            modalBody.innerHTML = content;
        });
    });
</script>
}
