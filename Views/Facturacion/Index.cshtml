@model IEnumerable<AutoSys.Models.Factura>
@{
    ViewData["Title"] = "Facturación";
}

<div class="mt-4">
    <div class="card shadow-lg border-0 rounded-lg mb-4">
        <div class="card-header bg-success text-white py-3">
            <h2 class="mb-0"><i class="fas fa-file-invoice-dollar me-2"></i>Gestión de Facturación</h2>
        </div>
    </div>

    <!-- Estadísticas -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-primary">@ViewBag.TotalFacturas</h3>
                    <p class="mb-0"><i class="fas fa-file-invoice me-1"></i>Total Facturas</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-warning">@ViewBag.FacturasPendientes</h3>
                    <p class="mb-0"><i class="fas fa-clock me-1"></i>Pendientes</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-success">@ViewBag.FacturasPagadas</h3>
                    <p class="mb-0"><i class="fas fa-check-circle me-1"></i>Pagadas</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-info">$@ViewBag.TotalRecaudado.ToString("N2")</h3>
                    <p class="mb-0"><i class="fas fa-dollar-sign me-1"></i>Recaudado</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros y acciones -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-4">
                        <input type="text" name="buscar" class="form-control" 
                               placeholder="Buscar por número o cliente..." 
                               value="@ViewBag.Buscar">
                    </div>
                    <div class="col-md-3">
                        <select name="estado" class="form-select">
                            <option value="">Todos los estados</option>
                            <option value="Pendiente" selected="@(ViewBag.EstadoFiltro == "Pendiente")">Pendientes</option>
                            <option value="Pagada" selected="@(ViewBag.EstadoFiltro == "Pagada")">Pagadas</option>
                            <option value="Anulada" selected="@(ViewBag.EstadoFiltro == "Anulada")">Anuladas</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search me-1"></i>Buscar
                        </button>
                    </div>
                    <div class="col-md-2">
                        <a asp-action="Create" class="btn btn-success w-100">
                            <i class="fas fa-plus me-1"></i>Nueva Factura
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de facturas -->
    <div class="card shadow-lg">
        <div class="card-header bg-secondary text-white py-3">
            <h3 class="mb-0"><i class="fas fa-list me-2"></i>Listado de Facturas</h3>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Número</th>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th>Vehículo</th>
                                <th class="text-end">Total</th>
                                <th>Estado</th>
                                <th>Método Pago</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var factura in Model)
                            {
                                <tr>
                                    <td><strong>@factura.NumeroFactura</strong></td>
                                    <td>@factura.FechaEmision.ToString("dd/MM/yyyy")</td>
                                    <td>@factura.Cliente?.Nombre @factura.Cliente?.Apellido</td>
                                    <td>@factura.Ingreso?.Vehiculo?.Patente</td>
                                    <td class="text-end"><strong>$@factura.Total.ToString("N2")</strong></td>
                                    <td>
                                        @if (factura.Estado == "Pagada")
                                        {
                                            <span class="badge bg-success">@factura.Estado</span>
                                        }
                                        else if (factura.Estado == "Pendiente")
                                        {
                                            <span class="badge bg-warning text-dark">@factura.Estado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@factura.Estado</span>
                                        }
                                    </td>
                                    <td>@(factura.MetodoPago ?? "-")</td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <a asp-action="Detalle" asp-route-id="@factura.Id" 
                                               class="btn btn-sm btn-info" title="Ver detalle">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Imprimir" asp-route-id="@factura.Id" 
                                               class="btn btn-sm btn-primary" title="Imprimir" target="_blank">
                                                <i class="fas fa-print"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i>
                    No hay facturas registradas. 
                    <a asp-action="Create" class="alert-link">Crear la primera factura</a>
                </div>
            }
        </div>
    </div>
</div>