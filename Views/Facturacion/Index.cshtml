@model IEnumerable<AutoSys.Models.Factura>
@{
    ViewData["Title"] = "Facturación";
    var _u = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
    var _rol = User.IsInRole("Administrador") ? "Administrador" : User.IsInRole("Recepcionista") ? "Recepcionista" : "Mecanico";
    var _p = User.IsInRole("Administrador")
        ? PermissionService.GetDefaultsByRole("Administrador", _u)
        : await PermissionService.ObtenerPermisosEfectivosAsync(_u, _rol);
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-file-invoice-dollar" style="margin-right: 0.5rem; color: #10b981;"></i>
                Facturación
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">Gestión de facturas y cobros</p>
        </div>
        @if (_p.CrearFacturas)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Nueva Factura
            </a>
        }
    </div>
</div>

<!-- Stats Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #dbeafe; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-file-invoice" style="color: #3b82f6;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Total Facturas</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@ViewBag.TotalFacturas</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #fef3c7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-clock" style="color: #f59e0b;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Pendientes</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@ViewBag.FacturasPendientes</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #dcfce7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-check-circle" style="color: #10b981;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Pagadas</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@ViewBag.FacturasPagadas</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #dcfce7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-dollar-sign" style="color: #10b981;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Recaudado</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">$@ViewBag.TotalRecaudado.ToString("N2")</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 0.75rem;">
                <div style="position: relative;">
                    <input type="text" name="buscar" class="form-control" 
                           placeholder="Buscar por número o cliente..." 
                           value="@ViewBag.Buscar"
                           style="padding-left: 2.5rem;">
                    <i class="fas fa-search" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--muted-foreground);"></i>
                </div>
                <select name="estado" class="form-select">
                    <option value="">Todos los estados</option>
                    <option value="Pendiente" selected="@(ViewBag.EstadoFiltro == "Pendiente")">Pendientes</option>
                    <option value="Pagada" selected="@(ViewBag.EstadoFiltro == "Pagada")">Pagadas</option>
                    <option value="Anulada" selected="@(ViewBag.EstadoFiltro == "Anulada")">Anuladas</option>
                </select>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Buscar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-body" style="padding: 0;">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Número Factura</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th style="text-align: right;">Subtotal</th>
                            <th style="text-align: right;">IVA</th>
                            <th style="text-align: right;">Total</th>
                            <th>Estado</th>
                            <th style="text-align: right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var factura in Model)
                        {
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <div style="width: 2.5rem; height: 2.5rem; background: #dcfce7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-file-invoice" style="color: #10b981;"></i>
                                        </div>
                                        <div>
                                            <div style="font-weight: 600; font-family: monospace;">@factura.NumeroFactura</div>
                                            <div style="font-size: 0.75rem; color: var(--muted-foreground);">
                                                @factura.Ingreso?.Vehiculo?.Patente
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <div style="font-weight: 600;">@factura.Cliente?.Nombre @factura.Cliente?.Apellido</div>
                                        <div style="font-size: 0.875rem; color: var(--muted-foreground);">
                                            @if (!string.IsNullOrEmpty(factura.Cliente?.Telefono))
                                            {
                                                <i class="fas fa-phone"></i>
                                                <span>@factura.Cliente?.Telefono</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="font-size: 0.875rem;">@factura.FechaEmision.ToString("dd/MM/yyyy")</div>
                                    <div style="font-size: 0.75rem; color: var(--muted-foreground);">@factura.FechaEmision.ToString("HH:mm")</div>
                                </td>
                                <td style="text-align: right;">
                                    <span style="font-family: monospace;">$@factura.Subtotal.ToString("N2")</span>
                                </td>
                                <td style="text-align: right;">
                                    <span style="font-family: monospace; color: var(--muted-foreground);">$@factura.IVA.ToString("N2")</span>
                                </td>
                                <td style="text-align: right;">
                                    <span style="font-weight: 700; font-size: 1.125rem; font-family: monospace;">$@factura.Total.ToString("N2")</span>
                                </td>
                                <td>
                                    <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                        @if (factura.Estado == "Pagada")
                                        {
                                            <span style="color: #15803d; font-weight: 700; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.875rem;">
                                                <i class="fas fa-check-circle"></i> @factura.Estado
                                            </span>
                                        }
                                        else if (factura.Estado == "Pendiente")
                                        {
                                            <span style="color: #b45309; font-weight: 700; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.875rem;">
                                                <i class="fas fa-clock"></i> @factura.Estado
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color: #b91c1c; font-weight: 700; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.875rem;">
                                                <i class="fas fa-times-circle"></i> @factura.Estado
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(factura.MetodoPago))
                                        {
                                            <span style="color: #1e40af; font-weight: 600; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.75rem;">
                                                @if (factura.MetodoPago == "Efectivo")
                                                {
                                                    <i class="fas fa-money-bill"></i>
                                                }
                                                else if (factura.MetodoPago == "Tarjeta")
                                                {
                                                    <i class="fas fa-credit-card"></i>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-exchange-alt"></i>
                                                }
                                                @factura.MetodoPago
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td style="text-align: right;">
                                    <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                        <a asp-action="Detalle" asp-route-id="@factura.Id" 
                                           class="btn btn-sm btn-secondary" title="Ver detalle">
                                            <i class="fas fa-eye"></i> Ver
                                        </a>
                                        <a asp-action="Imprimir" asp-route-id="@factura.Id" 
                                           class="btn btn-sm btn-primary" title="Imprimir" target="_blank">
                                            <i class="fas fa-print"></i> Imprimir
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding: 3rem; text-align: center; color: var(--muted-foreground);">
                <i class="fas fa-file-invoice-dollar" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.3;"></i>
                <p style="margin-bottom: 1rem;">No hay facturas registradas</p>
                @if (_p.CrearFacturas)
                {
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Crear Primera Factura
                    </a>
                }
            </div>
        }
    </div>
</div>