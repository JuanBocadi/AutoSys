@model AutoSys.Models.Factura
@{
    ViewData["Title"] = "Nueva Factura";
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-file-invoice-dollar" style="margin-right: 0.5rem; color: #10b981;"></i>
                Nueva Factura
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">Complete los datos para generar una nueva factura</p>
        </div>
        <a asp-action="Index" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>
</div>

<!-- Formulario -->
<div class="card">
    <div class="card-body">
            <form asp-action="Create" method="post" id="facturaForm">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="ClienteId" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="NumeroFactura" class="form-label"></label>
                        <input asp-for="NumeroFactura" class="form-control" readonly />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="IngresoId" class="form-label">Ingreso/Reparación</label>
                        <select asp-for="IngresoId" class="form-select" asp-items="ViewBag.Ingresos" required>
                            <option value="">Seleccione un ingreso...</option>
                        </select>
                        <span asp-validation-for="IngresoId" class="text-danger"></span>
                    </div>
                </div>

                <h4 class="mt-4 mb-3">Detalles de la Factura</h4>
                <div id="detallesContainer">
                    @if (ViewBag.ServiciosPredefinidos != null)
                    {
                        var servicios = (IEnumerable<dynamic>)ViewBag.ServiciosPredefinidos;
                        int index = 0;
                        foreach (var s in servicios)
                        {
                            <div class="detalle-item card mb-3">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4 mb-2">
                                            <label>Descripción</label>
                                            <input type="text" name="detalles[@index].Descripcion" 
                                                   class="form-control" required 
                                                   value="@s.Nombre"
                                                   placeholder="Ej: Cambio de aceite">
                                        </div>
                                        <div class="col-md-2 mb-2">
                                            <label>Tipo</label>
                                            <select name="detalles[@index].Tipo" class="form-select">
                                                <option value="Servicio">Servicio</option>
                                                <option value="Repuesto">Repuesto</option>
                                            </select>
                                        </div>
                                        <div class="col-md-2 mb-2">
                                            <label>Cantidad</label>
                                            <input type="number" name="detalles[@index].Cantidad" 
                                                   class="form-control cantidad" min="1" value="1" required>
                                        </div>
                                        <div class="col-md-2 mb-2">
                                            <label>Precio Unit.</label>
                                            <input type="number" name="detalles[@index].PrecioUnitario" 
                                                   class="form-control precio" step="0.01" min="0" required
                                                   value="@(((decimal)s.Precio).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))">
                                        </div>
                                        <div class="col-md-2 mb-2">
                                            <label>Subtotal</label>
                                            <input type="number" name="detalles[@index].Subtotal" 
                                                   class="form-control subtotal" readonly value="0">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            index++;
                        }
                    }
                    else
                    {
                        <!-- Fallback si no hay nada (aunque el controlador asegura que haya) -->
                        <div class="detalle-item card mb-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4 mb-2">
                                        <label>Descripción</label>
                                        <input type="text" name="detalles[0].Descripcion" 
                                               class="form-control" required 
                                               placeholder="Ej: Cambio de aceite">
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <label>Tipo</label>
                                        <select name="detalles[0].Tipo" class="form-select">
                                            <option value="Servicio">Servicio</option>
                                            <option value="Repuesto">Repuesto</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <label>Cantidad</label>
                                        <input type="number" name="detalles[0].Cantidad" 
                                               class="form-control cantidad" min="1" value="1" required>
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <label>Precio Unit.</label>
                                        <input type="number" name="detalles[0].PrecioUnitario" 
                                               class="form-control precio" step="0.01" min="0" required>
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <label>Subtotal</label>
                                        <input type="number" name="detalles[0].Subtotal" 
                                               class="form-control subtotal" readonly value="0">
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <button type="button" class="btn btn-outline-primary mb-3" id="agregarDetalle">
                    <i class="fas fa-plus me-1"></i>Agregar Línea
                </button>

                <div class="card bg-light mb-3">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8"></div>
                            <div class="col-md-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <strong>Subtotal:</strong>
                                    <span id="subtotalTotal">$0.00</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <strong>IVA (21%):</strong>
                                    <span id="ivaTotal">$0.00</span>
                                </div>
                                <hr>
                                <div class="d-flex justify-content-between">
                                    <h4>Total:</h4>
                                    <h4 class="text-success" id="totalFinal">$0.00</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="MetodoPago" class="form-label"></label>
                        <select asp-for="MetodoPago" class="form-select">
                            <option value="">Seleccione...</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="Tarjeta">Tarjeta</option>
                            <option value="Transferencia">Transferencia</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Estado" class="form-label"></label>
                        <select asp-for="Estado" class="form-select">
                            <option value="Pendiente">Pendiente</option>
                            <option value="Pagada">Pagada</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Observaciones" class="form-label"></label>
                    <textarea asp-for="Observaciones" class="form-control" rows="2"></textarea>
                </div>

                <div style="margin-top: 2rem; display: flex; gap: 0.75rem; justify-content: flex-end;">
                    <a asp-action="Index" class="btn btn-outline">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <i class="fas fa-save me-2"></i>Crear Factura
                    </button>
                </div>
            </form>
        </div>
    </div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        let detalleCount = document.querySelectorAll('.detalle-item').length;

        // Agregar nueva línea de detalle
        document.getElementById('agregarDetalle').addEventListener('click', function() {
            const container = document.getElementById('detallesContainer');
            const newDetalle = document.querySelector('.detalle-item').cloneNode(true);
            
            // Actualizar índices
            newDetalle.querySelectorAll('input, select').forEach(input => {
                const name = input.getAttribute('name');
                if (name) {
                    input.setAttribute('name', name.replace('[0]', `[${detalleCount}]`));
                    if (input.type !== 'select-one' && input.type !== 'hidden') {
                        input.value = input.classList.contains('cantidad') ? 1 : '';
                    }
                }
            });
            
            container.appendChild(newDetalle);
            detalleCount++;
            calcularTotales();
        });

        // Calcular subtotales y total
        function calcularTotales() {
            let subtotalAcumulado = 0;
            
            document.querySelectorAll('.detalle-item').forEach(detalle => {
                const cantidadInput = detalle.querySelector('.cantidad');
                const precioInput = detalle.querySelector('.precio');
                const subtotalInput = detalle.querySelector('.subtotal');
                
                if (cantidadInput && precioInput && subtotalInput) {
                    const cantidad = parseFloat(cantidadInput.value) || 0;
                    // Limpiar el precio por si el navegador envía comas o si el usuario las tipea
                    let precioStr = precioInput.value.toString().replace(',', '.');
                    const precio = parseFloat(precioStr) || 0;
                    
                    const subtotalItem = cantidad * precio;
                    subtotalInput.value = subtotalItem.toFixed(2);
                    subtotalAcumulado += subtotalItem;
                }
            });
            
            const iva = subtotalAcumulado * 0.21;
            const total = subtotalAcumulado + iva;
            
            // Formateo para visualización (es-AR)
            const formatter = new Intl.NumberFormat('es-AR', {
                style: 'currency',
                currency: 'ARS',
                minimumFractionDigits: 2
            });
            
            document.getElementById('subtotalTotal').textContent = formatter.format(subtotalAcumulado);
            document.getElementById('ivaTotal').textContent = formatter.format(iva);
            document.getElementById('totalFinal').textContent = formatter.format(total);
        }

        // Event listeners para recalcular
        document.addEventListener('input', function(e) {
            if (e.target.classList.contains('cantidad') || e.target.classList.contains('precio')) {
                calcularTotales();
            }
        });

        // Ejecutar cálculo inicial inmediatamente
        document.addEventListener('DOMContentLoaded', calcularTotales);
        // Por las dudas si el DOM ya cargó
        setTimeout(calcularTotales, 100);
    </script>
}
