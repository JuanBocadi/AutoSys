@model AutoSys.Models.Vehiculo
@{
    ViewData["Title"] = "Detalles del Vehículo";
}

<div class="container-fluid py-4">
    <!-- Header with Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Vehículos</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Patente</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1">
                <i class="fas fa-car text-primary me-2"></i>@Model.Marca @Model.Modelo
            </h1>
            <p class="text-muted"><span class="badge bg-dark fs-6 me-2">@Model.Patente</span> Detalle completo y trazabilidad histórica.</p>
        </div>
        <div class="d-flex gap-2">
            @if (User.HasClaim("Permission", "EditarVehiculos") || User.IsInRole("Administrador"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="fas fa-edit me-2"></i>Editar
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-list me-2"></i>Volver al Listado
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Info Column -->
        <div class="col-lg-4">
            <!-- Current Owner Card -->
            <div class="card border-0 shadow-sm mb-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-3 border-0">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="fas fa-user-circle me-2"></i>Propietario Actual
                    </h5>
                </div>
                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <div class="d-inline-block rounded-circle bg-primary bg-opacity-10 p-4 mb-3">
                            <i class="fas fa-user-tie fa-3x text-primary"></i>
                        </div>
                        <h4 class="fw-bold mb-1">@Model.Cliente?.Nombre @Model.Cliente?.Apellido</h4>
                        <p class="text-muted mb-3">DNI: @Model.Cliente?.DNI</p>
                    </div>
                    
                    <div class="list-group list-group-flush text-start border rounded">
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="fas fa-phone me-2"></i>Teléfono</span>
                            <span class="fw-semibold">@(Model.Cliente?.Telefono ?? "N/A")</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="fas fa-envelope me-2"></i>Email</span>
                            <span class="fw-semibold">@(Model.Cliente?.Email ?? "N/A")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6 border-end">
                            <h3 class="fw-bold text-primary mb-0">@Model.Ingresos.Count</h3>
                            <small class="text-muted uppercase fw-bold" style="font-size: 0.7rem;">Reparaciones</small>
                        </div>
                        <div class="col-6">
                            <h3 class="fw-bold text-success mb-0">@Model.HistorialPropietarios.Count</h3>
                            <small class="text-muted uppercase fw-bold" style="font-size: 0.7rem;">Dueños</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        </div>
    </div>
</div>

<style>
    .bg-success-subtle { background-color: #d1e7dd; }
    .uppercase { text-transform: uppercase; letter-spacing: 0.05em; }
</style>
