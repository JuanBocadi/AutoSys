@model IEnumerable<AutoSys.Models.Vehiculo>
@{
    ViewData["Title"] = "Vehículos";
    var _u = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
    var _rol = User.IsInRole("Administrador") ? "Administrador" : User.IsInRole("Recepcionista") ? "Recepcionista" : "Mecanico";
    var _p = User.IsInRole("Administrador")
        ? PermissionService.GetDefaultsByRole("Administrador", _u)
        : await PermissionService.ObtenerPermisosEfectivosAsync(_u, _rol);
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-car" style="margin-right: 0.5rem; color: #10b981;"></i>
                Vehículos
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">Listado de todos los vehículos registrados</p>
        </div>
        <div style="display: flex; gap: 0.75rem;">
            <div style="position: relative;">
                <input type="text" 
                       placeholder="Buscar vehículo..." 
                       class="form-control" 
                       style="padding-left: 2.5rem; width: 300px;"
                       id="searchInput">
                <i class="fas fa-search" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--muted-foreground);"></i>
            </div>
            @if (_p.CrearVehiculos)
            {
                <a asp-action="Create" class="btn btn-success">
                    <i class="fas fa-plus"></i> Nuevo Vehículo
                </a>
            }
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #dcfce7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-car" style="color: #10b981;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Total Vehículos</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@Model.Count()</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #dbeafe; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-users" style="color: #3b82f6;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Clientes con Vehículos</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@Model.Select(v => v.ClienteId).Distinct().Count()</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 2.5rem; height: 2.5rem; background: #fef3c7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-industry" style="color: #f59e0b;"></i>
                </div>
                <div>
                    <p style="font-size: 0.75rem; color: var(--muted-foreground); margin: 0;">Marcas Diferentes</p>
                    <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@Model.Select(v => v.Marca).Distinct().Count()</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-body" style="padding: 0;">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table" id="vehiculosTable">
                    <thead>
                        <tr>
                            <th>Vehículo</th>
                            <th>Cliente</th>
                            <th>Contacto</th>
                            <th style="text-align: right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model)
                        {
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <div style="width: 2.5rem; height: 2.5rem; background: #10b981; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-car" style="color: white;"></i>
                                        </div>
                                        <div>
                                            <div style="font-weight: 700; font-size: 1.125rem; font-family: monospace;">@v.Patente</div>
                                            <div style="font-size: 0.875rem; color: var(--muted-foreground);">
                                                @v.Marca @v.Modelo
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        @if (v.Cliente != null)
                                        {
                                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                                <div style="width: 2rem; height: 2rem; background: #f4f4f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 0.75rem; color: #71717a;">
                                                    @v.Cliente.Nombre?.Substring(0, 1).ToUpper()@v.Cliente.Apellido?.Substring(0, 1).ToUpper()
                                                </div>
                                                <div>
                                                    <div style="font-weight: 600;">@v.Cliente.Nombre @v.Cliente.Apellido</div>
                                                    <div style="font-size: 0.75rem; color: var(--muted-foreground);">DNI: @v.Cliente.DNI</div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color: var(--muted-foreground);">Sin cliente asignado</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (v.Cliente != null)
                                    {
                                        <div>
                                            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                                                <i class="fas fa-phone" style="color: var(--muted-foreground); font-size: 0.875rem;"></i>
                                                <span style="font-size: 0.875rem;">@v.Cliente.Telefono</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(v.Cliente.Email))
                                            {
                                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                                    <i class="fas fa-envelope" style="color: var(--muted-foreground); font-size: 0.875rem;"></i>
                                                    <span style="font-size: 0.875rem;">@v.Cliente.Email</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="color: var(--muted-foreground); font-size: 0.875rem;">-</span>
                                    }
                                </td>
                                <td style="text-align: right;">
                                    <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                        @if (_p.VerIngresos)
                                        {
                                            <a asp-action="ReparacionesDelVehiculo" asp-route-id="@v.Id" 
                                               class="btn btn-sm btn-primary"
                                               title="Ver historial de reparaciones">
                                                <i class="fas fa-tools"></i> Reparaciones
                                            </a>
                                        }
                                        @if (_p.EditarVehiculos)
                                        {
                                            <a asp-action="Edit" asp-route-id="@v.Id"
                                               class="btn btn-sm btn-warning"
                                               title="Editar vehículo">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        }
                                        @if (User.IsInRole("Administrador") && !(v.Ingresos?.Any() ?? false))
                                        {
                                            <button type="button" class="btn btn-sm btn-danger btn-eliminar-vehiculo"
                                                    data-vehiculo-id="@v.Id"
                                                    data-vehiculo-patente="@v.Patente"
                                                    data-vehiculo-marca="@v.Marca"
                                                    data-vehiculo-modelo="@v.Modelo"
                                                    data-vehiculo-cliente="@(v.Cliente != null ? $"{v.Cliente.Nombre} {v.Cliente.Apellido}" : "Sin cliente")"
                                                    title="Eliminar vehículo">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        
        @if (Model == null || !Model.Any())
        {
            <div id="emptyStateContainer"></div>
        }
    </div>
</div>

<!-- Modal para eliminar vehículo -->
<div class="modal fade" id="eliminarVehiculoModal" tabindex="-1" aria-labelledby="eliminarVehiculoModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formEliminarVehiculo" asp-action="DeleteConfirmed" asp-controller="Vehiculos" method="post">
                <input type="hidden" id="deleteVehiculoId" name="Id" />
                <div class="modal-header" style="background: var(--accent-red, #dc2626); color: white;">
                    <h5 class="modal-title" id="eliminarVehiculoModalLabel">
                        <i class="fas fa-trash" style="margin-right: 0.5rem;"></i>
                        Eliminar Vehículo
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger">
                        <h6 class="alert-heading">
                            <i class="fas fa-exclamation-triangle me-2"></i>¿Está seguro que desea eliminar este vehículo?
                        </h6>
                        <p class="mb-0">Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Patente:</dt>
                                <dd class="col-sm-8"><strong id="deletePatente" style="font-family: monospace; font-size: 1.1rem;"></strong></dd>

                                <dt class="col-sm-4">Vehículo:</dt>
                                <dd class="col-sm-8"><span id="deleteMarcaModelo"></span></dd>

                                <dt class="col-sm-4">Cliente:</dt>
                                <dd class="col-sm-8"><span id="deleteCliente"></span></dd>
                            </dl>
                        </div>
                    </div>
                    <div id="deleteWarningIngresos" class="alert alert-warning mt-3" style="display: none;">
                        <i class="fas fa-info-circle me-2"></i>
                        Este vehículo tiene ingreso(s) asociado(s) y <strong>no puede ser eliminado</strong>.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-danger" id="btnConfirmarEliminar">
                        <i class="fas fa-trash"></i> Confirmar Eliminación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Búsqueda en tiempo real
        document.getElementById('searchInput').addEventListener('keyup', function() {
            const searchTerm = this.value.toLowerCase();
            const rows = document.querySelectorAll('#vehiculosTable tbody tr');
            
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchTerm) ? '' : 'none';
            });
        });

        // Modal eliminar vehículo
        document.querySelectorAll('.btn-eliminar-vehiculo').forEach(btn => {
            btn.addEventListener('click', function() {
                document.getElementById('deleteVehiculoId').value = this.dataset.vehiculoId;
                document.getElementById('deletePatente').textContent = this.dataset.vehiculoPatente;
                document.getElementById('deleteMarcaModelo').textContent = this.dataset.vehiculoMarca + ' ' + this.dataset.vehiculoModelo;
                document.getElementById('deleteCliente').textContent = this.dataset.vehiculoCliente;

                new bootstrap.Modal(document.getElementById('eliminarVehiculoModal')).show();
            });
        });

        // Mostrar empty state si no hay vehículos
        @if (Model == null || !Model.Any())
        {
            <text>
            const container = document.getElementById('emptyStateContainer');
            if (container) {
                const emptyState = AutoSysUI.createEmptyState({
                    icon: 'fas fa-car',
                    title: 'No hay vehículos registrados',
                    description: 'Agrega vehículos para gestionar sus ingresos y reparaciones en el taller',
                    actionText: 'Agregar Vehículo',
                    actionCallback: () => {
                        window.location.href = '@Url.Action("Create", "Vehiculos")';
                    }
                });
                container.appendChild(emptyState);
            }
            </text>
        }
    </script>
}