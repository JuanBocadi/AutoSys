@model IEnumerable<AutoSys.Models.Vehiculo>
@{
    ViewData["Title"] = "Vehículos";
}

<div class="mt-4">
    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-header bg-secondary text-white py-3">
            <h2 class="mb-0"><i class="fas fa-car me-2"></i>Listado de Vehículos</h2>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Patente</th>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Cliente</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model)
                        {
                            <tr>
                                <td><strong>@v.Patente</strong></td>
                                <td>@v.Marca</td>
                                <td>@v.Modelo</td>
                                <td>@(v.Cliente != null ? ($"{v.Cliente.Nombre} {v.Cliente.Apellido}") : "-")</td>
                                <td class="text-center">
                                    <a asp-action="ReparacionesDelVehiculo" asp-route-id="@v.Id" 
                                       class="btn btn-sm btn-primary"
                                       title="Ver reparaciones de @v.Patente">
                                        <i class="fas fa-tools me-1"></i>Ver Reparaciones
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>