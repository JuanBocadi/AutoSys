@model AutoSys.Models.Vehiculo
@{
    ViewData["Title"] = $"Reparaciones de {Model.Patente}";
    var _u = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
    var _rol = User.IsInRole("Administrador") ? "Administrador" : User.IsInRole("Recepcionista") ? "Recepcionista" : "Mecanico";
    var _p = User.IsInRole("Administrador")
        ? PermissionService.GetDefaultsByRole("Administrador", _u)
        : await PermissionService.ObtenerPermisosEfectivosAsync(_u, _rol);
}

<div class="mt-4">
    <!-- Breadcrumb para navegación jerárquica -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Clientes" asp-action="Index">
                    <i class="fas fa-users me-1"></i>Clientes
                </a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Clientes" asp-action="VehiculosDelCliente" asp-route-id="@Model.ClienteId">
                    <i class="fas fa-user me-1"></i>@Model.Cliente?.Nombre @Model.Cliente?.Apellido
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="fas fa-car me-1"></i>@Model.Patente
            </li>
        </ol>
    </nav>

    <!-- Información del vehículo -->
    <div class="card shadow-lg border-0 rounded-lg mb-4">
        <div class="card-header bg-info text-white py-3">
            <h2 class="mb-0">
                <i class="fas fa-car me-2"></i>@Model.Patente - @Model.Marca @Model.Modelo
            </h2>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <p><strong><i class="fas fa-user me-2"></i>Propietario:</strong> @Model.Cliente?.Nombre @Model.Cliente?.Apellido</p>
                </div>
                <div class="col-md-4">
                    <p><strong><i class="fas fa-phone me-2"></i>Teléfono:</strong> @Model.Cliente?.Telefono</p>
                </div>
                <div class="col-md-4">
                    <p><strong><i class="fas fa-envelope me-2"></i>Email:</strong> @(string.IsNullOrEmpty(Model.Cliente?.Email) ? "-" : Model.Cliente.Email)</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Estadísticas de reparaciones -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-info shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-info">@(Model.Ingresos?.Count ?? 0)</h3>
                    <p class="mb-0"><i class="fas fa-tools me-1"></i>Reparaciones Totales</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-warning">@(Model.Ingresos?.Count(i => !i.FechaEgreso.HasValue) ?? 0)</h3>
                    <p class="mb-0"><i class="fas fa-wrench me-1"></i>En Taller</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-success">@(Model.Ingresos?.Count(i => i.FechaEgreso.HasValue) ?? 0)</h3>
                    <p class="mb-0"><i class="fas fa-check-circle me-1"></i>Completadas</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-danger shadow-sm">
                <div class="card-body text-center">
                    <h3 class="text-danger">@(Model.Ingresos?.Count(i => i.ColorSemaforo == "danger" && !i.FechaEgreso.HasValue) ?? 0)</h3>
                    <p class="mb-0"><i class="fas fa-exclamation-triangle me-1"></i>Urgentes</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Leyenda de semaforización -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5><i class="fas fa-traffic-light me-2"></i>Leyenda de Semaforización por Estado</h5>
            <div class="d-flex gap-3 flex-wrap">
                <span class="badge bg-danger px-3 py-2">
                    <i class="fas fa-circle me-1"></i>Rojo: En Revisión (Recién ingresado, aún no comenzó)
                </span>
                <span class="badge bg-warning text-dark px-3 py-2">
                    <i class="fas fa-circle me-1"></i>Amarillo: En Proceso (Reparación en marcha)
                </span>
                <span class="badge bg-success px-3 py-2">
                    <i class="fas fa-circle me-1"></i>Verde: Finalizado/Entregado (Trabajo completado)
                </span>
            </div>
        </div>
    </div>

    <!-- Historial de reparaciones -->
    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-header bg-secondary text-white py-3">
            <h3 class="mb-0"><i class="fas fa-history me-2"></i>Historial de Reparaciones</h3>
        </div>
        <div class="card-body p-4">
            @if (Model.Ingresos != null && Model.Ingresos.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Fecha Ingreso</th>
                                <th>Diagnóstico</th>
                                <th>Estado</th>
                                <th class="text-center">Días en Taller</th>
                                <th class="text-center">Indicador</th>
                                <th>Fecha Egreso</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ingreso in Model.Ingresos.OrderByDescending(i => i.FechaIngreso))
                            {
                                <tr>
                                    <td>@ingreso.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (ingreso.Diagnostico.Length > 50)
                                        {
                                            <span title="@ingreso.Diagnostico">
                                                @ingreso.Diagnostico.Substring(0, 50)...
                                            </span>
                                        }
                                        else
                                        {
                                            @ingreso.Diagnostico
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-@ingreso.ColorSemaforo">
                                            @ingreso.EstadoDescripcion
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <strong>@ingreso.DiasEnTaller</strong> días
                                    </td>
                                    <td class="text-center">
                                        @if (!ingreso.FechaEgreso.HasValue)
                                        {
                                            <span class="semaforo-indicator semaforo-@ingreso.ColorSemaforo" 
                                                  title="@(ingreso.ColorSemaforo == "success" ? "En tiempo" : ingreso.ColorSemaforo == "warning" ? "Atención requerida" : "Urgente")">
                                                <i class="fas fa-circle"></i>
                                            </span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-check-circle text-success" title="Completado"></i>
                                        }
                                    </td>
                                    <td>
                                        @if (ingreso.FechaEgreso.HasValue)
                                        {
                                            @ingreso.FechaEgreso.Value.ToString("dd/MM/yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-muted">En taller</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (_p.VerIngresos)
                                        {
                                            <a asp-controller="Ingreso" asp-action="Detalle" asp-route-id="@ingreso.Id" 
                                               class="btn btn-sm btn-info"
                                               title="Ver detalle completo">
                                                <i class="fas fa-eye me-1"></i>Ver Detalle
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Este vehículo no tiene reparaciones registradas.
                </div>
            }
        </div>
    </div>

    <!-- Botones de navegación -->
    <div class="mt-3 d-flex gap-2">
        <a asp-controller="Clientes" asp-action="VehiculosDelCliente" asp-route-id="@Model.ClienteId" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver a Vehículos del Cliente
        </a>
        <a asp-controller="Vehiculos" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-car me-2"></i>Ir a Todos los Vehículos
        </a>
    </div>
</div>
