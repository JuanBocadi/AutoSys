@model AutoSys.Models.ServicioFijo
@{
    ViewData["Title"] = "Eliminar Servicio";
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-trash-alt" style="margin-right: 0.5rem; color: #ef4444;"></i>
                Eliminar Servicio
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">¿Estás seguro de que deseas eliminar este servicio del catálogo?</p>
        </div>
        <a asp-action="Index" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>
</div>

<!-- Confirmación -->
<div class="card" style="border-top: 4px solid #ef4444;">
    <div class="card-body">
        <div style="text-align: center; margin-bottom: 2rem;">
            <div style="width: 4rem; height: 4rem; background: #fee2e2; color: #ef4444; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 1.5rem;">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h3 style="font-weight: 700;">Confirmar Eliminación</h3>
            <p style="color: var(--muted-foreground);">Esta acción no se puede deshacer. Los ingresos que ya utilicen este servicio conservarán su referencia si es posible, o se marcarán como nulos.</p>
        </div>

        <div style="background: var(--bg-light); padding: 1.5rem; border-radius: var(--radius); margin-bottom: 2rem;">
            <div class="row g-3">
                <div class="col-sm-4" style="font-weight: 600; color: var(--muted-foreground);">Nombre:</div>
                <div class="col-sm-8">@Model.Nombre</div>

                <div class="col-sm-4" style="font-weight: 600; color: var(--muted-foreground);">Precio Sugerido:</div>
                <div class="col-sm-8">@(Model.PrecioSugerido?.ToString("C") ?? "No definido")</div>

                <div class="col-sm-4" style="font-weight: 600; color: var(--muted-foreground);">Descripción:</div>
                <div class="col-sm-8">@(string.IsNullOrEmpty(Model.DescripcionPredeterminada) ? "Sin descripción" : Model.DescripcionPredeterminada)</div>
            </div>
        </div>

        <form asp-action="Delete" method="post" id="deleteForm">
            <input type="hidden" asp-for="Id" />
            <div style="display: flex; gap: 1rem; justify-content: center;">
                <a asp-action="Index" class="btn btn-outline" style="min-width: 120px;">
                    <i class="fas fa-times me-2"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-danger" style="min-width: 120px;" id="confirmDeleteBtn">
                    <i class="fas fa-trash-alt me-2"></i>Eliminar ahora
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deleteForm').addEventListener('submit', function() {
            AutoSysUI.setButtonLoading(document.getElementById('confirmDeleteBtn'), true);
        });
    </script>
}
