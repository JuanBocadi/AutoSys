@model AutoSys.Models.ServicioFijo
@{
    ViewData["Title"] = "Editar Servicio Fijo";
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
            <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
                <i class="fas fa-edit" style="margin-right: 0.5rem; color: #f59e0b;"></i>
                Editar Servicio
            </h1>
            <p style="color: var(--muted-foreground); margin: 0;">Actualiza el nombre, precio o descripción del servicio</p>
        </div>
        <a asp-action="Index" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>
</div>

<!-- Formulario -->
<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post" id="formServicio">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            
            <div class="row g-3">
                <!-- Nombre -->
                <div class="col-md-8">
                    <label asp-for="Nombre" class="form-label">
                        <i class="fas fa-tag me-1"></i> Nombre del Servicio
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Cambio de Aceite y Filtro" required />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <!-- Precio Sugerido -->
                <div class="col-md-4">
                    <label asp-for="PrecioSugerido" class="form-label">
                        <i class="fas fa-dollar-sign me-1"></i> Precio Sugerido
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="PrecioSugerido" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="PrecioSugerido" class="text-danger"></span>
                </div>

                <!-- Descripción Predeterminada -->
                <div class="col-12">
                    <label asp-for="DescripcionPredeterminada" class="form-label">
                        <i class="fas fa-align-left me-1"></i> Descripción Predeterminada (Diagnóstico)
                    </label>
                    <textarea asp-for="DescripcionPredeterminada" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="DescripcionPredeterminada" class="text-danger"></span>
                    <div class="form-text">Texto que se concatenará al diagnóstico cuando se seleccione este servicio.</div>
                </div>
            </div>

            <!-- Botones -->
            <div style="margin-top: 2rem; display: flex; gap: 0.75rem; justify-content: flex-end;">
                <a asp-action="Index" class="btn btn-outline">
                    <i class="fas fa-times me-2"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <i class="fas fa-save me-2"></i>Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('formServicio').addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('submitBtn');
            if (this.checkValidity()) {
                AutoSysUI.setButtonLoading(submitBtn, true);
            }
        });
    </script>
}
