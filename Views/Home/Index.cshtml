@{
    ViewData["Title"] = "Dashboard";
    ViewData["Breadcrumb"] = "Dashboard Principal";
}

<!-- Header -->
<div style="margin-bottom: 2rem;">
    <h1 style="font-size: 1.875rem; font-weight: 700; margin-bottom: 0.5rem;">
        <i class="fas fa-tachometer-alt" style="color: var(--primary-blue);"></i> 
        Dashboard Ejecutivo
    </h1>
    <p style="color: var(--muted-foreground);">Resumen general del sistema de gestión</p>
</div>

<!-- Statistics Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <!-- Total Clientes -->
    <div class="card">
        <div class="card-body">
            <div style="display: flex; justify-content: space-between; align-items: start;">
                <div>
                    <p style="font-size: 0.875rem; color: var(--muted-foreground); margin-bottom: 0.5rem;">Total Clientes</p>
                    <h3 style="font-size: 2rem; font-weight: 700; margin: 0;">@ViewBag.TotalClientes</h3>
                </div>
                <div style="width: 3rem; height: 3rem; background: #dbeafe; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-users" style="color: #3b82f6; font-size: 1.5rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Vehículos -->
    <div class="card">
        <div class="card-body">
            <div style="display: flex; justify-content: space-between; align-items: start;">
                <div>
                    <p style="font-size: 0.875rem; color: var(--muted-foreground); margin-bottom: 0.5rem;">Total Vehículos</p>
                    <h3 style="font-size: 2rem; font-weight: 700; margin: 0;">@ViewBag.TotalVehiculos</h3>
                </div>
                <div style="width: 3rem; height: 3rem; background: #dcfce7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-car" style="color: #10b981; font-size: 1.5rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Ingresos Activos -->
    <div class="card">
        <div class="card-body">
            <div style="display: flex; justify-content: space-between; align-items: start;">
                <div>
                    <p style="font-size: 0.875rem; color: var(--muted-foreground); margin-bottom: 0.5rem;">En Taller</p>
                    <h3 style="font-size: 2rem; font-weight: 700; margin: 0;">@ViewBag.IngresosActivos</h3>
                </div>
                <div style="width: 3rem; height: 3rem; background: #fef3c7; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-wrench" style="color: #f59e0b; font-size: 1.5rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Stock Crítico -->
    <div class="card">
        <div class="card-body">
            <div style="display: flex; justify-content: space-between; align-items: start;">
                <div>
                    <p style="font-size: 0.875rem; color: var(--muted-foreground); margin-bottom: 0.5rem;">Stock Crítico</p>
                    <h3 style="font-size: 2rem; font-weight: 700; margin: 0;">@ViewBag.StockCritico</h3>
                </div>
                <div style="width: 3rem; height: 3rem; background: #fee2e2; border-radius: var(--radius); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-exclamation-triangle" style="color: #ef4444; font-size: 1.5rem;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Status Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div class="card">
        <div class="card-body" style="text-align: center;">
            <i class="fas fa-search" style="color: #ef4444; font-size: 1.5rem; margin-bottom: 0.5rem;"></i>
            <p style="font-size: 0.875rem; color: var(--muted-foreground); margin-bottom: 0.25rem;">En Revisión</p>
            <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@ViewBag.EnRevision</h4>
        </div>
    </div>

    <div class="card">
        <div class="card-body" style="text-align: center;">
            <i class="fas fa-cogs" style="color: #f59e0b; font-size: 1.5rem; margin-bottom: 0.5rem;"></i>
            <p style="font-size: 0.875rem; color: var(--muted-foreground); margin-bottom: 0.25rem;">En Proceso</p>
            <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@ViewBag.EnProceso</h4>
        </div>
    </div>

    <div class="card">
        <div class="card-body" style="text-align: center;">
            <i class="fas fa-tools" style="color: #f59e0b; font-size: 1.5rem; margin-bottom: 0.5rem;"></i>
            <p style="font-size: 0.875rem; color: var(--muted-foreground); margin-bottom: 0.25rem;">En Reparación</p>
            <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@ViewBag.EnReparacion</h4>
        </div>
    </div>

    <div class="card">
        <div class="card-body" style="text-align: center;">
            <i class="fas fa-check-circle" style="color: #10b981; font-size: 1.5rem; margin-bottom: 0.5rem;"></i>
            <p style="font-size: 0.875rem; color: var(--muted-foreground); margin-bottom: 0.25rem;">Finalizados</p>
            <h4 style="font-size: 1.5rem; font-weight: 700; margin: 0;">@ViewBag.Finalizados</h4>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="card">
    <div class="card-header">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0;">Ingresos Recientes</h2>
                <p style="font-size: 0.875rem; color: var(--muted-foreground); margin: 0;">Últimos 5 vehículos ingresados</p>
            </div>
            <a asp-controller="Ingreso" asp-action="Index" class="btn btn-secondary btn-sm">
                Ver todos <i class="fas fa-arrow-right" style="margin-left: 0.5rem;"></i>
            </a>
        </div>
    </div>
    <div class="card-body" style="padding: 0;">
        @if (ViewBag.IngresosRecientes != null && ViewBag.IngresosRecientes.Count > 0)
        {
            <div style="overflow-x: auto;">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Vehículo</th>
                            <th>Cliente</th>
                            <th>Fecha Ingreso</th>
                            <th>Diagnóstico</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ingreso in ViewBag.IngresosRecientes)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight: 600;">@ingreso.Vehiculo?.Patente</div>
                                    <div style="font-size: 0.875rem; color: var(--muted-foreground);">
                                        @ingreso.Vehiculo?.Marca @ingreso.Vehiculo?.Modelo
                                    </div>
                                </td>
                                <td>
                                    <div>@ingreso.Vehiculo?.Cliente?.Nombre @ingreso.Vehiculo?.Cliente?.Apellido</div>
                                </td>
                                <td>
                                    <div style="font-size: 0.875rem;">@ingreso.FechaIngreso.ToString("dd/MM/yyyy")</div>
                                    <div style="font-size: 0.75rem; color: var(--muted-foreground);">@ingreso.FechaIngreso.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.875rem;">
                                        @ingreso.Diagnostico
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var badgeColor = "#1e40af";
                                        if (ingreso.Estado == "Finalizado") badgeColor = "#15803d";
                                        else if (ingreso.Estado == "En revisión") badgeColor = "#b91c1c";
                                        else if (ingreso.Estado == "En proceso" || ingreso.Estado == "En reparación") badgeColor = "#b45309";
                                        else if (ingreso.Estado == "Entregado") badgeColor = "#15803d";
                                    }
                                    <span style="color: @badgeColor; font-weight: 700; display: inline-flex; align-items: center; font-size: 0.875rem;">@ingreso.Estado</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding: 3rem; text-align: center; color: var(--muted-foreground);">
                <i class="fas fa-inbox" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.3;"></i>
                <p>No hay ingresos registrados</p>
            </div>
        }
    </div>
</div>

<!-- Gráficos Interactivos -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1.5rem; margin-top: 2rem;">
    <!-- Gráfico de Facturación Mensual -->
    <div class="card">
        <div class="card-header">
            <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-chart-line" style="color: var(--primary-blue);"></i>
                Facturación Mensual
            </h2>
            <p style="font-size: 0.875rem; color: var(--muted-foreground); margin: 0;">Últimos 6 meses</p>
        </div>
        <div class="card-body">
            <canvas id="facturacionChart" style="max-height: 300px;"></canvas>
        </div>
    </div>

    <!-- Gráfico de Estado de Reparaciones -->
    <div class="card">
        <div class="card-header">
            <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-chart-pie" style="color: var(--accent-green);"></i>
                Estado de Reparaciones
            </h2>
            <p style="font-size: 0.875rem; color: var(--muted-foreground); margin: 0;">Distribución actual</p>
        </div>
        <div class="card-body" style="display: flex; justify-content: center; align-items: center;">
            <canvas id="reparacionesChart" style="max-height: 300px; max-width: 300px;"></canvas>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Configuración de colores que respeta el tema
        const getThemeColors = () => {
            const isDarkMode = document.documentElement.getAttribute('data-theme') === 'dark';
            return {
                primary: isDarkMode ? '#3b82f6' : '#2563eb',
                success: isDarkMode ? '#22c55e' : '#16a34a',
                warning: isDarkMode ? '#fdba74' : '#ea580c',
                danger: isDarkMode ? '#fca5a5' : '#dc2626',
                text: isDarkMode ? '#f9fafb' : '#111827',
                border: isDarkMode ? '#374151' : '#e5e7eb',
                gridColor: isDarkMode ? '#374151' : '#e5e7eb'
            };
        };

        let colors = getThemeColors();
        
        // Gráfico de Facturación Mensual
        const ctxFacturacion = document.getElementById('facturacionChart');
        if (ctxFacturacion) {
            const facturacionChart = new Chart(ctxFacturacion, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MesesLabels ?? new List<string>())),
                    datasets: [{
                        label: 'Facturación ($)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.FacturacionData ?? new List<decimal>())),
                        backgroundColor: 'rgba(37, 99, 235, 0.6)',
                        borderColor: colors.primary,
                        borderWidth: 2,
                        borderRadius: 6,
                        hoverBackgroundColor: 'rgba(37, 99, 235, 0.8)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: colors.text === '#f9fafb' ? '#1f2937' : '#ffffff',
                            titleColor: colors.text,
                            bodyColor: colors.text,
                            borderColor: colors.border,
                            borderWidth: 1,
                            callbacks: {
                                label: function(context) {
                                    return ' $' + context.parsed.y.toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: colors.gridColor
                            },
                            ticks: {
                                color: colors.text,
                                callback: function(value) {
                                    return '$' + value.toLocaleString('es-AR');
                                }
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                color: colors.text
                            }
                        }
                    }
                }
            });

            // Actualizar colores del gráfico al cambiar tema
            document.addEventListener('themeChanged', () => {
                colors = getThemeColors();
                facturacionChart.options.scales.y.grid.color = colors.gridColor;
                facturacionChart.options.scales.y.ticks.color = colors.text;
                facturacionChart.options.scales.x.ticks.color = colors.text;
                facturacionChart.data.datasets[0].borderColor = colors.primary;
                facturacionChart.update();
            });
        }

        // Gráfico de Estado de Reparaciones
        const ctxReparaciones = document.getElementById('reparacionesChart');
        if (ctxReparaciones) {
            const reparacionesChart = new Chart(ctxReparaciones, {
                type: 'doughnut',
                data: {
                    labels: ['Finalizadas', 'En Proceso', 'En Revisión'],
                    datasets: [{
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ReparacionesData ?? new List<int> {0, 0, 0})),
                        backgroundColor: [
                            'rgba(22, 163, 74, 0.8)',
                            'rgba(234, 88, 12, 0.8)',
                            'rgba(220, 38, 38, 0.8)'
                        ],
                        borderColor: [
                            colors.success,
                            colors.warning,
                            colors.danger
                        ],
                        borderWidth: 2,
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: colors.text,
                                padding: 15,
                                font: {
                                    size: 12
                                }
                            }
                        },
                        tooltip: {
                            backgroundColor: colors.text === '#f9fafb' ? '#1f2937' : '#ffffff',
                            titleColor: colors.text,
                            bodyColor: colors.text,
                            borderColor: colors.border,
                            borderWidth: 1,
                            callbacks: {
                                label: function(context) {
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : 0;
                                    return ' ' + context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                                }
                            }
                        }
                    }
                }
            });

            // Actualizar colores del gráfico al cambiar tema
            document.addEventListener('themeChanged', () => {
                colors = getThemeColors();
                reparacionesChart.options.plugins.legend.labels.color = colors.text;
                reparacionesChart.data.datasets[0].borderColor = [colors.success, colors.warning, colors.danger];
                reparacionesChart.update();
            });
        }
    });
</script>
}
```
